def origin_argument(text):
    """argparse's check of `tc send --origin`: `text` when it matches ORIGIN_PATTERN with a C0 sender, else a usage error (exit 9).

    @interacts  none; string work only.
    @deps       valid_name; argparse; ORIGIN_PATTERN.
    @complexity O(c) over c characters of `text`.
    @alloc      none.
    """
    found = ORIGIN_PATTERN.fullmatch(text)
    if found is None or not valid_name(found.group("sender")):
        raise argparse.ArgumentTypeError(f'bad origin id "{printable(text)}": <32 hex digits>-<number>-'
                                         f'<32 hex digits>-<sender>')
    return text


def print_delivery(result):
    """Print a Delivery as tc send does (C2), then exit with its code when it is not 0.

    Words to stdout on exit 0, else to stderr; every warning to stderr.

    @interacts  writes to stdout and stderr; exits on a non-zero code.
    @deps       sys.
    @complexity O(w) over w characters printed.
    @alloc      none.
    """
    print(result.words, file=sys.stdout if result.exit == 0 else sys.stderr)
    for warning in result.warnings:
        print(warning, file=sys.stderr)
    if result.exit != 0:
        sys.exit(result.exit)


def cmd_send(args):
