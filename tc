    @deps       os; NEW_FILE_FLAGS, NEW_FILE_MODE.
    @complexity O(t) over t characters of `text`.
    @alloc      the encoded text while written; one descriptor, closed on
                return.
    """
    with open(os.open(path, NEW_FILE_FLAGS, mode), "w") as f:
        f.write(text)


def cmd_send(args):
    """`tc send`: check, then hand the message to the route on the recipient's card (C2).

    No card means route local: today's send, with today's stdout line. A
    local delivery reads the card again under the inbox lock (shared) and
    lands under it, so a `tc card` for this name either counts this message
    or is read here first. The codex route takes the lock itself.
    The route's Delivery decides the rest: words to stdout on exit 0, else
    to stderr; every warning to stderr; then its exit code.

    @interacts  checks both names first (C0, exit 6, nothing written); reads
                the body (stdin when no text is given) and refuses one over
                SEND_BODY_MAX_BYTES (exit 8) or empty (exit 1) before any
                number is taken; reads cards/<to>.json and refuses (exit 1,
                nothing written) a card it cannot route; for a local
                delivery holds mail/.box-<to>.lock shared and reads the card
                again; calls one ROUTES function, which writes the message;
                prints. SHARED fix round 3 (Claude Opus 5.5, unreviewed): a
                local delivery takes one lock_deadline before the inbox
                lock and hands it to deliver_local, so the inbox lock and
                every mail/.seq wait together take at most
                LOCK_WAIT_SECONDS; a lock held past it refuses, exit 10,
                nothing written (inbox_lock, next_seq, D20, D23). SHARED
                fix round 4 (Claude Opus 5.5, unreviewed): the audit's
                LOW-3. Every send takes that one deadline before it
                routes and hands it to deliver_local or deliver_codex,
                also when the card read under the lock turned codex, so
                no path waits two bounds; any other route gets C2's
                arguments alone.
    @deps       require_names, read_body, refuse, card_route, inbox_lock,
                lock_deadline, deliver_local, deliver_codex, Delivery;
                fcntl.
    @complexity O(b) over b bytes of body, at most SEND_BODY_MAX_BYTES,
                plus the route's own work.
    @alloc      the body string, freed on exit; whatever the route keeps.
    """
    require_names(args.sender, args.to)  # CARDS R1 (Claude Opus 5.5, unreviewed)
    # CARDS R3 (Claude Opus 5.5, unreviewed): size, then the card, then the route.
    body = read_body(args.message)
    if not body.strip():
        refuse("tc send: empty message", EXIT_REFUSED)  # CARDS fix round 1 (Claude Opus 5.5, unreviewed)
    card, deliver = card_route(args.to)
    deadline = lock_deadline()  # SHARED fix round 3 (Claude Opus 5.5, unreviewed): LOW-2, one per command
    if deliver is deliver_local:
        # CARDS fix round 1 (Claude Opus 5.5, unreviewed): the card read again under the shared lock.
        with inbox_lock(args.to, fcntl.LOCK_SH, deadline):
            card, deliver = card_route(args.to)
            if deliver is deliver_local:
                result = deliver_local(card, args.sender, args.to, body, deadline=deadline)
    if deliver is deliver_codex:  # SHARED fix round 4 (Claude Opus 5.5, unreviewed): LOW-3, also after a turn to codex
        result = deliver_codex(card, args.sender, args.to, body, deadline=deadline)
    elif deliver is not deliver_local:
        result = deliver(card, args.sender, args.to, body)
    print(result.words, file=sys.stdout if result.exit == 0 else sys.stderr)
    for warning in result.warnings:
        print(warning, file=sys.stderr)
    if result.exit != 0:
        sys.exit(result.exit)


