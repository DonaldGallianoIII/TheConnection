def account_label(given):
    """A `tc join` card's account: `given`, else CLAUDE_CONFIG_DIR's base name, else UNKNOWN_ACCOUNT.

    A blank value counts as not given at each step, so the word is never
    empty (C1). `tc card` uses far_account instead (D13).

    @interacts  reads CLAUDE_CONFIG_DIR from the environment when `given`
                is blank, and nothing else.
    @deps       os, pathlib.
    @complexity O(c) over the characters of the value used.
    @alloc      the label string, returned.
    """
    if given is not None and given.strip():
        return given
    config = os.environ.get("CLAUDE_CONFIG_DIR")
    if config and pathlib.Path(config).name.strip():
        return pathlib.Path(config).name
    return UNKNOWN_ACCOUNT


# CARDS fix round 1 (Claude Opus 5.5, unreviewed): D13 (CARDS-4 item 3).
def far_account(given):
    """A `tc card` card's account: `given`, else UNKNOWN_ACCOUNT. Never the environment.

    This session's account says nothing about a name on another machine,
    so CLAUDE_CONFIG_DIR is not read (C1, D13). A blank value counts as not
    given, so the word is never empty.

    @interacts  none; string work only.
    @deps       UNKNOWN_ACCOUNT.
    @complexity O(c) over the characters of `given`.
    @alloc      none; returns `given` or the constant.
    """
    return given if given is not None and given.strip() else UNKNOWN_ACCOUNT


def write_card(card):
    """Write cards/<name>.json whole: a new .tmp sibling, then a rename over the old card.

    The .tmp name carries this process's pid, so two joins of one name at
    once never write into the same file. It is made by write_new_file, so
    a file or link already at that name is refused (exit 1, no card
    written), never written through. SHARED fix round 1 (Claude Opus 5.5,
    unreviewed): under a shared mailbox it is made SHARED_OWNED_FILE_MODE
    (0640, D20 item 2), so no member rewrites another's card in place.

    SHARED fix round 1 (Claude Opus 5.5, unreviewed): the audit's LOW-5.
    A rename tc may not make (under the sticky cards/, a card another user
    owns) is refused with words naming the owner, never a traceback, and
    the .tmp this call made is removed first, tc's own runtime cleanup,
    so none is left behind.

    @interacts  reads ROOT/.shared and makes cards/ (make_folder); creates
                cards/<name>.json.<pid>.tmp and renames it to
                cards/<name>.json, replacing any card there; on a .tmp it
                cannot make, or a rename it may not make (then removing
                its .tmp and lstatting the card for its owner), one line to
                stderr and exit 1.
    @deps       make_folder, write_new_file, refuse, user_name; json, os,
                errno, pathlib; SHARED_OWNED_FILE_MODE, NEW_FILE_MODE.
    @complexity O(1): eleven fields.
    @alloc      one JSON string, freed on return; one card file, kept.
    """
    share = make_folder(CARDS)  # SHARED H1 (Claude Opus 5.5, unreviewed): D16
    path = CARDS / f"{card['name']}.json"
    tmp = CARDS / f"{card['name']}.json.{os.getpid()}.tmp"
    mode = SHARED_OWNED_FILE_MODE if share is not None else NEW_FILE_MODE  # SHARED fix round 1 (Claude Opus 5.5, unreviewed): D20
    try:
        write_new_file(tmp, json.dumps(card, indent=2) + "\n", mode)
    except OSError as err:
        refuse(f"tc: could not create {tmp} ({err.strerror}); no card written", EXIT_REFUSED)
    try:
        tmp.rename(path)  # atomic, so a reader never sees half a card
    except OSError as err:  # SHARED fix round 1 (Claude Opus 5.5, unreviewed): LOW-5
        tmp.unlink(missing_ok=True)  # this call's own .tmp, made just above
        if err.errno not in (errno.EPERM, errno.EACCES):
            refuse(f"tc: could not replace {path} ({err.strerror}); no card written", EXIT_REFUSED)
        try:
            owner = user_name(os.lstat(path).st_uid)
        except OSError:
            owner = "another user"
        refuse(f"tc: could not replace {path} ({err.strerror}): it belongs to {owner}, and under a "
               f"shared mailbox only its owner can replace it. No card written.", EXIT_REFUSED)
    return path


# Phase fix round 1 (Claude Opus 5.5, unreviewed): what tc cards and tc
# health print from a card or a file name is escaped.
def printable(value):
    """`value` as text, each character str.isprintable() refuses written as its escape.

    Anyone who can write cards/ shapes a card, and a file name holds any
    byte but / and NUL. So ESC (0x1b) prints as the four characters
    \\x1b, never raw, and no card or file name can clear the screen,
    retitle the window or redraw a line where tc cards or tc health runs.
    `tc health --json` needs none of this: json.dumps escapes them.

    @interacts  none; string work only.
    @deps       the unicode_escape codec.
    @complexity O(c) over c characters of the text.
    @alloc      one string, returned.
    """
    text = str(value)
    if text.isprintable():
        return text
    return "".join(c if c.isprintable() else c.encode("unicode_escape").decode("ascii") for c in text)


def describe_card(card, file_name=None):
    """One card in words: `<name> (<kind>, account <a>, route <r>)`, plus `, reports to <N>`.

    Given `file_name`, the name is the file's (cards/<name>.json), as the
    router and tc health name it, and a card whose `name` field says
    otherwise ends `, card says name <x>`, so a copied card shows both.
    Without it (join and card describe the card they just wrote) the name
    is the `name` field. An ssh card's route reads `route ssh to
    <target>`. A field missing from a hand-made card shows as `?`. Every
    field goes through printable(), so no control character in a card
    reaches the terminal raw.

    @interacts  none; string work only.
    @deps       printable; pathlib.
    @complexity O(f) over f characters in the card's fields (a few
                hundred).
    @alloc      one string, returned.
    """
    route = card.get("route", "?")
    if route == "ssh" and isinstance(card.get("ssh"), dict):
        route = f"ssh to {card['ssh'].get('target', '?')}"
    name = pathlib.Path(file_name).stem if file_name is not None else card.get("name", "?")
    text = (f"{printable(name)} ({printable(card.get('kind', '?'))}, "
            f"account {printable(card.get('account', '?'))}, route {printable(route)})")
    if card.get("reports_to"):
        text += f", reports to {printable(card['reports_to'])}"
    if file_name is not None and "name" in card and card["name"] != name:
        text += f", card says name {printable(card['name'])}"
    return text


# Phase fix round 1 (Claude Opus 5.5, unreviewed): every card file, and the
# ring marker, is read here.
def read_regular_file(path, limit):
    """The text of the file at `path`, read only when it is a regular file of at most `limit` bytes.

    Opened with O_NONBLOCK and O_NOFOLLOW and checked with fstat before
    any read, so a FIFO at a card's name (or the ring marker's) never
    blocks tc health, tc cards, the board's feed or a send, and a symlink
    never points tc at a file outside the mailbox. Raises
    FileNotFoundError when nothing is at the name; ValueError, with words,
    for a symlink, anything that is not a regular file, a file over
    `limit`, or bytes that are not UTF-8; OSError for any other failure to
    open or read. A card's callers treat each but the first as an
    unreadable card.

    @interacts  opens, fstats and reads one file, and closes it.
    @deps       os, stat, errno.
    @complexity O(r) over r bytes read, at most `limit` + 1.
    @alloc      the bytes read and the decoded text, which is returned;
                one descriptor, closed on return.
    """
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
    except OSError as err:
        if err.errno == errno.ELOOP:
            raise ValueError("it is a symlink, which tc never follows") from err
        raise
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise ValueError("it is not a regular file")
        chunks, left = [], limit + 1
        while left > 0:
            chunk = os.read(fd, left)
            if not chunk:
                break
            chunks.append(chunk)
            left -= len(chunk)
    finally:
        os.close(fd)
    data = b"".join(chunks)
    if len(data) > limit:
        raise ValueError(f"it is over {limit} bytes")
    return data.decode("utf-8")


def all_cards():
    """Every card under cards/, by name: a list of (file name, card or None).

    None stands for a file that is not a JSON object (hand-edited or cut
    short, or nested too deep for the parser, which raises RecursionError)
    or that read_regular_file will not read (a FIFO, a symlink, anything
    but a regular file, or one over CARD_READ_MAX_BYTES); the caller says
    so instead of guessing.

    @interacts  globs cards/*.json and reads each through
                read_regular_file. Writes nothing.
    @deps       read_regular_file, CARD_READ_MAX_BYTES; json, pathlib.
    @complexity O(c) over c cards (a few dozen).
    @alloc      one list of c dicts, returned.
    """
    out = []
    for path in sorted(CARDS.glob("*.json")) if CARDS.exists() else []:
        try:
            card = json.loads(read_regular_file(path, CARD_READ_MAX_BYTES))
        except (OSError, ValueError, RecursionError):  # Phase fix round 1 (Claude Opus 5.5, unreviewed)
            card = None
        out.append((path.name, card if isinstance(card, dict) else None))
    return out


def cmd_join(args):
    """`tc join <name>`: write the card for the session this runs in (C1).

    Reads exactly five environment variables: CODEX_THREAD_ID, CLAUDECODE,
    CLAUDE_CODE_SESSION_ID, CLAUDE_PID and CLAUDE_CONFIG_DIR. Nothing else,
    so the native path's socket and token never reach a card.

    A codex card is written under the inbox lock (D16). Mail that landed
    before this join was never rung for this thread: it came while the
    name had no card, or was rung to a thread that has since gone. So with
    unread mail waiting, the join writes the ring marker, and the next
    send rings this thread whatever the count; it also prints `<n> unread
    waiting for <name>: run tc read <name>` so this session can read now.
    With none waiting it rewrites any marker as RING_CLEAR (D20 item 5:
    never removed), since nothing is owed, so an old thread's backoff
    never holds back this thread's first ring. A symlink, a FIFO or
    anything else that is not a regular file at the marker's name refuses
    the join (exit 1, no card written, D17, D19).

    SHARED fix round 1 (Claude Opus 5.5, unreviewed): under a shared
    mailbox the join first makes the name's inbox and its read/ as the
    joining user (claim_inbox, D20 item 1), or refuses with words a name
    whose card or inbox another user owns, before anything is written.

    @interacts  checks both names (C0, exit 6) and a self-report (exit 6);
                refuses a CODEX_THREAD_ID that is not a thread id (exit 1,
                D14) and --kind codex with no CODEX_THREAD_ID (exit 1);
                reads ROOT/.shared (mailbox_share) and, when shared, makes
                the inbox (claim_inbox); then writes cards/<name>.json
                through write_card, replacing any card there and resetting
                joined_at. For a codex card, holds mail/.box-<name>.lock
                alone (making mail/; held past LOCK_WAIT_SECONDS by another
                process, exit 10, no card written: inbox_lock, D20, D23) while it
                lstats
                mail/.ring-pending-<name> (not a regular file: exit 1),
                writes the card, counts mail/to-<name>/*.md and writes or
                clears the marker in place. Prints one line, plus the
                waiting line; a marker it cannot write or clear is said on
                stderr.
    @deps       require_names, refuse_self_report, refuse, account_label,
                mailbox_share, claim_inbox, write_card, describe_card,
                now_iso, THREAD_ID_PATTERN, inbox_lock, ring_marker_problem,
                unread_count, write_ring_marker, RING_JOINED, RING_CLEAR;
                os, sys.
    @complexity O(1), plus O(t) over t characters of CODEX_THREAD_ID; a
                codex card adds O(u) over u unread messages (single digits).
    @alloc      one card dict, freed on exit; one card file, kept; under a
                shared mailbox the inbox and its read/ when missing, kept;
                for a codex card one open lock file, and the marker file,
                kept (never removed, D20).
    """
    require_names(args.name, args.reports_to)
    refuse_self_report(args.name, args.reports_to)
    thread = os.environ.get("CODEX_THREAD_ID") or None
    # CARDS fix round 1 (Claude Opus 5.5, unreviewed): D14, so a join never
    # writes a thread_id the codex route would refuse to ring.
    if thread is not None and not THREAD_ID_PATTERN.fullmatch(thread):
        refuse(f'tc join: CODEX_THREAD_ID "{thread}" is not a thread id (letters, digits, '
               f'dot, dash, underscore, a letter or digit first), so the codex route could '
               f'never ring it. No card written.', EXIT_REFUSED)
    if args.kind:
        kind = args.kind
    elif thread:
        kind = "codex"
    elif os.environ.get("CLAUDECODE") == "1":
        kind = "claude"
    else:
        kind = "other"
    if kind == "codex" and not thread:
        refuse("tc join: kind codex needs CODEX_THREAD_ID, the thread the codex route "
               "rings, and it is not set. Run tc join inside the Codex session.", EXIT_REFUSED)
    pid = os.environ.get("CLAUDE_PID")
    card = {
        "version": CARD_VERSION,
        "name": args.name,
        "kind": kind,
        "account": account_label(args.account),
        "route": "codex" if kind == "codex" else "local",
        "session_id": os.environ.get("CLAUDE_CODE_SESSION_ID") or None,
        "pid": int(pid) if pid and pid.isascii() and pid.isdigit() else None,
        "thread_id": thread,
        "ssh": None,
        "reports_to": args.reports_to,
        "joined_at": now_iso(),
    }
    if mailbox_share() is not None:  # SHARED fix round 1 (Claude Opus 5.5, unreviewed): D20 item 1
        claim_inbox(args.name)
    if card["route"] != "codex":
        write_card(card)
        print(f"joined as {describe_card(card)}")
        return
    # Phase fix round 1 (Claude Opus 5.5, unreviewed): D16. Mail waiting at
    # a codex join leaves the ring marker, so the next send rings this thread.
    marker = MAIL / f".ring-pending-{args.name}"
    with inbox_lock(args.name):
        bad = ring_marker_problem(marker)  # SHARED D17 (Claude Opus 5.5, unreviewed): a planted link; D19 a FIFO
        if bad is not None:
            refuse(f"tc join: {marker} {bad}; no card written", EXIT_REFUSED)
        write_card(card)
        waiting = unread_count(args.name)
        if waiting:
            problem = write_ring_marker(args.name, RING_JOINED, f"tc join found {waiting} unread")
        elif os.path.lexists(marker):  # SHARED fix round 1 (Claude Opus 5.5, unreviewed): D20, cleared, never removed
            problem = write_ring_marker(args.name, RING_CLEAR, "tc join found nothing unread")
        else:
            problem = None
    print(f"joined as {describe_card(card)}")
    if waiting:
        print(f"{waiting} unread waiting for {args.name}: run tc read {args.name}")
    if problem is not None:
        print(f"tc join: {marker} could not be {'written' if waiting else 'cleared'} "
              f"({problem}), so the next send to {args.name} may not ring it",
              file=sys.stderr)


def cmd_card(args):
    """`tc card <name> --ssh user@host`: write a card for a name on another machine (C1).

    @interacts  checks both names and a self-report (exit 6), the ssh
                target and the remote tc path (exit 6); then, holding
                mail/.box-<name>.lock alone from count to write, so no
                send lands between them (held past LOCK_WAIT_SECONDS by
                another process, exit 10, no card written: inbox_lock,
                D20, D23), counts unread mail in
                mail/to-<name>/ without creating it, refuses (exit 1) when
                there is any unless --force, and writes cards/<name>.json
                through write_card; prints the card line, then on stderr a
                note when the card's route is not in ROUTES yet. Reads no
                environment variable: the account is --account, else
                `unknown` (D13).
    @deps       require_names, refuse_self_report, refuse, inbox_lock,
                unread_count, far_account, write_card, describe_card,
                now_iso, ROUTES.
    @complexity O(u) over u unread messages for the name (single digits).
    @alloc      one card dict, freed on exit; one card file, kept; one open
                lock file.
    """
    require_names(args.name, args.reports_to)
    refuse_self_report(args.name, args.reports_to)
    if not SSH_TARGET_PATTERN.fullmatch(args.ssh):
        refuse(f'tc card: bad ssh target "{args.ssh}": user@host or host, '
               f'no leading dash on either part, no spaces', EXIT_BAD_NAME)
    remote = args.remote_tc
    if not remote.startswith(REMOTE_TC_PREFIXES) or any(c.isspace() for c in remote):
        refuse(f'tc card: bad remote tc path "{remote}": it starts with / or ~/ '
               f'and has no spaces', EXIT_BAD_NAME)
    card = {
        "version": CARD_VERSION,
        "name": args.name,
        "kind": "other",
        "account": far_account(args.account),  # CARDS fix round 1 (Claude Opus 5.5, unreviewed): D13
        "route": "ssh",
        "session_id": None,
        "pid": None,
        "thread_id": None,
        "ssh": {"target": args.ssh, "tc": remote},
        "reports_to": args.reports_to,
        "joined_at": now_iso(),
    }
    # CARDS fix round 1 (Claude Opus 5.5, unreviewed): count and write under
    # the inbox lock, so no send lands here between the two.
    with inbox_lock(args.name):
        waiting = unread_count(args.name)
        if waiting and not args.force:
            refuse(f"tc card: {args.name} has {waiting} unread here. Once its card says ssh, "
                   f"sends go to the other machine and that mail is never read. Read it first "
                   f"(tc read {args.name}), or pass --force.", EXIT_REFUSED)
        write_card(card)
    print(f"card written: {describe_card(card)}")
    # CARDS fix round 1 (Claude Opus 5.5, unreviewed): say that sends are
    # refused for now. Silent once the route's lane adds its line to ROUTES.
    if card["route"] not in ROUTES:
        print(f"note: sends to {args.name} are refused until the {card['route']} route is built",
              file=sys.stderr)


