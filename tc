#!/usr/bin/env python3
"""
tc: file mailbox between Claude Code sessions on one machine.

One session (the one you talk to) relays for others you can't reach directly.
All run as the same Linux user, so a shared directory is the whole transport.
One message is one markdown file, so a human can read the mailbox with cat.

Layout under ROOT (default: this script's directory, override with TC_ROOT):
  mail/to-<name>/NNNNNN-from-<sender>.md   unread
  mail/to-<name>/read/...                  read (moved there by `tc read`)
  status/<name>.md                         latest self-reported status
  mail/.seq                                message counter (flock guarded)
  mail/.watch-<name>.lock                  held by `tc watch <name>` while it runs
  cards/<name>.json                        one address card per name (C1)

@interacts  writes mail/, status/ and cards/ under ROOT; no network. The waking side is
            Claude Code's background Bash: `tc wait` or `tc watch` exiting is
            what re-invokes the session that started it. `health` and `watch`
            also read /proc (meminfo, locks, each process's comm and cmdline)
            and run `nvidia-smi` when it exists. They never signal or touch
            another process. `send` to a codex card runs `codex queue` (C2).
@deps       python3 stdlib (argparse, collections, fcntl, json, pathlib, re,
            resource, shutil, subprocess, time, datetime, os, sys); Linux
            only (flock, RLIMIT_AS, /proc). nvidia-smi optional; the codex
            CLI for the codex route.
@complexity send O(b), b body bytes up to SEND_BODY_MAX_BYTES; status O(1).
            read/peek/wait-poll O(u), u unread messages in one inbox,
            single digits in practice. log O(t), t total messages ever,
            low hundreds per job. health and each watch poll
            O(p + k + n): p processes on the machine (hundreds), k lines in
            /proc/locks (tens), n mailbox names (single digits).
            join O(1); card O(u) for its unread count; cards O(c), c cards.
@alloc      one file per message, kept forever (read/ is the history); one
            card per name, replaced on a rejoin. Nothing
            held in memory past one command. `wait` measured flat at 13 MB RSS
            over 200k polls; it also hard-caps itself at WAIT_MEMORY_CAP_BYTES
            so a runaway dies alone. `wait` holds mail/.wait-<name>.lock for its
            lifetime; the kernel releases it when the process exits or is killed.
"""

import argparse
import collections
import datetime
import fcntl
import json
import os
import pathlib
import re
import resource
import shutil
import subprocess
import sys
import time

ROOT = pathlib.Path(os.environ.get("TC_ROOT", pathlib.Path(__file__).resolve().parent))
MAIL = ROOT / "mail"
STATUS = ROOT / "status"
SEQ_FILE = MAIL / ".seq"
SEQ_WIDTH = 6
POLL_SECONDS = 5
# Claude Code caps a background Bash at 7200 s. Exit before that so the
# session gets a clean "timeout, re-arm" instead of a killed command.
DEFAULT_WAIT_SECONDS = 6600
EXIT_TIMEOUT = 2
EXIT_ALREADY_LISTENING = 3
# Address-space ceiling for a listener. Measured need is about 13 MB; the cap
# only exists so a bug can never take the machine down with it.
WAIT_MEMORY_CAP_BYTES = 256 * 1024 * 1024
EXIT_ALERT = 5
# CARDS R1 (Claude Opus 5.5, unreviewed): mailbox names, contract C0.
# A name becomes a folder name here and a word on a remote command line over
# ssh (C3). So: letters, digits, dot, dash, underscore, at most this many,
# never a leading dash (it would read as an option), never only dots (a
# folder that means "here" or "up").
NAME_MAX_CHARS = 64
NAME_PATTERN = re.compile(rf"[A-Za-z0-9._][A-Za-z0-9._-]{{0,{NAME_MAX_CHARS - 1}}}")
# A bad name, refused before anything is written (contracts.md, exit codes).
EXIT_BAD_NAME = 6
# CARDS R2 (Claude Opus 5.5, unreviewed): address cards, contract C1.
# Refused with words: an empty message, --kind codex with no thread, a
# route not built yet (contracts.md, exit codes). Today's empty-message
# exit already meant this.
EXIT_REFUSED = 1
# One JSON file per name. A path built from ROOT, like MAIL and STATUS.
CARDS = ROOT / "cards"
# The card's own format number, so a later shape can be told apart.
CARD_VERSION = 1
CARD_KINDS = ("claude", "codex", "other")
# The account word when nothing names one. C1: never a blank.
UNKNOWN_ACCOUNT = "unknown"
# Where tc lives on the other machine when `tc card` is not told (C1).
DEFAULT_REMOTE_TC = "~/TheConnection/tc"
# C1: user@host or host alone, no leading dash on either part, no spaces.
# The target is a word on ssh's command line, where a dash means an option.
SSH_TARGET_PATTERN = re.compile(r"[A-Za-z0-9._][A-Za-z0-9._-]*(@[A-Za-z0-9._][A-Za-z0-9._-]*)?")
# C1: a remote tc path starts with one of these.
REMOTE_TC_PREFIXES = ("/", "~/")
# CARDS R3 (Claude Opus 5.5, unreviewed): the router (C2) and the size limit (C0).
# This is a mailbox for words: 1 MiB is far past any message a session
# writes, and small enough that a runaway pipe never fills the disk.
SEND_BODY_MAX_BYTES = 1048576
SEND_TOO_LARGE_WORDS = "tc send: message over 1 MiB; this is a mailbox for words"
# A message over SEND_BODY_MAX_BYTES, refused before it takes a number.
EXIT_TOO_LARGE = 8
# CARDS R4 (Claude Opus 5.5, unreviewed): the codex route (C2, D3).
# How long `codex queue` gets to answer. It only queues a line for the
# thread, so a healthy answer is quick; past this the sender stops waiting.
# The mail has landed before the ring either way.
CODEX_RING_SECONDS = 30

# Prompt cache. A Claude session's cache expires after this long with no
# request. Waking a session sooner than that keeps its cache warm. Override
# with TC_CACHE_TTL_SECONDS if your plan uses a different TTL.
CACHE_TTL_SECONDS = int(os.environ.get("TC_CACHE_TTL_SECONDS", 3600))
# Wake this long before the TTL runs out, to cover the poll interval and the
# time the session takes to respond. The margin shrinks with short TTLs (a
# twelfth of the TTL at most) so a 5-minute TTL still waits 275 s, not 0.
KEEPALIVE_MARGIN_SECONDS = float(os.environ.get("TC_KEEPALIVE_MARGIN_SECONDS", 300))
KEEPALIVE_MARGIN_MAX_FRACTION = 1 / 12
MIN_KEEPALIVE_SECONDS = 1

# `tc watch` defaults. A breach wakes the session early; otherwise it wakes
# once per heartbeat with a one-line summary.
WATCH_POLL_SECONDS = 15
LOAD_ALERT_RATIO = 0.9          # 1-minute load over CPU count
LOAD_STRIKES = 3                # consecutive polls over the line before alerting
MEM_AVAIL_MIN_PCT = 15
GPU_TEMP_MAX_C = 85
GPU_QUERY_TIMEOUT_SECONDS = 5
SECONDS_PER_MINUTE = 60
SECONDS_PER_HOUR = 3600
SECONDS_PER_DAY = 86400


def now_iso():
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")


def keepalive_seconds():
    margin = min(KEEPALIVE_MARGIN_SECONDS, CACHE_TTL_SECONDS * KEEPALIVE_MARGIN_MAX_FRACTION)
    return max(MIN_KEEPALIVE_SECONDS, CACHE_TTL_SECONDS - margin)


# CARDS R1 (Claude Opus 5.5, unreviewed): the one name check, contract C0.
def valid_name(name):
    """True when `name` may be a mailbox name under C0.

    1 to NAME_MAX_CHARS of letters, digits, dot, dash and underscore, no
    leading dash, not only dots. fullmatch, so a trailing newline fails.

    @interacts  none; string work only.
    @deps       re (NAME_PATTERN).
    @complexity O(c) over c characters in `name`, at most NAME_MAX_CHARS
                before the pattern stops matching.
    @alloc      the stripped copy for the dots check, freed on return.
    """
    return (isinstance(name, str) and NAME_PATTERN.fullmatch(name) is not None
            and name.strip(".") != "")


def require_names(*names):
    """Exit EXIT_BAD_NAME, with C0's words on stderr, at the first bad name.

    None is skipped (an optional name not given). Every command calls this
    before it touches the disk, so a bad name writes nothing.

    @interacts  writes one line to stderr and exits on a bad name; else none.
    @deps       valid_name, sys.
    @complexity O(n * c) over n names given (one to three) of c characters.
    @alloc      the message string on a bad name.
    """
    for name in names:
        if name is not None and not valid_name(name):
            print(f'tc: bad name "{name}": letters, digits, dot, dash, underscore, '
                  f'1 to {NAME_MAX_CHARS}, not starting with a dash', file=sys.stderr)
            sys.exit(EXIT_BAD_NAME)


def inbox(name):
    box = MAIL / f"to-{name}"
    (box / "read").mkdir(parents=True, exist_ok=True)
    return box


def unread(name):
    return sorted(p for p in inbox(name).glob("*.md"))


def next_seq():
    MAIL.mkdir(parents=True, exist_ok=True)
    with open(SEQ_FILE, "a+") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.seek(0)
        n = int(f.read().strip() or 0) + 1
        f.seek(0)
        f.truncate()
        f.write(str(n))
    return n


def cmd_send(args):
    """`tc send`: check, then hand the message to the route on the recipient's card (C2).

    No card means route local: today's send, with today's stdout line. The
    route's Delivery decides the rest: words to stdout on exit 0, else to
    stderr; every warning to stderr; then its exit code.

    @interacts  checks both names first (C0, exit 6, nothing written); reads
                the body (stdin when no text is given) and refuses one over
                SEND_BODY_MAX_BYTES (exit 8) or empty (exit 1) before any
                number is taken; reads cards/<to>.json; calls one ROUTES
                function, which writes the message; prints.
    @deps       require_names, read_body, read_card, refuse, ROUTES, Delivery.
    @complexity O(b) over b bytes of body, at most SEND_BODY_MAX_BYTES,
                plus the route's own work.
    @alloc      the body string, freed on exit; whatever the route keeps.
    """
    require_names(args.sender, args.to)  # CARDS R1 (Claude Opus 5.5, unreviewed)
    # CARDS R3 (Claude Opus 5.5, unreviewed): size, then the card, then the route.
    body = read_body(args.message)
    if not body.strip():
        sys.exit("tc send: empty message")
    try:
        card = read_card(args.to)
    except ValueError as problem:
        refuse(f"tc send: {problem}; nothing sent. Rewrite it with tc join or tc card.", EXIT_REFUSED)
    route = card.get("route") if card is not None else "local"
    deliver = ROUTES.get(route) if isinstance(route, str) else None
    if deliver is None:
        result = Delivery(EXIT_REFUSED, f"route {route} is not built yet", [])
    else:
        result = deliver(card, args.sender, args.to, body)
    print(result.words, file=sys.stdout if result.exit == 0 else sys.stderr)
    for warning in result.warnings:
        print(warning, file=sys.stderr)
    if result.exit != 0:
        sys.exit(result.exit)


def show(paths):
    for p in paths:
        print(p.read_text())
        print("---")


def cmd_read(args):
    """`tc read <name>`: print unread mail and move it to read/.

    @interacts  checks the name first (C0, exit 6, nothing written); a name
                with no inbox gets `no unread mail` and nothing is created
                (O2); else makes mail/to-<name>/read/ if missing, reads and
                renames each unread file; prints to stdout.
    @deps       require_names, unread, show.
    @complexity O(u) over u unread messages (single digits).
    @alloc      the list of paths and each file's text while printed.
    """
    require_names(args.name)  # CARDS R1 (Claude Opus 5.5, unreviewed)
    if not (MAIL / f"to-{args.name}").is_dir():  # CARDS R3 (Claude Opus 5.5, unreviewed): O2
        print(f"no unread mail for {args.name}")
        return
    msgs = unread(args.name)
    if not msgs:
        print(f"no unread mail for {args.name}")
        return
    show(msgs)
    for p in msgs:
        p.rename(p.parent / "read" / p.name)


def cmd_peek(args):
    """`tc peek <name>`: print unread mail and leave it unread.

    @interacts  checks the name first (C0, exit 6, nothing written); a name
                with no inbox gets `no unread mail` and nothing is created
                (O2); else makes mail/to-<name>/read/ if missing and reads
                each unread file; prints to stdout.
    @deps       require_names, unread, show.
    @complexity O(u) over u unread messages (single digits).
    @alloc      the list of paths and each file's text while printed.
    """
    require_names(args.name)  # CARDS R1 (Claude Opus 5.5, unreviewed)
    if not (MAIL / f"to-{args.name}").is_dir():  # CARDS R3 (Claude Opus 5.5, unreviewed): O2
        print(f"no unread mail for {args.name}")
        return
    msgs = unread(args.name)
    print(f"{len(msgs)} unread for {args.name}")
    show(msgs)


def cmd_wait(args):
    """`tc wait <name>`: hold the name's lock and poll until mail lands.

    Exit 0 on mail, EXIT_TIMEOUT at the deadline, EXIT_ALREADY_LISTENING
    when another wait holds the lock.

    @interacts  checks the name first (C0, exit 6, nothing written); caps
                its own address space; makes mail/ and holds
                mail/.wait-<name>.lock (flock) until it exits; makes
                mail/to-<name>/read/ on the first poll; prints one line.
    @deps       require_names, unread, keepalive_seconds; fcntl, resource.
    @complexity O(u) per poll over u unread messages; one poll every
                POLL_SECONDS until the timeout.
    @alloc      one open lock file for its lifetime; flat at about 13 MB.
    """
    require_names(args.name)  # CARDS R1 (Claude Opus 5.5, unreviewed)
    resource.setrlimit(resource.RLIMIT_AS, (WAIT_MEMORY_CAP_BYTES, WAIT_MEMORY_CAP_BYTES))
    MAIL.mkdir(parents=True, exist_ok=True)
    lock = open(MAIL / f".wait-{args.name}.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print(f"ALREADY LISTENING: another `tc wait {args.name}` is running. Not starting a second.")
        sys.exit(EXIT_ALREADY_LISTENING)
    timeout = args.timeout if args.timeout is not None else (
        keepalive_seconds() if args.keepalive else DEFAULT_WAIT_SECONDS)
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        msgs = unread(args.name)
        if msgs:
            print(f"MAIL: {len(msgs)} unread for {args.name}. Run: tc read {args.name}")
            return
        time.sleep(min(POLL_SECONDS, max(0.0, deadline - time.monotonic())))
    if args.keepalive:
        print(f"KEEPALIVE: no mail for {args.name} in {timeout:g}s. This wake refreshed the cache. "
              f"Re-arm: tc wait {args.name} --keepalive")
    else:
        print(f"TIMEOUT: no mail for {args.name} in {timeout:g}s. Re-arm: tc wait {args.name}")
    sys.exit(EXIT_TIMEOUT)


def cmd_status(args):
    """`tc status [<name> <text>]`: post one side's status, or show them all.

    @interacts  checks the name first when one is given (C0, exit 6,
                nothing written); makes status/; writes status/<name>.md
                whole, or reads every status file; prints to stdout.
    @deps       require_names, now_iso.
    @complexity O(s) over s status files when showing (single digits).
    @alloc      each file's text while printed.
    """
    require_names(args.name)  # CARDS R1 (Claude Opus 5.5, unreviewed)
    STATUS.mkdir(parents=True, exist_ok=True)
    if args.text is None:
        files = sorted(STATUS.glob("*.md"))
        if not files:
            print("no status posted")
        for p in files:
            print(p.read_text())
        return
    (STATUS / f"{args.name}.md").write_text(f"## {args.name} status, {now_iso()}\n\n{args.text}\n")
    print(f"status posted for {args.name}")


def cmd_log(args):
    every = sorted(MAIL.glob("to-*/**/*.md"), key=lambda p: p.name)
    if not every:
        print("mailbox empty")
    show(every[-args.last:] if args.last else every)


# ---------- cards: who each name is and how mail reaches it (C1) ----------
# CARDS R2 (Claude Opus 5.5, unreviewed). No card names a hub (D7):
# reports_to is a hint for tc cards, tc health and the board, never a route.

def unread_count(name):
    """How many unread messages mail/to-<name>/ holds; 0 with no inbox.

    Unlike unread(), it never creates the inbox.

    @interacts  globs mail/to-<name>/*.md. Writes nothing.
    @deps       pathlib.
    @complexity O(u) over u unread messages (single digits).
    @alloc      one list of paths, freed on return.
    """
    return len(list((MAIL / f"to-{name}").glob("*.md")))


def refuse(words, code):
    """Print `words` to stderr and exit with `code`.

    @interacts  writes one line to stderr; exits.
    @deps       sys.
    @complexity O(1).
    @alloc      none.
    """
    print(words, file=sys.stderr)
    sys.exit(code)


def refuse_self_report(name, reports_to):
    """Exit EXIT_BAD_NAME when a name says it reports to itself (C1).

    @interacts  writes one line to stderr and exits on a self-report.
    @deps       refuse.
    @complexity O(c) over the name's characters.
    @alloc      none.
    """
    if reports_to is not None and reports_to == name:
        refuse(f"tc: {name} cannot report to itself", EXIT_BAD_NAME)


def account_label(given):
    """The card's account: `given`, else CLAUDE_CONFIG_DIR's base name, else UNKNOWN_ACCOUNT.

    A blank value counts as not given at each step, so the word is never
    empty (C1).

    @interacts  reads CLAUDE_CONFIG_DIR from the environment when `given`
                is blank, and nothing else.
    @deps       os, pathlib.
    @complexity O(c) over the characters of the value used.
    @alloc      the label string, returned.
    """
    if given is not None and given.strip():
        return given
    config = os.environ.get("CLAUDE_CONFIG_DIR")
    if config and pathlib.Path(config).name.strip():
        return pathlib.Path(config).name
    return UNKNOWN_ACCOUNT


def write_card(card):
    """Write cards/<name>.json whole: a .tmp sibling, then a rename over the old card.

    The .tmp name carries this process's pid, so two joins of one name at
    once never write into the same file.

    @interacts  makes cards/; writes cards/<name>.json.<pid>.tmp and renames
                it to cards/<name>.json, replacing any card there.
    @deps       json, os, pathlib.
    @complexity O(1): eleven fields.
    @alloc      one JSON string, freed on return; one card file, kept.
    """
    CARDS.mkdir(parents=True, exist_ok=True)
    path = CARDS / f"{card['name']}.json"
    tmp = CARDS / f"{card['name']}.json.{os.getpid()}.tmp"
    tmp.write_text(json.dumps(card, indent=2) + "\n")
    tmp.rename(path)  # atomic, so a reader never sees half a card
    return path


def describe_card(card):
    """One card in words: `<name> (<kind>, account <a>, route <r>)`, plus `, reports to <N>`.

    An ssh card's route reads `route ssh to <target>`. A field missing from
    a hand-made card shows as `?`.

    @interacts  none; string work only.
    @deps       none.
    @complexity O(1).
    @alloc      one string, returned.
    """
    route = card.get("route", "?")
    if route == "ssh" and isinstance(card.get("ssh"), dict):
        route = f"ssh to {card['ssh'].get('target', '?')}"
    text = (f"{card.get('name', '?')} ({card.get('kind', '?')}, "
            f"account {card.get('account', '?')}, route {route})")
    if card.get("reports_to"):
        text += f", reports to {card['reports_to']}"
    return text


def all_cards():
    """Every card under cards/, by name: a list of (file name, card or None).

    None stands for a file that is not a JSON object (hand-edited or cut
    short); the caller says so instead of guessing.

    @interacts  globs and reads cards/*.json. Writes nothing.
    @deps       json, pathlib.
    @complexity O(n) over n cards (single digits).
    @alloc      one list of n dicts, returned.
    """
    out = []
    for path in sorted(CARDS.glob("*.json")) if CARDS.exists() else []:
        try:
            card = json.loads(path.read_text())
        except (OSError, ValueError):
            card = None
        out.append((path.name, card if isinstance(card, dict) else None))
    return out


def cmd_join(args):
    """`tc join <name>`: write the card for the session this runs in (C1).

    Reads exactly five environment variables: CODEX_THREAD_ID, CLAUDECODE,
    CLAUDE_CODE_SESSION_ID, CLAUDE_PID and CLAUDE_CONFIG_DIR. Nothing else,
    so the native path's socket and token never reach a card.

    @interacts  checks both names (C0, exit 6) and a self-report (exit 6);
                refuses --kind codex with no CODEX_THREAD_ID (exit 1); then
                writes cards/<name>.json through write_card, replacing any
                card there and resetting joined_at; prints one line.
    @deps       require_names, refuse_self_report, refuse, account_label,
                write_card, describe_card, now_iso; os.
    @complexity O(1).
    @alloc      one card dict, freed on exit; one card file, kept.
    """
    require_names(args.name, args.reports_to)
    refuse_self_report(args.name, args.reports_to)
    thread = os.environ.get("CODEX_THREAD_ID") or None
    if args.kind:
        kind = args.kind
    elif thread:
        kind = "codex"
    elif os.environ.get("CLAUDECODE") == "1":
        kind = "claude"
    else:
        kind = "other"
    if kind == "codex" and not thread:
        refuse("tc join: kind codex needs CODEX_THREAD_ID, the thread the codex route "
               "rings, and it is not set. Run tc join inside the Codex session.", EXIT_REFUSED)
    pid = os.environ.get("CLAUDE_PID")
    card = {
        "version": CARD_VERSION,
        "name": args.name,
        "kind": kind,
        "account": account_label(args.account),
        "route": "codex" if kind == "codex" else "local",
        "session_id": os.environ.get("CLAUDE_CODE_SESSION_ID") or None,
        "pid": int(pid) if pid and pid.isascii() and pid.isdigit() else None,
        "thread_id": thread,
        "ssh": None,
        "reports_to": args.reports_to,
        "joined_at": now_iso(),
    }
    write_card(card)
    print(f"joined as {describe_card(card)}")


def cmd_card(args):
    """`tc card <name> --ssh user@host`: write a card for a name on another machine (C1).

    @interacts  checks both names and a self-report (exit 6), the ssh
                target and the remote tc path (exit 6); counts unread mail
                in mail/to-<name>/ without creating it and refuses (exit 1)
                when there is any, unless --force; then writes
                cards/<name>.json through write_card; prints one line.
                Reads CLAUDE_CONFIG_DIR only when --account is blank.
    @deps       require_names, refuse_self_report, refuse, unread_count,
                account_label, write_card, describe_card, now_iso.
    @complexity O(u) over u unread messages for the name (single digits).
    @alloc      one card dict, freed on exit; one card file, kept.
    """
    require_names(args.name, args.reports_to)
    refuse_self_report(args.name, args.reports_to)
    if not SSH_TARGET_PATTERN.fullmatch(args.ssh):
        refuse(f'tc card: bad ssh target "{args.ssh}": user@host or host, '
               f'no leading dash on either part, no spaces', EXIT_BAD_NAME)
    remote = args.remote_tc
    if not remote.startswith(REMOTE_TC_PREFIXES) or any(c.isspace() for c in remote):
        refuse(f'tc card: bad remote tc path "{remote}": it starts with / or ~/ '
               f'and has no spaces', EXIT_BAD_NAME)
    waiting = unread_count(args.name)
    if waiting and not args.force:
        refuse(f"tc card: {args.name} has {waiting} unread here. Once its card says ssh, "
               f"sends go to the other machine and that mail is never read. Read it first "
               f"(tc read {args.name}), or pass --force.", EXIT_REFUSED)
    card = {
        "version": CARD_VERSION,
        "name": args.name,
        "kind": "other",
        "account": account_label(args.account),
        "route": "ssh",
        "session_id": None,
        "pid": None,
        "thread_id": None,
        "ssh": {"target": args.ssh, "tc": remote},
        "reports_to": args.reports_to,
        "joined_at": now_iso(),
    }
    write_card(card)
    print(f"card written: {describe_card(card)}")


def cmd_cards(args):
    """`tc cards`: every card, one line each, in words.

    @interacts  reads cards/*.json through all_cards; prints to stdout.
    @deps       all_cards, describe_card.
    @complexity O(n) over n cards (single digits).
    @alloc      the list of cards, freed on exit.
    """
    cards = all_cards()
    if not cards:
        print("no cards")
    for file_name, card in cards:
        print(describe_card(card) if card is not None else f"{file_name}: unreadable card")


# ---------- router: tc send delivers by the recipient's card (C2) ----------
# CARDS R3 (Claude Opus 5.5, unreviewed). No hub (D7): the route comes from
# the recipient's card alone. Nothing here reads reports_to.

# What a route hands back to cmd_send: its exit code, the words to print
# (stdout on 0, else stderr), and warnings for stderr whatever the exit.
Delivery = collections.namedtuple("Delivery", "exit words warnings")


def read_card(name):
    """The card for `name` as a dict, or None when it has none.

    Raises ValueError, with words naming the file, for a card that is not
    a JSON object: the router refuses rather than guess a route.

    @interacts  reads cards/<name>.json. Writes nothing.
    @deps       json, pathlib.
    @complexity O(1): one small file.
    @alloc      one dict, returned.
    """
    path = CARDS / f"{name}.json"
    if not path.exists():
        return None
    try:
        card = json.loads(path.read_text())
    except (OSError, ValueError) as err:
        raise ValueError(f"the card {path} is unreadable ({err})") from err
    if not isinstance(card, dict):
        raise ValueError(f"the card {path} is not a JSON object")
    return card


def read_body(message):
    """The message body: `message` when given, else stdin. Over the limit exits 8.

    Reads at most SEND_BODY_MAX_BYTES + 1 bytes from stdin and decodes them
    as sys.stdin would, so the body is the same text today's send saw. A
    text argument is measured in the bytes it came in as. Runs before
    next_seq(), so a refusal uses no number (C0).

    @interacts  reads stdin when `message` is empty; on a body over the
                limit, writes SEND_TOO_LARGE_WORDS to stderr and exits.
    @deps       refuse; os, sys.
    @complexity O(b) over b bytes, at most SEND_BODY_MAX_BYTES + 1.
    @alloc      the raw bytes and the decoded string, at most about
                2 x SEND_BODY_MAX_BYTES at once; the string is returned.
    """
    if message:
        if len(os.fsencode(message)) > SEND_BODY_MAX_BYTES:
            refuse(SEND_TOO_LARGE_WORDS, EXIT_TOO_LARGE)
        return message
    raw = sys.stdin.buffer.read(SEND_BODY_MAX_BYTES + 1)
    if len(raw) > SEND_BODY_MAX_BYTES:
        refuse(SEND_TOO_LARGE_WORDS, EXIT_TOO_LARGE)
    return raw.decode(sys.stdin.encoding, sys.stdin.errors)


def deliver_local(card, sender, to, body, header_note=None):
    """Route local: today's send. Seq under flock, write a .tmp, rename into the inbox.

    Warns `new inbox: nobody has joined as <to>` when the inbox did not
    exist before this send (O1). `header_note`, when given, ends the
    header line after a comma (the gate's, C3). `card` is unused here; the
    argument keeps every route's shape the same.

    @interacts  takes the mail/.seq flock (next_seq); makes
                mail/to-<to>/read/; writes NNNNNN-from-<sender>.tmp and
                renames it to .md in mail/to-<to>/.
    @deps       next_seq, inbox, now_iso, Delivery.
    @complexity O(b) over b bytes of body.
    @alloc      the message text while written; one message file, kept.
    """
    box_existed = (MAIL / f"to-{to}").is_dir()
    n = next_seq()
    path = inbox(to) / f"{n:0{SEQ_WIDTH}d}-from-{sender}.md"
    tmp = path.with_suffix(".tmp")
    header = f"# #{n} from {sender} to {to}, {now_iso()}" + (f", {header_note}" if header_note else "")
    tmp.write_text(f"{header}\n\n{body.rstrip()}\n")
    tmp.rename(path)  # atomic, so a waiter never reads a half-written file
    warnings = [] if box_existed else [f"new inbox: nobody has joined as {to}"]
    return Delivery(0, f"sent #{n} to {to}: {path}", warnings)


# CARDS R4 (Claude Opus 5.5, unreviewed): the codex route, a doorbell (D3).
def deliver_codex(card, sender, to, body, header_note=None):
    """Route codex: deliver_local, then ring the Codex thread if the inbox was empty.

    A listener started inside Codex dies when its command returns (D3), so
    a Codex session is woken by `codex queue`, which hands its thread a
    line to act on when its turn ends or the session is resumed. It rings
    only when the inbox held no unread mail before this send: one ring per
    batch. Two senders racing an empty inbox may both ring; accepted. A
    ring that fails or times out is a warning: the mail is in the inbox,
    so the send still exits 0.

    @interacts  counts mail/to-<to>/*.md without creating it; writes the
                message through deliver_local; when the count was 0, runs
                `codex queue --thread <thread_id> --message ...` with stdin
                from /dev/null and a CODEX_RING_SECONDS timeout. Reads
                nothing from codex but its exit code and stderr.
    @deps       unread_count, deliver_local, Delivery; subprocess, pathlib;
                the `codex` CLI on PATH.
    @complexity O(u + b) over u unread messages (counted twice) and b
                bytes of body, plus one codex run of at most
                CODEX_RING_SECONDS.
    @alloc      the ring's message and codex's captured output, freed on
                return; one message file, kept.
    """
    waiting = unread_count(to)
    landed = deliver_local(card, sender, to, body, header_note)
    if waiting:
        return landed
    words, warnings = [landed.words], list(landed.warnings)
    thread = card.get("thread_id") if card else None
    tc_path = pathlib.Path(__file__).resolve()
    message = (f"MAIL: {unread_count(to)} unread for {to}. Run: {tc_path} read {to}, act on it, "
               f"reply with {tc_path} send --from {to} --to {sender}.")
    reason = None
    if not thread:
        reason = "its card has no thread_id"
    else:
        try:
            done = subprocess.run(["codex", "queue", "--thread", thread, "--message", message],
                                  stdin=subprocess.DEVNULL, capture_output=True, text=True,
                                  timeout=CODEX_RING_SECONDS)
        except subprocess.TimeoutExpired:
            reason = f"no answer in {CODEX_RING_SECONDS} s"
        except OSError as err:
            reason = f"could not run codex ({err.strerror})"
        else:
            said = done.stderr.strip().splitlines()
            if done.returncode != 0:
                reason = said[0] if said else f"codex exited {done.returncode} with no stderr"
    if reason is None:
        words.append(f"rang codex {to} (queued; delivered when its turn ends or the session is resumed)")
    else:
        warnings.append(f"ring failed for {to}: {reason}; the mail is in its inbox")
    return Delivery(landed.exit, "\n".join(words), warnings)


# One function per route; a card's route picks one. A route not here
# answers "route <route> is not built yet" (C2). Each lane adds its own line.
ROUTES = {
    "local": deliver_local,
    "codex": deliver_codex,
}


# ---------- health: machine, sessions, listeners, mail ----------

def machine_stats():
    """Load, memory and GPU right now. GPU is None when nvidia-smi is absent."""
    load1 = os.getloadavg()[0]
    cores = os.cpu_count() or 1
    info = {}
    with open("/proc/meminfo") as f:
        for line in f:
            key, _, rest = line.partition(":")
            info[key] = int(rest.split()[0])
    mem_pct = 100.0 * info["MemAvailable"] / info["MemTotal"]
    return {"load1": round(load1, 2), "cores": cores,
            "mem_avail_pct": round(mem_pct, 1), "gpus": gpu_stats()}


def gpu_stats():
    exe = shutil.which("nvidia-smi")
    if not exe:
        return None
    try:
        out = subprocess.run([exe, "--query-gpu=temperature.gpu,utilization.gpu",
                              "--format=csv,noheader,nounits"], capture_output=True,
                             text=True, timeout=GPU_QUERY_TIMEOUT_SECONDS).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    gpus = []
    for line in out.strip().splitlines():
        parts = [x.strip() for x in line.split(",")]
        if len(parts) == 2 and all(x.isdigit() for x in parts):
            gpus.append({"temp_c": int(parts[0]), "util_pct": int(parts[1])})
    return gpus or None


def _cmdline(pid):
    try:
        raw = pathlib.Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return []
    return [a.decode(errors="replace") for a in raw.split(b"\0") if a]


def _is_codex(argv):
    if not argv or any("app-server-daemon" in a for a in argv):
        return False
    first = os.path.basename(argv[0])
    return first == "codex" or (first == "node" and len(argv) > 1 and os.path.basename(argv[1]) == "codex")


def session_counts():
    """Claude Code sessions (process name `claude`) and Codex CLI sessions.

    Codex is approximate: a CLI started through node spawns a native `codex`
    child, so a codex process whose parent is also codex is not counted again,
    and the app-server daemon is skipped.
    """
    claude, codex_pids, parent = 0, set(), {}
    for d in pathlib.Path("/proc").iterdir():
        if not d.name.isdigit():
            continue
        try:
            stat = (d / "stat").read_text()
        except OSError:
            continue
        # comm is in parens and may hold spaces; fields after it are fixed.
        comm = stat[stat.index("(") + 1:stat.rindex(")")]
        fields = stat[stat.rindex(")") + 2:].split()
        state, ppid = fields[0], fields[1]
        if state == "Z":
            continue
        if comm == "claude":
            claude += 1
        elif _is_codex(_cmdline(d.name)):
            codex_pids.add(d.name)
            parent[d.name] = ppid
    codex = sum(1 for pid in codex_pids if parent[pid] not in codex_pids)
    return {"claude": claude, "codex": codex}


def _flock_holders():
    """Map 'major:minor:inode' to the pid holding an flock on that file."""
    holders = {}
    try:
        lines = pathlib.Path("/proc/locks").read_text().splitlines()
    except OSError:
        return holders
    for line in lines:
        f = line.split()
        if len(f) >= 6 and f[1] == "FLOCK":
            holders[f[5]] = int(f[4])
    return holders


def _lock_key(path):
    st = path.stat()
    return f"{os.major(st.st_dev):02x}:{os.minor(st.st_dev):02x}:{st.st_ino}"


def listeners(kind="wait"):
    """Each name that ever ran `tc <kind>`, with the pid holding its lock or None.

    Reads /proc/locks instead of trying the lock, so probing never races a
    listener that is starting up.
    """
    holders = _flock_holders()
    out = {}
    if not MAIL.exists():
        return out
    prefix = f".{kind}-"
    for lock in sorted(MAIL.glob(f"{prefix}*.lock")):
        name = lock.name[len(prefix):-len(".lock")]
        try:
            out[name] = holders.get(_lock_key(lock))
        except OSError:
            out[name] = None
    return out


def _age(seconds):
    if seconds is None:
        return None
    if seconds < SECONDS_PER_MINUTE:
        return f"{int(seconds)}s"
    if seconds < SECONDS_PER_HOUR:
        return f"{int(seconds // SECONDS_PER_MINUTE)}m"
    if seconds < SECONDS_PER_DAY:
        return f"{int(seconds // SECONDS_PER_HOUR)}h"
    return f"{int(seconds // SECONDS_PER_DAY)}d"


def mailbox_summary():
    now = time.time()
    names = sorted({p.name[len("to-"):] for p in MAIL.glob("to-*") if p.is_dir()}) if MAIL.exists() else []
    out = {}
    for name in names:
        box = MAIL / f"to-{name}"
        every = list(box.glob("*.md")) + list((box / "read").glob("*.md"))
        newest = max((p.stat().st_mtime for p in every), default=None)
        st = STATUS / f"{name}.md"
        out[name] = {
            "unread": len(list(box.glob("*.md"))),
            "newest_mail_age_s": None if newest is None else round(now - newest),
            "status_age_s": round(now - st.stat().st_mtime) if st.exists() else None,
        }
    return out


def health_snapshot():
    return {"time": now_iso(), "machine": machine_stats(), "sessions": session_counts(),
            "listeners": listeners("wait"), "watchers": listeners("watch"),
            "mail": mailbox_summary()}


def _gpu_text(gpus):
    if not gpus:
        return "GPU none"
    return " · ".join(f"GPU {g['temp_c']}C {g['util_pct']}%" for g in gpus)


def _who(table):
    up = [f"{n} (pid {pid})" for n, pid in table.items() if pid]
    down = [n for n, pid in table.items() if not pid]
    text = " · ".join(up) if up else "none running"
    return text + (f" · stopped: {', '.join(down)}" if down else "")


def cmd_health(args):
    snap = health_snapshot()
    if args.json:
        print(json.dumps(snap, indent=2))
        return
    m, s = snap["machine"], snap["sessions"]
    print(f"machine    load {m['load1']} / {m['cores']} cores · mem free {m['mem_avail_pct']}% · {_gpu_text(m['gpus'])}")
    print(f"sessions   {s['claude']} Claude Code · {s['codex']} Codex")
    print(f"listeners  {_who(snap['listeners'])}")
    print(f"watchers   {_who(snap['watchers'])}")
    rows = []
    for name, b in snap["mail"].items():
        bits = [f"{b['unread']} unread"]
        if b["newest_mail_age_s"] is not None:
            bits.append(f"last mail {_age(b['newest_mail_age_s'])} ago")
        if b["status_age_s"] is not None:
            bits.append(f"status {_age(b['status_age_s'])} ago")
        rows.append(f"{name}: " + ", ".join(bits))
    print("mail       " + ("\n           ".join(rows) if rows else "empty"))


# ---------- watch: heartbeat and alerts that wake the session ----------

def _breaches(m, args, strikes):
    found = []
    if strikes >= LOAD_STRIKES:
        found.append(f"load {m['load1']} over {args.load_ratio} x {m['cores']} cores for {strikes} polls")
    if m["mem_avail_pct"] < args.mem_min_pct:
        found.append(f"mem free {m['mem_avail_pct']}% under {args.mem_min_pct}%")
    for i, g in enumerate(m["gpus"] or []):
        if g["temp_c"] > args.gpu_max_c:
            found.append(f"GPU{i} {g['temp_c']}C over {args.gpu_max_c}C")
    return found


def cmd_watch(args):
    """`tc watch <name>`: heartbeat or alert that wakes the session <name>.

    @interacts  checks the name first (C0, exit 6, nothing written); caps
                its own address space; makes mail/ and holds
                mail/.watch-<name>.lock (flock) until it exits; reads /proc
                and runs nvidia-smi each poll (see machine_stats,
                listeners); prints a HEARTBEAT or ALERT line.
    @deps       require_names, machine_stats, listeners, session_counts,
                _breaches; fcntl, resource.
    @complexity O(p + k + n) per poll, as health (module block); one poll
                every args.poll seconds until the heartbeat.
    @alloc      one open lock file for its lifetime; the peaks, a few floats.
    """
    require_names(args.name)  # CARDS R1 (Claude Opus 5.5, unreviewed)
    resource.setrlimit(resource.RLIMIT_AS, (WAIT_MEMORY_CAP_BYTES, WAIT_MEMORY_CAP_BYTES))
    MAIL.mkdir(parents=True, exist_ok=True)
    lock = open(MAIL / f".watch-{args.name}.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print(f"ALREADY WATCHING: another `tc watch {args.name}` is running. Not starting a second.")
        sys.exit(EXIT_ALREADY_LISTENING)
    tracked = [n for n in (args.names.split(",") if args.names else []) if n]
    alive_at_start = {n for n, pid in listeners("wait").items() if n in tracked and pid}
    peak_load, low_mem, peak_gpu, strikes = 0.0, 100.0, None, 0
    deadline = time.monotonic() + args.heartbeat
    while True:
        m = machine_stats()
        over = m["load1"] > args.load_ratio * m["cores"]
        strikes = strikes + 1 if over else 0
        peak_load = max(peak_load, m["load1"])
        low_mem = min(low_mem, m["mem_avail_pct"])
        for g in m["gpus"] or []:
            peak_gpu = g["temp_c"] if peak_gpu is None else max(peak_gpu, g["temp_c"])
        problems = _breaches(m, args, strikes)
        now_alive = {n for n, pid in listeners("wait").items() if pid}
        problems += [f"LISTENER DOWN: {n}" for n in sorted(alive_at_start - now_alive)]
        if problems:
            print(f"ALERT {now_iso()}: " + "; ".join(problems))
            print(f"  now: load {m['load1']} / {m['cores']}, mem free {m['mem_avail_pct']}%, {_gpu_text(m['gpus'])}")
            print(f"Re-arm after handling: tc watch {args.name}")
            sys.exit(EXIT_ALERT)
        if time.monotonic() >= deadline:
            break
        time.sleep(min(args.poll, max(0.0, deadline - time.monotonic())))
    s = session_counts()
    gpu = "GPU none" if peak_gpu is None else f"GPU peak {peak_gpu}C"
    up = sorted(n for n, pid in listeners("wait").items() if pid)
    print(f"HEARTBEAT {now_iso()}: load {m['load1']} (peak {peak_load}) / {m['cores']}, "
          f"mem free {m['mem_avail_pct']}% (low {low_mem}%), {gpu}, "
          f"{s['claude']} Claude Code, {s['codex']} Codex, listening: {', '.join(up) or 'none'}")
    print(f"Re-arm: tc watch {args.name}")


def main():
    """Parse the command line and run one command.

    @interacts  reads sys.argv; whatever the chosen cmd_* does.
    @deps       argparse; every cmd_* function.
    @complexity O(a) over a arguments to parse, plus the command.
    @alloc      the parser and the parsed arguments, freed on exit.
    """
    ap = argparse.ArgumentParser(prog="tc", description="Mailbox between Claude sessions.")
    sub = ap.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("send", help="send a message (text arg or stdin)")
    s.add_argument("--from", dest="sender", required=True)
    s.add_argument("--to", required=True)
    s.add_argument("message", nargs="?")
    s.set_defaults(fn=cmd_send)

    for name, fn, text in (("read", cmd_read, "print unread and mark read"),
                           ("peek", cmd_peek, "print unread, leave unread")):
        p = sub.add_parser(name, help=text)
        p.add_argument("name")
        p.set_defaults(fn=fn)

    w = sub.add_parser("wait", help="block until mail arrives (run in background)")
    w.add_argument("name")
    w.add_argument("--timeout", type=float, default=None,
                   help=f"seconds (default {DEFAULT_WAIT_SECONDS}, or just under the cache TTL with --keepalive)")
    w.add_argument("--keepalive", action="store_true",
                   help="wake just before the prompt cache expires, so an idle session stays warm")
    w.set_defaults(fn=cmd_wait)

    st = sub.add_parser("status", help="post status (with text) or show all (without)")
    st.add_argument("name", nargs="?")
    st.add_argument("text", nargs="?")
    st.set_defaults(fn=cmd_status)

    lg = sub.add_parser("log", help="full history, both directions")
    lg.add_argument("--last", type=int, default=0)
    lg.set_defaults(fn=cmd_log)

    h = sub.add_parser("health", help="machine load, memory, GPU, sessions, listeners, mail")
    h.add_argument("--json", action="store_true", help="machine-readable, for a board")
    h.set_defaults(fn=cmd_health)

    wt = sub.add_parser("watch", help="heartbeat for a session; exits early on an alert (run in background)")
    wt.add_argument("name", help="the session this watcher wakes")
    wt.add_argument("--heartbeat", type=float, default=keepalive_seconds(),
                    help="seconds between heartbeats (default: just under the cache TTL)")
    wt.add_argument("--poll", type=float, default=WATCH_POLL_SECONDS)
    wt.add_argument("--names", default="", help="comma list of listeners to watch; alert if one goes down")
    wt.add_argument("--load-ratio", type=float, default=LOAD_ALERT_RATIO)
    wt.add_argument("--mem-min-pct", type=float, default=MEM_AVAIL_MIN_PCT)
    wt.add_argument("--gpu-max-c", type=float, default=GPU_TEMP_MAX_C)
    wt.set_defaults(fn=cmd_watch)

    # CARDS R2 (Claude Opus 5.5, unreviewed): join, card, cards (C1).
    j = sub.add_parser("join", help="write the address card for the session this runs in")
    j.add_argument("name")
    j.add_argument("--account", help="account label (default: CLAUDE_CONFIG_DIR's base name, else unknown)")
    j.add_argument("--kind", choices=CARD_KINDS, help="override the kind tc works out")
    j.add_argument("--reports-to", dest="reports_to", help="a hint for the board's levels, never a route")
    j.set_defaults(fn=cmd_join)

    cd = sub.add_parser("card", help="write a card for a name that lives on another machine")
    cd.add_argument("name")
    cd.add_argument("--ssh", required=True, metavar="USER@HOST")
    cd.add_argument("--remote-tc", dest="remote_tc", default=DEFAULT_REMOTE_TC,
                    help=f"tc's path on that machine (default {DEFAULT_REMOTE_TC})")
    cd.add_argument("--account")
    cd.add_argument("--reports-to", dest="reports_to")
    cd.add_argument("--force", action="store_true", help="write it even with unread mail here")
    cd.set_defaults(fn=cmd_card)

    cs = sub.add_parser("cards", help="every card, one line each")
    cs.set_defaults(fn=cmd_cards)

    args = ap.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
