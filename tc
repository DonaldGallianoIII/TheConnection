# SHARED fix round 1 (Claude Opus 5.5, unreviewed): D19, a FIFO at a lock's
# name is refused at once (O_NONBLOCK, then S_ISREG).
def open_regular(path, flags, mode=NEW_FILE_MODE):
    """Open the regular file at `path` with `flags`, making it at `mode` when nothing is there. A descriptor.

    Every open adds O_NOFOLLOW and O_NONBLOCK (D17, D19), and fstat checks
    the result before it is returned. So a symlink raises OSError (errno
    ELOOP), a FIFO never blocks (OSError ENXIO when it has no reader,
    else ValueError), a folder raises OSError (EISDIR) or ValueError, and
    anything else that is not a regular file raises ValueError. The
    descriptor returned is blocking again. A file already there is opened
    without O_CREAT, and only a missing one is made, with O_CREAT and
    O_EXCL (`mode` before the umask), then opened again if another
    process made it in between. The split matters under C4: in a sticky,
    group-writable folder (mail/, status/), Linux with
    fs.protected_regular = 2 refuses an O_CREAT open of a file that
    another user made, even one the group may write.

    @interacts  opens and fstats one file, creating it empty when missing.
    @deps       os, stat; NEW_FILE_MODE.
    @complexity O(1): at most three open calls and one fstat.
    @alloc      one descriptor, returned (the caller closes it), or closed
                before anything is raised.
    """
    problem = None
    for how in (flags, flags | os.O_CREAT | os.O_EXCL, flags):
        try:
            fd = os.open(path, how | os.O_NOFOLLOW | os.O_NONBLOCK, mode)
        except (FileNotFoundError, FileExistsError) as err:
            problem = err  # missing: make it; made in between: open that one
            continue
        try:
            if not stat.S_ISREG(os.fstat(fd).st_mode):
                raise ValueError("it is not a regular file")
            os.set_blocking(fd, True)
        except BaseException:
            os.close(fd)
            raise
        return fd
    raise problem


def open_by_name(path, flags, mode=NEW_FILE_MODE):
    """open_regular, refusing (exit 1, words) a symlink, a FIFO or anything else that is not a regular file. A descriptor.

    For each file tc opens by a name a group member can also write (D17,
    D19): the inbox locks, mail/.seq and status/<name>.md (P3 fix round
    1b, Claude Opus 5.5, unreviewed: the wait and watch locks live in
    their owner's inbox since D35, open_wake_lock). A symlink at the
    name, dangling or not, is refused,
    and so is a FIFO, at once instead of hanging tc; nothing is read or
    written through either. SHARED fix round 1 (Claude Opus 5.5,
    unreviewed): a file this user may not open (another member's status
    file, 0640 under D20) is refused with words naming its owner, never a
    traceback.

    @interacts  see open_regular; on a refusal, lstats the name for its
                owner, reads the user database, writes one line to stderr
                and exits 1.
    @deps       open_regular, refuse, user_name; errno, os; NEW_FILE_MODE,
                EXIT_REFUSED.
    @complexity O(1): at most three open calls and one fstat.
    @alloc      one descriptor, returned; the caller closes it.
    """
    try:
        return open_regular(path, flags, mode)
    except ValueError:
        problem = "is not a regular file, which tc never opens"
    except OSError as err:
        if err.errno == errno.ELOOP:
            problem = "is a symlink, which tc never follows"
        elif err.errno in (errno.ENXIO, errno.EISDIR):  # a FIFO with no reader, a folder
            problem = "is not a regular file, which tc never opens"
        elif err.errno == errno.EACCES:  # SHARED fix round 1 (Claude Opus 5.5, unreviewed): D20
            try:
                owner = user_name(os.lstat(path).st_uid)
            except OSError:
                owner = "another user"
            problem = (f"belongs to {owner}, and this user may not open it ({err.strerror}); under a "
                       f"shared mailbox only its owner writes it")
        else:
            raise
    refuse(f"tc: {path} {problem}; nothing written through it", EXIT_REFUSED)


def check_inbox(name, shared):
    """Refuse (exit 1) a bad mail/to-<name> or read/: a link or not a folder (D17), or, when `shared`, not its card owner's (D20). (box, read/) lstat results.

    Checked with lstat before tc join makes the joiner's own inbox
    (claim_inbox), so a symlink planted at an inbox's name, or at its
    read/, is refused. Nothing at the name passes: each result is None
    for what is not there. P3 fix round 1a (Claude Opus 5.5, unreviewed):
    D35. Every other command (send, the gate, read, peek, wait, log,
    health, the counts) opens the inbox once instead and works inside
    the open folder (pinned_inbox), refusing the same entries with these
    same words (refuse_bad_inbox); a check by lstat keeps no descriptor,
    so an inbox swapped after it would lead the next act elsewhere.

    SHARED fix round 1 (Claude Opus 5.5, unreviewed): D20 item 4. Under a
    shared mailbox an inbox, or its read/, whose owner differs from the
    owner of cards/<name>.json is refused with words: an old inbox, or one
    a sender made before D20, sits in a folder its recipient does not
    control, and tc never guesses which owner is right. With no card
    there, nothing is compared.

    SHARED fix round 3 (Claude Opus 5.5, unreviewed): an inbox or read/
    lstat cannot reach for any reason but not being there (an inbox its
    owner left without search for the group, say) is refused with words
    naming it and, for read/, the inbox's owner, exit 1, never a
    traceback, so another member's send, read, peek or wait for that name
    says why it stopped.

    @interacts  lstats mail/to-<name>, its read/ and, when `shared` and the
                inbox is there, cards/<name>.json; reads the user database
                for the words; on a bad one, one line to stderr and exit 1.
    @deps       refuse, user_name; os, stat; MAIL, CARDS, EXIT_REFUSED.
    @complexity O(1): at most three lstat calls.
    @alloc      up to three stat results; the two for the inbox returned.
    """
    box = MAIL / f"to-{name}"
    found = []
    for path in (box, box / "read"):
        try:
            st = os.lstat(path)
        except FileNotFoundError:
            break
        except OSError as err:  # SHARED fix round 3 (Claude Opus 5.5, unreviewed): words, never a traceback
            whose = f" {box} belongs to {user_name(found[0].st_uid)}." if found else ""
            refuse(f"tc: could not look at {path} ({err.strerror}); nothing was read or written there.{whose}",
                   EXIT_REFUSED)
        if stat.S_ISLNK(st.st_mode):
            refuse(f"tc: {path} is a symlink, not a real folder; tc never follows it, so nothing "
                   f"was read or written there", EXIT_REFUSED)
        if not stat.S_ISDIR(st.st_mode):
            refuse(f"tc: {path} is not a folder; nothing was read or written there", EXIT_REFUSED)
        found.append(st)
    box_st, read_st = (found + [None, None])[:2]
    if shared and box_st is not None:
        card = CARDS / f"{name}.json"
        try:
            card_uid = os.lstat(card).st_uid
        except FileNotFoundError:
            card_uid = None
        for path, st in ((box, box_st), (box / "read", read_st)):
            if card_uid is not None and st is not None and st.st_uid != card_uid:
                refuse(f"tc: {path} belongs to {user_name(st.st_uid)}, but its card {card} belongs to "
                       f"{user_name(card_uid)}; under a shared mailbox an inbox belongs to the owner of "
                       f"its card, and tc never guesses which one is right. Nothing was read or written "
                       f"there.", EXIT_REFUSED)
    return box_st, read_st


# SHARED fix round 1 (Claude Opus 5.5, unreviewed): D20 item 1, tc join makes the inbox.
def claim_inbox(name):
    """Under a shared mailbox, make mail/to-<name>/ and its read/ as this user, the recipient (D20 item 1); refuse a name another user holds.

    tc join calls it before it writes anything. Refused (exit 1, words,
    nothing made or written): a card at cards/<name>.json that another
    user owns (under the sticky cards/ only its owner can replace it), or
    an inbox or read/ there that another user owns. An inbox this user
    already owns is kept as it is, and a missing read/ is made. A folder
    made here gets group g and SHARED_INBOX_MODE (make_folder).

    SHARED fix round 2 (Claude Opus 5.5, unreviewed): the audit's LOW-1.
    Two joins of one unclaimed name at once cannot both claim it. The
    inbox is made first, then read/, each by an mkdir as this user (which
    only one process can win), and after each the owner of what is there
    is looked at: a folder another user owns is refused with the same
    words, so the loser stops before it makes anything inside the
    winner's inbox.

    @interacts  lstats cards/<name>.json, mail/to-<name> and its read/
                (check_inbox); reads this process's user id and the user
                database; makes the missing folders (make_folder) and
                lstats each after; on a refusal one line to stderr and
                exit 1.
    @deps       check_inbox, make_folder, refuse, user_name; os; MAIL,
                CARDS, EXIT_REFUSED.
    @complexity O(1): five lstat calls and at most two new folders.
    @alloc      the stat results, freed on return.
    """
    me = os.geteuid()
    card = CARDS / f"{name}.json"
    try:
        owner = os.lstat(card).st_uid
    except FileNotFoundError:
        owner = me
    if owner != me:
        refuse(f"tc join: {card} belongs to {user_name(owner)}; under a shared mailbox only its owner "
               f"can replace it. No card written; pick another name, or ask {user_name(owner)}.",
               EXIT_REFUSED)

    def refuse_taken(path, uid):
        refuse(f"tc join: {path} belongs to {user_name(uid)}; under a shared mailbox an inbox "
               f"belongs to its recipient, so {name} is taken here. No card written; pick another "
               f"name, or ask {user_name(uid)}.", EXIT_REFUSED)
    box = MAIL / f"to-{name}"
    box_st, read_st = check_inbox(name, False)
    for path, st in ((box, box_st), (box / "read", read_st)):
        if st is not None and st.st_uid != me:
            refuse_taken(path, st.st_uid)
    for path in (box, box / "read"):  # SHARED fix round 2 (Claude Opus 5.5, unreviewed): LOW-1, make, then look
        make_folder(path)
        owner = os.lstat(path).st_uid
        if owner != me:
            refuse_taken(path, owner)


# SHARED D21 (Claude Opus 5.5, unreviewed): .shared belongs to the user who ran init.
def marker_other_owner(marker):
    """The login name of the user who owns the .shared at `marker` when that is another user, else None.

    None when this user owns it, and when nothing at `marker` can be
    lstat()ed (gone, or out of reach), since there is no owner to name.
    A link is lstat()ed, never followed: its own owner is the one named.

    @interacts  lstats `marker`; reads the user database when another
                user owns it.
    @deps       user_name; os.
    @complexity O(1): one lstat and at most one user lookup.
    @alloc      one string or none, returned.
    """
    try:
        owner = os.lstat(marker).st_uid
    except OSError:
        return None
    return None if owner == os.geteuid() else user_name(owner)


def settle_marker_mode(marker, root_fd):
    """Set the .shared at `marker` to SHARED_MARKER_MODE when this user owns it at another mode (D21); name another user's group- or world-writable one.

    For init's rerun with the group .shared already names, so a .shared
    written before D21 (0664) is made owner-write only by its owner. It
    is opened with O_NOFOLLOW and O_NONBLOCK and changed through that
    descriptor, never through a link. Another user's .shared is left as
    it is; when the group or anyone else may write it, one line on
    stderr says so and names whose rerun tightens it, and init's exit
    code is not changed by it. Anything that is not a regular file is
    left alone. A change that fails is refused (exit 1, words); the rest
    of init is done by then. SHARED fix round 8 (Claude Opus 5.5,
    unreviewed): the audit's HIGH-1. It is opened by its name in ROOT's
    descriptor, `root_fd` (pin_root), never by the path `marker`, which
    names it in the words only.

    @interacts  opens .shared by its name in `root_fd` and fstats it and,
                when it is this user's at another mode, fchmods it; for
                another user's writable one reads the user database and
                writes one line to stderr; on a failure one line to
                stderr and exit 1.
    @deps       refuse, user_name; os, stat, sys; SHARED_MARKER_NAME,
                SHARED_MARKER_MODE, EXIT_REFUSED.
    @complexity O(1).
    @alloc      one descriptor, closed before return.
    """
    try:
        fd = os.open(SHARED_MARKER_NAME, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=root_fd)
        try:
            st = os.fstat(fd)
            mode = stat.S_IMODE(st.st_mode)
            if stat.S_ISREG(st.st_mode) and mode != SHARED_MARKER_MODE:
                if st.st_uid == os.geteuid():
                    os.fchmod(fd, SHARED_MARKER_MODE)
                elif mode & (stat.S_IWGRP | stat.S_IWOTH):
                    print(f"tc init: {marker} is {mode:04o}; ask {user_name(st.st_uid)} to rerun init to "
                          f"tighten it", file=sys.stderr)
        finally:
            os.close(fd)
    except OSError as err:
        refuse(f"tc init: could not set {marker} to mode {SHARED_MARKER_MODE:04o} ({err.strerror}); "
               f"run tc init again, or set it by hand", EXIT_REFUSED)


# SHARED fix round 5 (Claude Opus 5.5, unreviewed): D28. What init's walk
# refuses: its words, and, on the init user's ROOT (ROOT and its .shared
# both one other user's), that user's id as the one who ran init, else
# None. When it is there, refuse_walk fixes this user's own entries (SHARED
# fix round 6, Claude Opus 5.5, unreviewed: D29). SHARED fix round 8
# (Claude Opus 5.5, unreviewed): the audit's HIGH-1. root_walk_problem
# always returns one: words None when the walk found nothing to refuse,
# and root, the lstat result of the folder the walk judged as ROOT (None
# when ROOT is not there yet), which pin_root checks ROOT's descriptor
# against.
WalkProblem = collections.namedtuple("WalkProblem", "words ran_init root", defaults=(None,))


# SHARED fix round 3 (Claude Opus 5.5, unreviewed): D21 and D23, nobody
# can swap ROOT (the audit's MEDIUM-2 and LOW-1).
def swap_words(path, st, is_root, marker_owner=None):
    """A WalkProblem when the folder or link at `path` (its lstat result `st`) would let a member swap ROOT, else None.

    Safe: root (SUPERUSER_UID) or this user owns it, and neither its group
    nor anyone else may write it. Above ROOT, a folder anyone may write is
    safe when it is sticky (/tmp): there only an entry's owner may rename
    the entry. ROOT itself (`is_root`) has no sticky exception (C4, the
    audit's LOW-1): in a writable ROOT a member could make .shared or
    mail/ before the first init. A link on the path as given is judged by
    its owner alone: a link's own mode means nothing, and where it leads
    is on the real path's walk. The words name the entry, its owner and
    its mode.

    SHARED fix round 5 (Claude Opus 5.5, unreviewed): D28 and the audit's
    MEDIUM-1 (audits/2026-10-15-0201-quick). Round 4's trust in the owner
    of .shared is taken back: whoever makes a folder can make the .shared
    in it, so that trust certified itself, and a member who made ROOT
    first passed the init user's own first init. `marker_owner`, the user
    id of ROOT/.shared's owner (root_walk_problem), now changes the words
    only. When ROOT itself belongs to that user, the words name them as
    the one who ran init and accuse no one, and the WalkProblem carries
    their id (ran_init). SHARED fix round 6 (Claude Opus 5.5,
    unreviewed): D29. Those words end there; refuse_walk says what
    happens next (it fixes this user's own entries) and how it ended.

    @interacts  reads this process's user id and the user database.
                Writes nothing.
    @deps       user_name, WalkProblem; os, stat; ROOT, SUPERUSER_UID.
    @complexity O(1).
    @alloc      one WalkProblem or none, returned.
    """
    mode = stat.S_IMODE(st.st_mode)
    owner = user_name(st.st_uid)
    if st.st_uid not in (SUPERUSER_UID, os.geteuid()):
        if is_root and st.st_uid == marker_owner:  # SHARED fix round 5 (Claude Opus 5.5, unreviewed): D28, no charge
            return WalkProblem(f"tc init: {path} and its .shared belong to {owner}, who ran init on this "
                               f"mailbox, so only {owner} runs init on it.", st.st_uid)  # SHARED fix round 6 (Claude Opus 5.5, unreviewed): D29
        return WalkProblem(f"tc init: {path} belongs to {owner} (mode {mode:04o}), who is neither root nor you, "
                           f"so {owner} could put a ROOT of their own, with their own .shared, in place of {ROOT} "
                           f"and change the group. Keep the mailbox under folders only root or you own. Nothing "
                           f"changed.", None)
    if stat.S_ISLNK(st.st_mode) or not mode & (stat.S_IWGRP | stat.S_IWOTH):
        return None
    if is_root:
        return WalkProblem(f"tc init: {ROOT} is {mode:04o}: its group or anyone may write it, so any member could "
                           f"rename .shared or mail/ in it, or make them before init, and change the group. Its "
                           f"owner, {owner}, runs chmod g-w,o-w {ROOT} first. Nothing changed.", None)
    if mode & stat.S_ISVTX:
        return None
    return WalkProblem(f"tc init: {path}, on the way to {ROOT}, is {mode:04o} and owned by {owner}: its group or "
                       f"anyone may write it and it is not sticky, so any member could rename the entry in it "
                       f"that leads to {ROOT} and put their own, with their own .shared, in its place. Its owner, "
                       f"{owner}, runs chmod g-w,o-w {path} first, or the mailbox moves. Nothing changed.", None)


def root_walk_problem():
    """A WalkProblem: its words name the first entry from ROOT up to / that would let a member swap ROOT (swap_words), or are None; its root is the folder the walk judged as ROOT.

    C4's "Nobody can swap ROOT" (D21, D23); ssh's StrictModes test for
    authorized_keys paths is the model. Two walks, each from ROOT up to
    /: the path as given (made absolute, never normalized, so .. and each
    link resolve as the kernel resolves them) and its real path
    (os.path.realpath). So a link on the way is checked, and so is every
    folder it leads through. Each entry is lstat()ed, never followed, and
    looked at once. One that is not there yet is skipped: init makes it
    at ROOT_MODE and walks again. One lstat cannot reach is refused with
    words on search access.

    SHARED fix round 4 (Claude Opus 5.5, unreviewed): the audit's LOW-2.
    An entry counts as looked at by its path and by whether it is ROOT,
    so when the given walk passed ROOT's real path as a folder above ROOT
    (TC_ROOT a link to its own parent), the real walk still runs the ROOT
    rule on it.

    SHARED fix round 5 (Claude Opus 5.5, unreviewed): D28. Only root and
    this user pass, as in round 3. The owner of ROOT/.shared, when it is
    a regular file (the only kind shared_group reads), is read for the
    words alone (swap_words' `marker_owner`): it gets no trust.

    SHARED fix round 8 (Claude Opus 5.5, unreviewed): the audit's HIGH-1
    (audits/2026-10-15-0840-quick). The walk's verdict always comes back,
    words None when it found nothing to refuse, and with it `root`: the
    lstat result of the first folder either walk found at ROOT's own
    place (the path as given, or its real path when ROOT is reached
    through a link), so pin_root can check the folder it opens against
    the one judged here. On a member's rerun whose ROOT as given is the
    init user's own link, the walk stops at that link, so `root` is the
    lstat of the real path it leads to, and pin_root checks that folder's
    owner too. None when ROOT is not there yet.

    @interacts  lstats ROOT/.shared, then each entry on both walks
                (os.path.realpath reads the links), and ROOT's real path
                once more when the walk stopped at the init user's link;
                reads this process's user id and the user database for
                the words. Writes nothing.
    @deps       swap_words, WalkProblem; os, pathlib, stat; ROOT,
                SHARED_MARKER_NAME.
    @complexity O(d) over d entries from ROOT up to / on the two walks
                (about ten each).
    @alloc      the two lists of paths and the set of those seen, freed on
                return; one WalkProblem, returned.
    """
    try:  # SHARED fix round 5 (Claude Opus 5.5, unreviewed): D28, who ran init, for the words only
        marker = os.lstat(ROOT / SHARED_MARKER_NAME)
        marker_owner = marker.st_uid if stat.S_ISREG(marker.st_mode) else None
    except OSError:
        marker_owner = None
    given = ROOT.absolute()
    real = pathlib.Path(os.path.realpath(given))
    seen, root = set(), None
    for walk in ([given, *given.parents], [real, *real.parents]):
        for at, path in enumerate(walk):
            if (path, at == 0) in seen:  # SHARED fix round 4 (Claude Opus 5.5, unreviewed): LOW-2, ROOT's rule always runs
                continue
            seen.add((path, at == 0))
            try:
                st = os.lstat(path)
            except FileNotFoundError:
                continue
            except OSError as err:
                return WalkProblem(f"tc init: cannot look at {path} ({err.strerror}); this user needs search (x) "
                                   f"access on every folder from / down to {ROOT}. Nothing changed.", None)
            if at == 0 and root is None and stat.S_ISDIR(st.st_mode):
                root = st  # SHARED fix round 8 (Claude Opus 5.5, unreviewed): HIGH-1, the folder judged as ROOT
            problem = swap_words(path, st, at == 0, marker_owner)
            if problem is not None:
                if root is None and problem.ran_init is not None:  # stopped at the init user's link: where it leads
                    try:
                        root = os.lstat(real)
                    except OSError:
                        pass
                return problem._replace(root=root)
    return WalkProblem(None, None, root)


# SHARED fix round 8 (Claude Opus 5.5, unreviewed): the audit's HIGH-1
# (audits/2026-10-15-0840-quick), ROOT pinned by identity.
def pin_root(judged, lead, owner=None):
    """ROOT's descriptor, opened once by its path with ROOT_FLAGS and kept only when fstat finds the folder init's walk judged (`judged`, its lstat result) and, given `owner`, that user's own; else refuse, exit 1, `lead` then why.

    The one name init resolves after its walk: every name it changes from
    then on is opened by that name in its own folder's descriptor, from
    this one down (walk_pinned, settle_marker_mode, .shared's write), so a
    ROOT, or a folder above it, renamed or swapped for a link after the
    walk looked at it cannot lead init anywhere else. A member's rerun
    passes the user who ran init as `owner`, so the folder it fixes under
    is that user's, as the walk judged. When ROOT is not that folder, or
    not there, the words are ROOT_CHANGED_WORDS; when it will not open,
    its error's. Nothing has changed by then.

    @interacts  opens ROOT by its path and fstats it; closes it again
                unless it is returned; on a refusal one line to stderr
                and exit 1.
    @deps       refuse; os, errno; ROOT, ROOT_FLAGS, ROOT_CHANGED_WORDS,
                EXIT_REFUSED.
    @complexity O(1).
    @alloc      one descriptor, returned (the caller closes it), or closed
                before the refusal.
    """
    changed = f"{lead}{ROOT_CHANGED_WORDS.format(root=ROOT)}"
    try:
        fd = os.open(ROOT, ROOT_FLAGS)
    except OSError as err:
        moved = err.errno in (errno.ENOENT, errno.ENOTDIR, errno.ELOOP)
        refuse(changed if moved else f"{lead}could not open {ROOT} ({err.strerror}). Nothing changed.", EXIT_REFUSED)
    try:
        st = os.fstat(fd)
        if judged is not None and os.path.samestat(judged, st) and owner in (None, st.st_uid):
            return fd
    except BaseException:
        os.close(fd)
        raise
