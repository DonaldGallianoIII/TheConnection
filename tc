# SHARED fix round 2 (Claude Opus 5.5, unreviewed): D20, a held lock makes a
# command fail, never hang it.
class LockWaitOver(Exception):
    """Raised inside flock_within by its timer while the flock is still waited for."""


# SHARED fix round 3 (Claude Opus 5.5, unreviewed): the audit's LOW-2, one deadline per command.
def lock_deadline():
    """When a command stops waiting for mail/.seq and its inbox lock, on time.monotonic(): now plus LOCK_WAIT_SECONDS.

    A command takes it once, before its first lock, and hands it to each
    flock_within after (inbox_lock, then next_seq on every publish try), so
    all its waits together stay within LOCK_WAIT_SECONDS (C4, D23).

    @interacts  reads the monotonic clock.
    @deps       time; LOCK_WAIT_SECONDS.
    @complexity O(1).
    @alloc      none.
    """
    return time.monotonic() + LOCK_WAIT_SECONDS


def flock_within(f, how, deadline=None):
    """Take the flock `how` on the open file `f`, waiting no later than `deadline` (from lock_deadline; None means LOCK_WAIT_SECONDS from now). True once held; False when the time ran out, with nothing held.

    D20: mail/.seq, the inbox locks and the ring marker are 0664, so any
    group member may open one and hold its flock as long as it likes, and
    a plain flock would wait forever. Here the wait still sits in the
    kernel's queue, as a plain flock does, so the lock is taken the moment
    its holder lets go (and /proc/locks shows this process waiting), but a
    one-shot real-time timer (setitimer, SIGALRM) cuts the wait off at the
    deadline. The timer is cancelled and the old SIGALRM handler
    put back before this returns, whatever happens. A timer that fires
    just as the flock is granted counts as the time running out: the lock
    is let go and False returned, so the caller refuses with nothing
    written. Signal handlers belong to the main thread, so this runs only
    there (tc is one thread).

    SHARED fix round 3 (Claude Opus 5.5, unreviewed): the audit's LOW-2.
    A command passes its one deadline to every wait, so the waits add up
    to LOCK_WAIT_SECONDS at most. A deadline already past still takes a
    lock nobody holds (one LOCK_NB try, no timer), so a command whose
    earlier waits used its time is refused only while the lock is held.

    @interacts  sets this process's SIGALRM handler and arms a one-shot
                real-time timer for the wait, then puts the old handler
                back and cancels the timer (one armed before the call is
                cancelled, not restored); takes the flock on `f`, or lets
                it go when the time ran out. Reads the monotonic clock.
    @deps       fcntl, signal, time; lock_deadline, LockWaitOver.
    @complexity O(1), plus waiting until `deadline` at most: at most
                LOCK_WAIT_SECONDS after the command's lock_deadline call.
    @alloc      one closure, freed on return.
    """
    left = (lock_deadline() if deadline is None else deadline) - time.monotonic()
    if left <= 0:  # SHARED fix round 3 (Claude Opus 5.5, unreviewed): time used up; a free lock is still taken
        try:
            fcntl.flock(f, how | fcntl.LOCK_NB)
        except BlockingIOError:
            return False
        return True
    waiting = True

    def ran_out(signum, frame):
        if waiting:
            raise LockWaitOver()

    previous = signal.signal(signal.SIGALRM, ran_out)
    try:
        try:
            signal.setitimer(signal.ITIMER_REAL, left)
            fcntl.flock(f, how)
            waiting = False
        finally:
            signal.setitimer(signal.ITIMER_REAL, 0)
    except LockWaitOver:
        fcntl.flock(f, fcntl.LOCK_UN)  # granted just as the timer fired: let it go
        return False
    finally:
        signal.signal(signal.SIGALRM, signal.SIG_DFL if previous is None else previous)
    return True


def next_seq(deadline=None):
    """The next message number: mail/.seq read, raised by one and written back under its flock.

    @interacts  reads ROOT/.shared and makes mail/ when missing
                (make_folder); opens mail/.seq through open_by_name,
                creating it when missing and refusing a symlink or a FIFO
                there (exit 1, D17, D19), and holds its flock while it
                reads and rewrites the number. SHARED fix round 2 (Claude
                Opus 5.5, unreviewed): waits for the flock no later than
                `deadline`, the command's lock_deadline (flock_within;
                None: LOCK_WAIT_SECONDS from now, SHARED fix round 3),
                then refuses, exit 10 (EXIT_BUSY, D23), `tc: another
                process is holding <ROOT>/mail/.seq's lock; try again`,
                with nothing written (D20).
    @deps       make_folder, open_by_name, flock_within, refuse; fcntl, os;
                LOCK_HELD_WORDS, EXIT_BUSY.
    @complexity O(1), plus waiting until `deadline` at most.
    @alloc      one open file, closed on return.
    """
    make_folder(MAIL)  # SHARED H1 (Claude Opus 5.5, unreviewed): D16
    with open(open_by_name(SEQ_FILE, os.O_RDWR | os.O_APPEND), "a+") as f:  # SHARED D17 (Claude Opus 5.5, unreviewed)
        if not flock_within(f, fcntl.LOCK_EX, deadline):  # SHARED fix round 2 (Claude Opus 5.5, unreviewed): D20
            refuse(f"tc: {LOCK_HELD_WORDS.format(what=SEQ_FILE)}; try again", EXIT_BUSY)  # SHARED fix round 3 (Claude Opus 5.5, unreviewed): D23
        f.seek(0)
        n = int(f.read().strip() or 0) + 1
        f.seek(0)
        f.truncate()
        f.write(str(n))
    return n


# CARDS fix round 1 (Claude Opus 5.5, unreviewed): the inbox lock (D14), for send, read and card.
@contextlib.contextmanager
def inbox_lock(name, how=fcntl.LOCK_EX, deadline=None):
    """Hold mail/.box-<name>.lock (flock) for the `with` block.

    One lock per inbox. Held alone (LOCK_EX) by the codex route from its
    unread count to its ring marker, by `tc read` from its glob to its
    last rename, by `tc card` from its unread count to its card's rename,
    and by `tc join` for a codex card from its card's rename to its ring
    marker (D16). A local send holds it shared (LOCK_SH) from its card read
    to the link that publishes its message: local senders never queue
    behind each other, only
    behind those four. So a send never lands between a reader's glob and
    its renames (the lost wake, D14), and never lands in an inbox after a
    `tc card` for that name counted it, where it would never be read once
    the card says ssh. Nothing slow runs under it: the codex ring waits
    until it is released, and `tc read` prints after it is released, so a
    reader stalled on its stdout never blocks a send.

    SHARED fix round 2 (Claude Opus 5.5, unreviewed): D20. The lock file
    is 0664 under a shared mailbox, so any member may hold its flock on
    purpose. The wait is bounded (flock_within): past `deadline` the
    command refuses, exit 10 (EXIT_BUSY, D23, SHARED fix round 3), `tc:
    another process is holding <name>'s lock; try again`, before the block
    runs, so nothing is written. Send, read, card, a codex join and the
    codex route all come through here. `deadline` is the command's
    lock_deadline, which a send passes on to next_seq (one deadline per
    command); None means LOCK_WAIT_SECONDS from now.

    @interacts  reads ROOT/.shared and makes mail/ (make_folder, D16);
                opens mail/.box-<name>.lock through open_by_name, creating
                it empty (append mode, so it never truncates what is there)
                and refusing a symlink or a FIFO there (exit 1, D17, D19),
                and holds the flock until the block ends; the kernel drops
                it if the process dies. Waits for it no later than
                `deadline`, then writes one line to stderr and exits 10.
    @deps       make_folder, open_by_name, flock_within, refuse;
                contextlib, fcntl, os; LOCK_HELD_WORDS, EXIT_BUSY.
    @complexity O(1), plus waiting until `deadline` at most.
    @alloc      one open file for the block; mail/.box-<name>.lock, made on
                first use and kept (nothing removes it).
    """
    make_folder(MAIL)  # SHARED H1 (Claude Opus 5.5, unreviewed): D16
    with open(open_by_name(MAIL / f".box-{name}.lock", os.O_WRONLY | os.O_APPEND), "a") as lock:  # SHARED D17 (Claude Opus 5.5, unreviewed)
        if not flock_within(lock, how, deadline):  # SHARED fix round 2 (Claude Opus 5.5, unreviewed): D20
            refuse(f"tc: {LOCK_HELD_WORDS.format(what=name)}; try again", EXIT_BUSY)  # SHARED fix round 3 (Claude Opus 5.5, unreviewed): D23
        yield


