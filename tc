def keepalive_seconds():
    margin = min(KEEPALIVE_MARGIN_SECONDS, CACHE_TTL_SECONDS * KEEPALIVE_MARGIN_MAX_FRACTION)
    return max(MIN_KEEPALIVE_SECONDS, CACHE_TTL_SECONDS - margin)


# CARDS R1 (Claude Opus 5.5, unreviewed): the one name check, contract C0.
def valid_name(name):
    """True when `name` may be a mailbox name under C0.

    1 to NAME_MAX_CHARS of letters, digits, dot, dash and underscore, no
    leading dash, not only dots. fullmatch, so a trailing newline fails.

    @interacts  none; string work only.
    @deps       re (NAME_PATTERN).
    @complexity O(c) over c characters in `name`, at most NAME_MAX_CHARS
                before the pattern stops matching.
    @alloc      the stripped copy for the dots check, freed on return.
    """
    return (isinstance(name, str) and NAME_PATTERN.fullmatch(name) is not None
            and name.strip(".") != "")


def require_names(*names):
    """Exit EXIT_BAD_NAME, with C0's words on stderr, at the first bad name.

    None is skipped (an optional name not given). Every command calls this
    before it touches the disk, so a bad name writes nothing.

    @interacts  writes one line to stderr and exits on a bad name; else none.
    @deps       valid_name, sys.
    @complexity O(n * c) over n names given (one to three) of c characters.
    @alloc      the message string on a bad name.
    """
    for name in names:
        if name is not None and not valid_name(name):
            print(f'tc: bad name "{name}": letters, digits, dot, dash, underscore, '
                  f'1 to {NAME_MAX_CHARS}, not starting with a dash', file=sys.stderr)
            sys.exit(EXIT_BAD_NAME)


# ---------- shared mailbox: one group of Linux users, one mailbox (C4) ----------
# SHARED H1 (Claude Opus 5.5, unreviewed): .shared, the umask, init, and the
# one helper every folder tc makes goes through (D16).

def shared_group():
    """The group named in ROOT/.shared, or None when the mailbox is private (no .shared).

    Raises ValueError, with words naming the file, when .shared is there
    but read_regular_file will not read it (a symlink, a FIFO, anything
    but a regular file, over SHARED_MARKER_READ_MAX_BYTES, not UTF-8), or
    when it names no group on one line. tc never guesses which group a
    mailbox is shared with: main() refuses every command but init on it
    (set_shared_umask), and an in-process caller sees the ValueError.

    @interacts  reads ROOT/.shared through read_regular_file. Writes
                nothing.
    @deps       read_regular_file; SHARED_MARKER_NAME,
                SHARED_MARKER_READ_MAX_BYTES.
    @complexity O(r) over r bytes read, at most
                SHARED_MARKER_READ_MAX_BYTES + 1.
    @alloc      the file's text and the group string, which is returned.
    """
    path = ROOT / SHARED_MARKER_NAME
    try:
        text = read_regular_file(path, SHARED_MARKER_READ_MAX_BYTES)
    except FileNotFoundError:
        return None
    except (OSError, ValueError) as err:
        raise ValueError(f"{path} is unreadable ({err})") from err
    group = text.strip()
    if not group or "\n" in group:
        raise ValueError(f"{path} names no group on one line")
    return group


# SHARED fix round 1 (Claude Opus 5.5, unreviewed): the audit's LOW-7.
def shared_problem_words(problem):
    """The refusal for a .shared that shared_group would not read (`problem`, its ValueError): what to check, by cause.

    A permission error is not the file's fault: this user cannot search a
    folder above ROOT (a home folder at 0750) or read .shared, and init
    cannot fix that, so the words say what access is needed. Anything else
    (a link, a FIFO, too big, not UTF-8, no group on one line) is the
    file's, and init rewrites it.

    @interacts  none; string work only.
    @deps       ROOT, SHARED_MARKER_NAME.
    @complexity O(1).
    @alloc      one string, returned.
    """
    if isinstance(problem.__cause__, PermissionError):
        return (f"tc: cannot read {ROOT / SHARED_MARKER_NAME} ({problem.__cause__.strerror}); this user "
                f"needs search (x) access on every folder from / down to {ROOT}, and read access to "
                f".shared. Nothing done.")
    return f"tc: {problem}; nothing done. Run tc init --shared --group <g> to rewrite it."


def set_shared_umask(fn):
    """Set SHARED_UMASK when ROOT/.shared names a group, before the command `fn` writes anything (C4).

    main() calls it ahead of the command, so every lock it makes is
    group-writable. An unreadable .shared refuses every command (exit 1,
    nothing written, shared_problem_words) except init, which rewrites
    it.

    @interacts  reads ROOT/.shared (shared_group); sets this process's
                umask, or writes one line to stderr and exits.
    @deps       shared_group, shared_problem_words, refuse, cmd_init; os;
                SHARED_UMASK.
    @complexity O(1): one small file.
    @alloc      none past the read.
    """
    try:
        group = shared_group()
    except ValueError as problem:
        if fn is cmd_init:
            return
        refuse(shared_problem_words(problem), EXIT_REFUSED)
    if group is not None:
        os.umask(SHARED_UMASK)


# SHARED fix round 1 (Claude Opus 5.5, unreviewed): D20, what a command
# needs to know about sharing, and whose a file is.
# A shared mailbox's group, by name and number. A private mailbox has none.
Share = collections.namedtuple("Share", "group gid")


def mailbox_share():
    """Share(group, gid) when ROOT/.shared names a group, None when the mailbox is private.

    Refuses (exit 1, words) a .shared that is unreadable or names a group
    this machine lacks: tc never guesses which group a mailbox is shared
    with, and nothing is written before the refusal.

    @interacts  reads ROOT/.shared (shared_group) and, when it names a
                group, the group database; on a refusal one line to stderr
                and exit 1.
    @deps       shared_group, shared_problem_words, refuse, printable; grp;
                SHARED_MARKER_NAME, EXIT_REFUSED.
    @complexity O(1): one small file and one group lookup.
    @alloc      one Share, returned.
    """
    try:
        group = shared_group()
    except ValueError as problem:
        refuse(shared_problem_words(problem), EXIT_REFUSED)
    if group is None:
        return None
    try:
        return Share(group, grp.getgrnam(group).gr_gid)
    except KeyError:
        refuse(f"tc: {ROOT / SHARED_MARKER_NAME} names group {printable(group)}, which this "
               f"machine does not have; nothing written", EXIT_REFUSED)


# SSH fix round 1 (Claude Opus 5.5, unreviewed): the audit's MEDIUM-2, a
# failure a caller turns into words or a warning, never an exit.
def share_or_raise():
    """mailbox_share, raising OSError with the words in its strerror where mailbox_share would refuse.

    For a caller that must never exit midway (the far gate filing an
    origin id after the message landed, the outbox after ssh answered):
    it catches OSError and says why.

    @interacts  reads ROOT/.shared (shared_group) and, when it names a
                group, the group database. Writes nothing.
    @deps       shared_group, shared_problem_words, printable; grp, errno;
                ROOT, SHARED_MARKER_NAME.
    @complexity O(1): one small file and one group lookup.
    @alloc      one Share, returned, or the words, raised.
    """
    try:
        group = shared_group()
    except ValueError as problem:
        raise OSError(errno.EINVAL, shared_problem_words(problem)) from problem
    if group is None:
        return None
    try:
        return Share(group, grp.getgrnam(group).gr_gid)
    except KeyError:
        raise OSError(errno.EINVAL, f"{ROOT / SHARED_MARKER_NAME} names group {printable(group)}, which this "
                                    f"machine does not have") from None


def user_name(uid):
    """The login name of user number `uid`, or the number as text when the machine has no such user.

    @interacts  reads the user database.
    @deps       pwd.
    @complexity O(1): one lookup.
    @alloc      one short string, returned.
    """
    try:
        return pwd.getpwuid(uid).pw_name
    except KeyError:
        return str(uid)


def group_name(gid):
    """The name of group number `gid`, or the number as text when the machine has no such group.

    @interacts  reads the group database.
    @deps       grp.
    @complexity O(1): one lookup.
    @alloc      one short string, returned.
    """
    try:
        return grp.getgrgid(gid).gr_name
    except KeyError:
        return str(gid)


def in_shared_folders(path):
    """True when `path` is mail/, status/, cards/ or outbox/ under ROOT, or anything inside one of them.

    @interacts  none; path work only.
    @deps       pathlib; ROOT, SHARED_FOLDER_NAMES.
    @complexity O(1): four comparisons.
    @alloc      the four paths compared, freed on return.
    """
    return any(path.is_relative_to(ROOT / name) for name in SHARED_FOLDER_NAMES)


def make_folder(path):
    """Make the folder `path`, and any missing folder above it. Every folder tc makes by its path is made here. The mailbox's Share, or None when private.

    P3 fix round 1a (Claude Opus 5.5, unreviewed): D35. A private
    mailbox's inbox and its read/ are made by name in their open parent
    instead (pin_folder), a plain mkdir, as this call makes them in a
    private mailbox; a shared one makes no inbox there (D20).

    A folder already there is left as it is. Under a shared mailbox (D16),
    each folder this call makes gets the group named in .shared and its
    mode from shared_folder_mode (the sticky SHARED_TOP_FOLDER_MODE for
    mail/, status/, cards/ and outbox/, D17; SHARED_INBOX_MODE for an
    inbox and its read/, D20) as it is made. Group and mode go through a
    descriptor opened with O_NOFOLLOW, so a link swapped in at the new
    name is refused, never changed. Raises FileExistsError when something
    that is not a folder holds the name, as Path.mkdir(exist_ok=True)
    does. Refuses (exit 1) when .shared is unreadable or names a group
    this machine lacks (mailbox_share, before anything is made).

    SHARED fix round 1 (Claude Opus 5.5, unreviewed): the audit's MEDIUM-4
    and LOW-13. A shared mailbox never ends up with a folder in the wrong
    group. When the new folder cannot be given the group and mode (a
    process outside the group, say), tc removes the empty folder it just
    made, its own runtime cleanup, and refuses with words. Under the four
    shared folders, a folder already there (`path` itself) that is not in
    the group, or is a symlink, is refused with words, never accepted.
    .shared and the group are resolved once per call, not once per level.
    The Share is returned, so a caller that makes its folder first knows
    the mailbox's mode without reading .shared again.

    SHARED fix round 6 (Claude Opus 5.5, unreviewed): D29. The refusal of
    a folder in the wrong group says its owner runs tc init --shared
    --group <g> (OWN_FIX_WORDS): on the init user's ROOT a member's init
    is refused and fixes that member's own entries through a no-follow
    open, and the init user's own init fixes theirs. Round 5 printed
    chgrp and chmod lines to paste instead, which follow a link.

    @interacts  reads ROOT/.shared and the group database (mailbox_share);
                lstats `path` (under the shared folders, shared) or stats
                it, and its missing parents; makes each missing folder;
                under a shared mailbox opens each new folder and sets its
                group and mode, or removes it again; on a refusal one line
                to stderr and exit 1.
    @deps       mailbox_share, make_folder_with, refuse.
    @complexity O(d) over d missing folders: at most three below ROOT
                (mail/, an inbox, its read/), plus ROOT and its missing
                parents on a first run against a new TC_ROOT (private
                only: a shared ROOT holds .shared). O(1) when `path` is
                there. One .shared read and one group lookup either way.
    @alloc      one descriptor per new folder under a shared mailbox,
                closed before return; the Share, returned.
    """
    share = mailbox_share()
    make_folder_with(path, share)
    return share


def make_folder_with(path, share, raising=False):
    """make_folder's work, with the mailbox's Share (or None) resolved once by the caller and passed down each level.

    SSH fix round 1 (Claude Opus 5.5, unreviewed): the audit's MEDIUM-2.
    `raising` True is the variant for a caller that must never exit
    midway: each refusal is raised as OSError, its words in strerror,
    for the caller's own try to turn into words or a warning. A folder
    whose mode is SHARED_BRANCH_MODE (an outbox branch and the folders in
    it, D33) is made at NEW_BRANCH_FOLDER_MODE, so no member can write in
    it before its mode is set.

    @interacts  see make_folder; with `raising`, raises OSError where it
                would refuse.
    @deps       in_shared_folders, shared_folder_mode, refuse, printable,
                user_name, group_name; os, stat, errno; OWN_FIX_WORDS,
                SHARED_BRANCH_MODE, NEW_BRANCH_FOLDER_MODE.
    @complexity O(d) over d missing folders, as make_folder.
    @alloc      one descriptor per new folder under a shared mailbox,
                closed before return.
    """
    def fail(words):
        if raising:
            raise OSError(errno.EPERM, words)
        refuse(f"tc: {words}", EXIT_REFUSED)

    if share is not None and in_shared_folders(path):
        try:
            st = os.lstat(path)
        except FileNotFoundError:
            st = None
        if st is not None:
            if stat.S_ISLNK(st.st_mode):
                fail(f"{path} is a symlink, not a real folder; tc never follows it, so nothing was written there")
            if not stat.S_ISDIR(st.st_mode):
                raise FileExistsError(errno.EEXIST, "not a folder", str(path))
