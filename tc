    if lines:
        refuse("\n".join(lines), EXIT_REFUSED)


# SHARED fix round 4 (Claude Opus 5.5, unreviewed): the audit's HIGH-1, a by-hand name always fits.
def by_hand_name(k, name, limit):
    """BY_HAND_NAME for count `k` and the inbox file's `name`, at most `limit` bytes as the filesystem stores it (os.fsencode).

    A name that fits is kept whole. Else its stem is cut from the end,
    one character at a time (never half a character), and its suffix
    (.md) is kept, so a planted name of any length up to the limit still
    gets a by-hand name the rename can make.

    SHARED fix round 5 (Claude Opus 5.5, unreviewed): the audit's LOW-2.
    The suffix is the name's own MESSAGE_SUFFIX ending, not
    os.path.splitext's, which gives a name of dots and `md` (`"." * 253 +
    "md"`) no suffix at all; the cut then took the `md`, and tc log never
    listed the moved file again. A name without that ending (none reach
    here: message_files takes only names that end in it) is cut from its
    end.

    @interacts  none; string work only.
    @deps       os; BY_HAND_NAME, MESSAGE_SUFFIX.
    @complexity O(c) over c characters of `name` (at most `limit`, 255 on
                ext4).
    @alloc      the cut stem and the name, returned.
    """
    suffix = MESSAGE_SUFFIX if name.endswith(MESSAGE_SUFFIX) else ""  # SHARED fix round 5 (Claude Opus 5.5, unreviewed): LOW-2
    stem = name[:len(name) - len(suffix)]
    room = limit - len(os.fsencode(BY_HAND_NAME.format(k=k, name=suffix)))
    kept = 0
    for c in stem:
        size = len(os.fsencode(c))
        if size > room:
            break
        room -= size
        kept += 1
    return BY_HAND_NAME.format(k=k, name=stem[:kept] + suffix)


# SHARED fix round 3 (Claude Opus 5.5, unreviewed): the audit's MEDIUM-1, tc read never replaces a file in read/.
def by_hand_target(path, read_fd):
    """Where tc read moves the inbox file at `path` when read/ already holds its name: read/BY_HAND_NAME, k the first count from 1 that nothing holds. `read_fd` is read/'s open descriptor.

    For cmd_read, under the inbox lock it holds alone. Each name is
    checked with lstat, never followed. SHARED fix round 4 (Claude Opus
    5.5, unreviewed): the audit's HIGH-1. Each name is cut to fit read/'s
    name limit (os.fpathconf PC_NAME_MAX, by_hand_name), and only
    FileNotFoundError makes a name free. Any other OSError (the name limit
    or a by-hand name tc cannot look at) is raised, never taken as free,
    so the search always ends and cmd_read names the file, left unread.
    P3 fix round 1a (Claude Opus 5.5, unreviewed): D35. read/ is the open
    one (pinned_inbox): the limit and each name are read in its
    descriptor, never by a path; the path returned names it in the words.

    @interacts  reads read/'s name limit (fpathconf); lstats
                by-hand-<k>-<name> by name in `read_fd` for k = 1, 2, ...
                until one is free. Writes nothing. Raises OSError as above.
    @deps       by_hand_name; os, pathlib.
    @complexity O(t * c) over t names by-hand-<k>-<name> already in read/
                (none in an honest mailbox; each one a file someone made by
                hand) and c characters of the name (by_hand_name).
    @alloc      one path per k tried; the free one, returned.
    """
    read = path.parent / "read"
    limit = os.fpathconf(read_fd, "PC_NAME_MAX")
    k = 1
    while True:
        target = read / by_hand_name(k, path.name, limit)
        try:
            os.lstat(target.name, dir_fd=read_fd)
        except FileNotFoundError:
            return target
        k += 1


# SHARED fix round 4 (Claude Opus 5.5, unreviewed): the audit's MEDIUM-1, owners as plain facts.
def owner_words(path, folder_fd):
    """` (owned by <login>)` for the entry named path.name in the folder open at `folder_fd`, lstat()ed, never followed; an empty string when lstat cannot reach it.

    P3 fix round 1a (Claude Opus 5.5, unreviewed): D35, by its name in
    the pinned read/, never by its path.

    @interacts  lstats one name in `folder_fd`; reads the user database.
    @deps       user_name, printable; os.
    @complexity O(1).
    @alloc      one short string, returned.
    """
    try:
        return f" (owned by {printable(user_name(os.lstat(path.name, dir_fd=folder_fd).st_uid))})"
    except OSError:
        return ""


# SHARED fix round 5 (Claude Opus 5.5, unreviewed): the audit's LOW-1, a rename that did nothing.
def still_in_inbox(path, target, box_fd, read_fd):
    """Words when the inbox file at `path` is still in the inbox after tc read renamed it to `target`; None when it left. `box_fd` and `read_fd` are the inbox's and read/'s open descriptors.

    rename(2) between two names of one file does nothing and returns 0.
    So a member who hard-links their own inbox file at `target`, between
    tc read's lstat of that name and its rename, keeps the file in the
    inbox while the rename reports success. lstat finds `path` gone: it
    moved. Still there as the same file as `target` (os.path.samestat),
    or with `target` gone: not moved. Still there as another file: the
    move was made and a new file took the name after it; the next read
    meets that one. P3 fix round 1a (Claude Opus 5.5, unreviewed): D35,
    each name lstat()ed in its pinned folder, never by its path.

    @interacts  lstats path.name in `box_fd` and, when it is still there,
                target.name in `read_fd`. Writes nothing. Raises OSError
                when lstat cannot reach either for any reason but absence.
    @deps       printable; os.
    @complexity O(1): at most two lstat calls.
    @alloc      one string or none, returned.
    """
    try:
        here = os.lstat(path.name, dir_fd=box_fd)
    except FileNotFoundError:
        return None
    try:
        if not os.path.samestat(here, os.lstat(target.name, dir_fd=read_fd)):
            return None
    except FileNotFoundError:
        pass
    return (f"it is still in the inbox after the move to {printable(target)}: a hard link to it, made there "
            f"just before, makes a move do nothing")


