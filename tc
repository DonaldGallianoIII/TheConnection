# ---------- router: tc send delivers by the recipient's card (C2) ----------
# CARDS R3 (Claude Opus 5.5, unreviewed). No hub (D7): the route comes from
# the recipient's card alone. Nothing here reads reports_to.

# What a route hands back to cmd_send: its exit code, the words to print
# (stdout on 0, else stderr), and warnings for stderr whatever the exit.
Delivery = collections.namedtuple("Delivery", "exit words warnings")


def read_card(name):
    """The card for `name` as a dict, or None when it has none.

    Raises ValueError, with words naming the file, for a card that is not
    a JSON object, including one nested too deep for the parser
    (RecursionError), and for one read_regular_file will not read (a
    FIFO, a symlink, anything but a regular file, one over
    CARD_READ_MAX_BYTES): the router refuses rather than guess a route.
    Only nothing at the name is no card.

    @interacts  reads cards/<name>.json through read_regular_file. Writes
                nothing.
    @deps       read_regular_file, CARD_READ_MAX_BYTES; json, pathlib.
    @complexity O(1): one small file.
    @alloc      one dict, returned.
    """
    path = CARDS / f"{name}.json"
    try:
        card = json.loads(read_regular_file(path, CARD_READ_MAX_BYTES))  # Phase fix round 1 (Claude Opus 5.5, unreviewed)
    except FileNotFoundError:
        return None
    except (OSError, ValueError, RecursionError) as err:  # Phase fix round 1 (Claude Opus 5.5, unreviewed)
        raise ValueError(f"the card {path} is unreadable ({err})") from err
    if not isinstance(card, dict):
        raise ValueError(f"the card {path} is not a JSON object")
    return card


# CARDS fix round 1 (Claude Opus 5.5, unreviewed): one place picks the route,
# so cmd_send can ask again under the inbox lock.
def card_route(to):
    """The card for `to` and the ROUTES function its route names. Refuses what it cannot route.

    No card is route local. Each refusal is words on stderr, exit 1,
    nothing written: a card that is not a JSON object, a card with no
    string route, and a route not in ROUTES (C2). The first two tell the
    sender who fixes the card: that name's owner, by rejoining in its own
    session, or the sender with `tc card` for a name on another machine.
    Never `tc join` run by the sender, which would write the sender's own
    identity into the card.

    @interacts  reads cards/<to>.json (read_card); on a refusal writes one
                line to stderr and exits.
    @deps       read_card, refuse, ROUTES, deliver_local, CARDS.
    @complexity O(1): one small file.
    @alloc      the card dict, returned.
    """
    fix = (f"Ask {to}'s owner to rejoin (tc join {to}, run in {to}'s own session), or, "
           f"if {to} lives on another machine, write its card with tc card {to} --ssh <target>.")
    try:
        card = read_card(to)
    except ValueError as problem:
        refuse(f"tc send: {problem}; nothing sent. {fix}", EXIT_REFUSED)
    if card is None:
        return None, deliver_local
    route = card.get("route")
    if not isinstance(route, str):
        refuse(f"tc send: the card {CARDS / f'{to}.json'} has no route; nothing sent. {fix}",
               EXIT_REFUSED)
    deliver = ROUTES.get(route)
    if deliver is None:
        refuse(f"tc send: route {route} is not built yet; nothing sent", EXIT_REFUSED)
    return card, deliver


def read_body(message):
    """The message body: `message` when given, else stdin. Over the limit exits 8.

    Reads at most SEND_BODY_MAX_BYTES + 1 bytes from stdin and decodes them
    as sys.stdin would, so the body is the same text today's send saw. A
    text argument is measured in the bytes it came in as. Runs before
    next_seq(), so a refusal uses no number (C0).

    @interacts  reads stdin when `message` is empty; on a body over the
                limit, writes SEND_TOO_LARGE_WORDS to stderr and exits.
    @deps       refuse; os, sys.
    @complexity O(b) over b bytes, at most SEND_BODY_MAX_BYTES + 1.
    @alloc      the raw bytes (up to SEND_BODY_MAX_BYTES + 1) and the
                decoded string, which is returned. A str stores every
                character at the width of its widest one, so one code point
                above U+FFFF makes it 4 bytes a character: at most about
                5 x SEND_BODY_MAX_BYTES at once (about 2 x when every
                character is below U+0100).
    """
    if message:
        if len(os.fsencode(message)) > SEND_BODY_MAX_BYTES:
            refuse(SEND_TOO_LARGE_WORDS, EXIT_TOO_LARGE)
        return message
    raw = sys.stdin.buffer.read(SEND_BODY_MAX_BYTES + 1)
    if len(raw) > SEND_BODY_MAX_BYTES:
        refuse(SEND_TOO_LARGE_WORDS, EXIT_TOO_LARGE)
    return raw.decode(sys.stdin.encoding, sys.stdin.errors)


def deliver_local(card, sender, to, body, header_note=None, *, deadline=None):
    """Route local: today's send. Seq under flock, write a new .tmp, link it into the inbox under a name nothing has.

    Warns `new inbox: nobody has joined as <to>` only when the inbox did
    not exist before this send and the name has no card (O1, D13): a card
    is the record of a join. It looks for cards/<to>.json on disk, not at
    `card`, because the gate (C3) calls this directly with no card in
    hand. `header_note`, when given, ends the header line after a comma
    (the gate's, C3). The .tmp is made by write_new_file: a file or link
    already at its name refuses the send (Delivery exit 1, words naming
    it, nothing written through it; the number is used). An inbox or
    read/ that is a symlink refuses it before a number is taken (exit 1,
    check_inbox, D17), and so does a symlink at mail/.seq (next_seq).

    SHARED fix round 2 (Claude Opus 5.5, unreviewed): D20, a send never
    replaces a message. The finished .tmp is hard-linked to the message's
    name (os.link fails on anything at that name, where a rename would
    replace it), then the .tmp's name is removed. A member may set the
    group-writable mail/.seq back, so the number's name may already hold
    unread mail in the inbox, or a read message in its read/ (where tc
    read would rename over it). Either way the send takes the next number
    and tries again, up to PUBLISH_MAX_TRIES, then refuses with words
    saying mail/.seq may have been set back. SHARED fix round 4 (Claude
    Opus 5.5, unreviewed): the audit's DEBT-3, dev exit row 10 amended.
    That refusal is Delivery exit 10 (EXIT_BUSY), not 1: each try moved
    mail/.seq on, so the next send starts past the taken names, and the
    ssh route keeps a far 10 queued where a 1 would file it as refused
    (C3). One code path, private or shared. A link that fails for any other reason refuses
    the send with words, never a traceback, and leaves no .tmp. SHARED fix
    round 3 (Claude Opus 5.5, unreviewed): the audit's LOW-3. On a
    filesystem without hard links (os.link fails with one of
    NO_HARD_LINK_ERRNOS) the words say so: tc needs them so a message
    never replaces another (D20). Delivery exit 1, nothing sent.

    SHARED fix round 3 (Claude Opus 5.5, unreviewed): the audit's LOW-2.
    Every next_seq of the publish loop waits no later than one deadline,
    so a send waits at most LOCK_WAIT_SECONDS in all for mail/.seq however
    many numbers it skips, then exits 10 (next_seq, D23). `deadline`, a
    keyword C2's route signature leaves out, is the command's
    lock_deadline when its caller took one before the inbox lock
    (cmd_send, deliver_codex); None takes one at the first number. A
    route call with C2's arguments alone works as before.

    SHARED fix round 1 (Claude Opus 5.5, unreviewed): under a shared
    mailbox (D20), before a number is taken: an inbox not owned by its
    card's owner refuses the send (exit 1, check_inbox, item 4); a name
    with no card is refused, Delivery exit 1, `tc send: nobody has joined
    as <to> on this shared mailbox`, and one with a card but no inbox is
    refused with words telling its owner to rejoin (item 3). SHARED D21
    (Claude Opus 5.5, unreviewed): the no-card refusal holds whether or
    not an inbox is there, so a card-less inbox (one a sender made before
    D20, or by hand) never takes mail. Nothing is made either way: only
    tc join makes an inbox, as its recipient, so no sender ever owns
    another's inbox. The message is made SHARED_OWNED_FILE_MODE (0640,
    item 2). O1's deliver plus warning stays for a private mailbox.

    @interacts  reads ROOT/.shared (mailbox_share); lstats mail/to-<to>,
                its read/ and, when shared, cards/<to>.json (check_inbox,
                then once more for the no-card refusal); takes the
                mail/.seq flock (next_seq, once per try, every try under
                one deadline; held past it, exit 10); private only:
                makes mail/to-<to>/read/; per try lstats
                read/NNNNNN-from-<sender>.md, creates
                NNNNNN-from-<sender>.tmp in mail/to-<to>/, links it to
                NNNNNN-from-<sender>.md there and removes the .tmp's name;
                stats cards/<to>.json. Every name taken: Delivery exit 10.
    @deps       mailbox_share, check_inbox, lock_deadline, next_seq, inbox,
                now_iso, write_new_file, Delivery; os; ROOT, CARDS,
                SEQ_WIDTH, SHARED_OWNED_FILE_MODE, NEW_FILE_MODE,
                PUBLISH_MAX_TRIES, NO_HARD_LINK_ERRNOS, EXIT_REFUSED,
                EXIT_BUSY.
    @complexity O(b) over b bytes of body, once per try: one try in an
                honest mailbox, at most PUBLISH_MAX_TRIES when mail/.seq
                was set back; plus waiting for mail/.seq until `deadline`
                at most, all tries together.
    @alloc      the message text while written; one message file, kept;
                one .tmp per try, removed before the next.
    """
    share = mailbox_share()  # SHARED fix round 1 (Claude Opus 5.5, unreviewed): D20
    box_st, _ = check_inbox(to, share is not None)  # SHARED D17 (Claude Opus 5.5, unreviewed): before a number is taken
    box_existed = box_st is not None
    if share is not None:  # SHARED fix round 1 (Claude Opus 5.5, unreviewed): D20 item 3
        if not os.path.lexists(CARDS / f"{to}.json"):  # SHARED D21 (Claude Opus 5.5, unreviewed): inbox or not
            return Delivery(EXIT_REFUSED, f"tc send: nobody has joined as {to} on this shared mailbox", [])
        if not box_existed:
            return Delivery(EXIT_REFUSED, f"tc send: {to} has a card but no inbox on this shared mailbox; "
                                          f"nothing sent. Ask {to}'s owner to rejoin (tc join {to}, run as "
                                          f"that Linux user), which makes the inbox.", [])
    if deadline is None:  # SHARED fix round 3 (Claude Opus 5.5, unreviewed): LOW-2, one deadline for every try
        deadline = lock_deadline()
    n = next_seq(deadline)
    box = MAIL / f"to-{to}" if share is not None else inbox(to, False)
    mode = SHARED_OWNED_FILE_MODE if share is not None else NEW_FILE_MODE  # SHARED fix round 1 (Claude Opus 5.5, unreviewed): D20 item 2
    warnings = []
    # SHARED fix round 2 (Claude Opus 5.5, unreviewed): D20, never over a message; a taken name takes the next number.
    for tries in range(PUBLISH_MAX_TRIES):
        if tries:
            n = next_seq(deadline)
        path = box / f"{n:0{SEQ_WIDTH}d}-from-{sender}.md"
        if os.path.lexists(box / "read" / path.name):
            continue  # a read message has this name, and tc read would rename over it
        tmp = path.with_suffix(".tmp")
        header = f"# #{n} from {sender} to {to}, {now_iso()}" + (f", {header_note}" if header_note else "")
        try:  # CARDS fix round 1 (Claude Opus 5.5, unreviewed): a planted link is refused
            write_new_file(tmp, f"{header}\n\n{body.rstrip()}\n", mode)
        except OSError as err:
            return Delivery(EXIT_REFUSED, f"tc send: could not create {tmp} ({err.strerror}); nothing sent", [])
        try:
            os.link(tmp, path)  # whole when it appears, and never replaces what has the name
            failed = None
        except OSError as err:
            failed = err
        try:
            tmp.unlink()  # this send's own .tmp, made just above; a linked message stays at path
        except OSError as err:
            warnings.append(f"tc send: could not remove {tmp} ({err.strerror})")
        if failed is None:
            break
        if failed.errno in NO_HARD_LINK_ERRNOS:  # SHARED fix round 3 (Claude Opus 5.5, unreviewed): LOW-3
            return Delivery(EXIT_REFUSED, f"tc send: the filesystem under {ROOT} has no hard links "
                                          f"({failed.strerror}), and tc needs them to publish a message without "
                                          f"ever replacing another (D20); nothing sent. Put the mailbox (TC_ROOT) "
                                          f"on a filesystem that has them, such as ext4.", warnings)
        if not isinstance(failed, FileExistsError):
            return Delivery(EXIT_REFUSED, f"tc send: could not publish {path} ({failed.strerror}); nothing sent",
                            warnings)
    else:  # SHARED fix round 4 (Claude Opus 5.5, unreviewed): DEBT-3, busy, not refused (dev exit row 10)
        return Delivery(EXIT_BUSY, f"tc send: {PUBLISH_MAX_TRIES} message numbers in a row were taken in "
                                      f"{box}, the last {path.name} (mail/.seq may have been set back); nothing "
                                      f"sent. Each try moved mail/.seq on, so the next send starts past them.",
                        warnings)
    joined = (CARDS / f"{to}.json").exists()  # CARDS fix round 1 (Claude Opus 5.5, unreviewed): D13
    if not (box_existed or joined):
        warnings.append(f"new inbox: nobody has joined as {to}")
    return Delivery(0, f"sent #{n} to {to}: {path}", warnings)


# Phase fix round 1 (Claude Opus 5.5, unreviewed): D16, the ring marker and
# the clock its backoff reads.
# What ring_codex hands back when a ring did not go through: why, in words,
# and whether codex ran past CODEX_RING_SECONDS (the one outcome that holds
# later rings back).
RingFailure = collections.namedtuple("RingFailure", "reason timed_out")


def wall_clock():
    """Seconds since the epoch, on the same scale as a file's st_mtime.

    The clock the ring backoff reads (D16), in a function of its own so a
    test replaces it and never sleeps RING_BACKOFF_SECONDS.

    @interacts  reads the system clock.
    @deps       time.
    @complexity O(1).
    @alloc      none.
    """
    return time.time()


def clock_words(seconds):
    """`seconds` since the epoch as the local time of day, HH:MM:SS (CLOCK_FORMAT).

    @interacts  reads the local time zone.
    @deps       datetime; CLOCK_FORMAT.
    @complexity O(1).
    @alloc      one short string, returned.
    """
    return datetime.datetime.fromtimestamp(seconds).strftime(CLOCK_FORMAT)


# SHARED fix round 1 (Claude Opus 5.5, unreviewed): D20 item 5, the
# marker's state lives in its contents; it is rewritten, never removed.
def write_ring_marker(name, state, detail):
    """Rewrite mail/.ring-pending-<name> in place: `state` on the first line, the time and `detail` on the second. None when written, else why, in words.

    D20 item 5: the marker is never removed or renamed over, only
    rewritten, so under a shared mailbox (sticky mail/, where only its
    owner could remove or replace it) every member can still set its
    state, and no .tmp is ever left behind. It is opened through
    open_regular: no link followed, a FIFO refused at once, made at
    NEW_FILE_MODE when missing (group-writable under SHARED_UMASK). Its
    own flock is held while it is truncated and written, so two writers
    never mix lines. A reader that catches it mid-rewrite sees it empty
    or cut short, which reads as owed: one more ring at worst.

    SHARED fix round 2 (Claude Opus 5.5, unreviewed): D20. The marker is
    0664 under a shared mailbox, so a member may hold its flock on
    purpose. The wait is bounded (flock_within): past LOCK_WAIT_SECONDS
    nothing is written and the words say another process is holding the
    marker's lock, which every caller already reports as a marker it
    could not write. SHARED fix round 3 (Claude Opus 5.5, unreviewed): the
    audit's LOW-7. With the lock held through a codex send, neither of its
    writes lands, so the marker keeps its old state. A ring that then
    succeeds may leave a pending state behind, and the next send rings
    once more. A ring that then fails leaves a `clear` marker clear, and
    the next send to the inbox, which is not empty, does not ring: one
    ring fewer, which the send's warning says (a later send may not
    ring). Either way the mail is in the inbox, never lost or altered.

    @interacts  opens mail/.ring-pending-<name> (making it when missing),
                waits at most LOCK_WAIT_SECONDS for its flock, then
                truncates and writes it.
    @deps       open_regular, flock_within, now_iso; fcntl, os; MAIL,
                LOCK_HELD_WORDS.
    @complexity O(d) over d characters of `detail`, plus at most
                LOCK_WAIT_SECONDS of waiting.
    @alloc      the text, freed on return; one descriptor, closed on
                return; the marker file, kept (never removed).
    """
    marker = MAIL / f".ring-pending-{name}"
    try:
        fd = open_regular(marker, os.O_WRONLY)
    except (OSError, ValueError) as err:
        return err.strerror if isinstance(err, OSError) and err.strerror else str(err)
    try:
        with open(fd, "w") as f:
            if not flock_within(f, fcntl.LOCK_EX):  # SHARED fix round 2 (Claude Opus 5.5, unreviewed): D20
                return LOCK_HELD_WORDS.format(what=marker)
            f.truncate(0)
            f.write(f"{state}\n{now_iso()} {detail}\n")
    except OSError as err:
        return err.strerror
    return None


def ring_marker_problem(marker):
    """Words when something that is not a regular file sits at the ring marker's name (D17, D19); None when it is one, or nothing is there.

    @interacts  lstats `marker`. Writes nothing.
    @deps       os, stat.
    @complexity O(1).
    @alloc      none.
    """
    try:
        mode = os.lstat(marker).st_mode
    except FileNotFoundError:
        return None
    if stat.S_ISLNK(mode):
        return "is a symlink, which tc never follows"
    if not stat.S_ISREG(mode):
        return "is not a regular file, which tc never opens"
    return None


def ring_owed(marker):
    """True when the marker says a ring is owed: there and not RING_CLEAR on its first line, or there and unreadable (D14, D20).

    Nothing at the name owes nothing. A marker read_regular_file will not
    read owes a ring, as D14 has it: the send rings rather than lose a
    wake.

    @interacts  reads `marker` through read_regular_file. Writes nothing.
    @deps       read_regular_file; RING_CLEAR, RING_MARKER_READ_MAX_BYTES.
    @complexity O(1): one short file.
    @alloc      the marker's text, freed on return.
    """
    try:
        state = read_regular_file(marker, RING_MARKER_READ_MAX_BYTES).partition("\n")[0]
    except FileNotFoundError:
        return False
    except (OSError, ValueError):
        return True
    return state != RING_CLEAR


def ring_backoff(marker):
    """When the last ring timed out under RING_BACKOFF_SECONDS ago: that time (the marker's mtime). Else None.

    Only a marker whose first line is RING_TIMED_OUT holds a ring back. Its
    time is the file's mtime, set when the timeout rewrote it, and its age
    is read on wall_clock(). A marker dated after now (the clock was set
    back) holds nothing, so a clock change cannot stop rings for long. A
    marker that cannot be read holds nothing either: the send rings, as
    D14 has it. It is read through read_regular_file, so a FIFO or a link
    at its name never blocks the send that holds the inbox lock.

    @interacts  reads (read_regular_file) and stats `marker`; reads the
                clock (wall_clock). Writes nothing.
    @deps       read_regular_file, wall_clock; RING_TIMED_OUT,
                RING_BACKOFF_SECONDS, RING_MARKER_READ_MAX_BYTES.
    @complexity O(1): one short file.
    @alloc      the marker's text, freed on return.
    """
    try:
        state = read_regular_file(marker, RING_MARKER_READ_MAX_BYTES).partition("\n")[0]
        stamp = marker.stat().st_mtime
    except (OSError, ValueError):
        return None
    if state == RING_TIMED_OUT and 0 <= wall_clock() - stamp < RING_BACKOFF_SECONDS:
        return stamp
    return None


# CARDS R4 (Claude Opus 5.5, unreviewed): the codex route, a doorbell (D3).
# CARDS fix round 1 (Claude Opus 5.5, unreviewed): D14, a failed ring is never lost.
# Phase fix round 1 (Claude Opus 5.5, unreviewed): D16, the marker before the
# ring, and the backoff after a timeout.
def deliver_codex(card, sender, to, body, header_note=None, *, deadline=None):
    """Route codex: deliver_local under the inbox lock, then ring the Codex thread when a wake is owed.

    A listener started inside Codex dies when its command returns (D3), so
    a Codex session is woken by `codex queue`, which hands its thread a
    line to act on when its turn ends or the session is resumed.

    Under mail/.box-<to>.lock, held alone (D14): count unread, read the
    marker mail/.ring-pending-<to>, deliver, and decide. A ring is owed
    when the inbox held no unread mail before this send (one ring per
    batch) or the marker says one is owed (ring_owed: there and not
    RING_CLEAR): an earlier ring failed, a sender died while it rang, or
    `tc join` found mail waiting (D16). The ring is held
    instead when the marker says the last ring timed out under
    RING_BACKOFF_SECONDS ago (D16): the marker is kept as it is, and the
    warning says when a send rings again. When a ring is owed, the marker
    is written (RING_RINGING) before the lock is released, so a sender
    killed mid-ring leaves it for the next send. So two quick sends to an
    empty inbox may both ring: the second finds the first one's marker.
    That is two doorbells and one read, harmless, and it is what keeps a
    wake from being lost; do not "fix" it back.

    The ring runs after the lock is released, so a slow ring never holds
    up `tc read`. A ring that exits 0 rewrites the marker as RING_CLEAR;
    it is never removed (D20 item 5, SHARED fix round 1, Claude Opus 5.5,
    unreviewed). A timeout
    rewrites it as RING_TIMED_OUT, which starts the backoff; every other
    failure rewrites it as RING_FAILED, and the next send rings again:
    codex exiting non-zero, codex missing, or a card whose thread_id is
    missing or not a thread id, which is never handed to codex. The mail
    is in the inbox either way, so the send still exits 0. A marker that
    cannot be written before the ring is not said on its own: if the ring
    then fails, the second write fails the same way and its warning says
    a later send may not ring.

    A symlink at the marker's name is refused (D17): Delivery exit 1,
    words, nothing sent and nothing rung, so no member can point the
    marker at a file another user's send would then replace or read. So
    is a FIFO or anything else that is not a regular file (D19).

    @interacts  holds mail/.box-<to>.lock while it lstats the marker,
                counts mail/to-<to>/*.md (before and after), reads and
                stats mail/.ring-pending-<to>, writes the message through
                deliver_local and, when a ring is owed, the marker
                (write_ring_marker). SHARED fix round 3 (Claude Opus 5.5,
                unreviewed): one lock_deadline, taken before the inbox
                lock and passed to deliver_local, bounds the inbox lock
                and mail/.seq together; either held past it by another
                process refuses, exit 10, nothing landed or rung
                (inbox_lock, next_seq, D20, D23). SHARED fix round 4
                (Claude Opus 5.5, unreviewed): the audit's LOW-3.
                `deadline`, a keyword C2's route signature leaves out
                (as deliver_local's), is the command's lock_deadline from
                cmd_send, so a local send whose card turned codex under
                its lock never waits two bounds; None takes one here, so
                a call with C2's arguments alone works as before. The marker's flock held
                past LOCK_WAIT_SECONDS skips that write, said as a marker
                that could not be written or cleared. Then rings through
                ring_codex (one `codex queue` run, at most
                CODEX_RING_SECONDS) and rewrites the marker: RING_CLEAR on
                exit 0, else the failure. Reads the clock through
                wall_clock.
    @deps       lock_deadline, inbox_lock, ring_marker_problem,
                unread_count, ring_owed, deliver_local, ring_backoff,
                write_ring_marker, ring_codex, clock_words, wall_clock,
                Delivery; RING_RINGING, RING_FAILED, RING_TIMED_OUT,
                RING_CLEAR, RING_BACKOFF_SECONDS, EXIT_REFUSED.
    @complexity O(u + b) over u unread messages (counted twice) and b
                bytes of body, plus one codex run of at most
                CODEX_RING_SECONDS; no run while a backoff holds. The inbox
                lock and mail/.seq wait at most LOCK_WAIT_SECONDS in all
                (one deadline); each marker write, before and after the
                ring, at most LOCK_WAIT_SECONDS of its own.
    @alloc      the ring's words, freed on return; one message file, kept;
                the marker file, kept (never removed, D20).
    """
    marker = MAIL / f".ring-pending-{to}"
    if deadline is None:  # SHARED fix round 4 (Claude Opus 5.5, unreviewed): LOW-3, the command's own when given
        deadline = lock_deadline()  # SHARED fix round 3 (Claude Opus 5.5, unreviewed): LOW-2, one per command
    with inbox_lock(to, deadline=deadline):
        bad = ring_marker_problem(marker)  # SHARED D17 (Claude Opus 5.5, unreviewed): a planted link; D19 a FIFO
        if bad is not None:
            return Delivery(EXIT_REFUSED, f"tc send: {marker} {bad}; nothing sent", [])
        waiting = unread_count(to)
        owed = ring_owed(marker)  # SHARED fix round 1 (Claude Opus 5.5, unreviewed): D20, the state, not the file
        held = ring_backoff(marker) if owed else None
        landed = deliver_local(card, sender, to, body, header_note, deadline=deadline)
        count = unread_count(to)
        ring = landed.exit == 0 and held is None and (owed or not waiting)
        if ring:
            write_ring_marker(to, RING_RINGING, f"a send from {sender} is ringing")
    if landed.exit != 0:
        return landed
    words, warnings = [landed.words], list(landed.warnings)
    if held is not None:
        warnings.append(f"ring pending for {to}: the last ring timed out at {clock_words(held)}; "
                        f"a send after {clock_words(held + RING_BACKOFF_SECONDS)} rings again")
        return Delivery(landed.exit, landed.words, warnings)
    if not ring:
        return landed
    failure = ring_codex(card, sender, to, count)
    if failure is None:
        words.append(f"rang codex {to} (queued; delivered when its turn ends or the session is resumed)")
        problem = write_ring_marker(to, RING_CLEAR, f"a send from {sender} rang")  # SHARED fix round 1 (Claude Opus 5.5, unreviewed): D20
        if problem is not None:
            warnings.append(f"rang codex {to}, but {marker} could not be cleared ({problem}); "
                            f"the next send to {to} may ring again")
        return Delivery(landed.exit, "\n".join(words), warnings)
    problem = write_ring_marker(to, RING_TIMED_OUT if failure.timed_out else RING_FAILED, failure.reason)
    if problem is not None:
        warnings.append(f"ring failed for {to}: {failure.reason}; the mail is in its inbox; {marker} could "
                        f"not be written ({problem}), so a later send may not ring")
    elif failure.timed_out:
        try:
            stamp = marker.stat().st_mtime
        except OSError:
            stamp = wall_clock()
        warnings.append(f"ring failed for {to}: {failure.reason}; the mail is in its inbox; "
                        f"a send after {clock_words(stamp + RING_BACKOFF_SECONDS)} rings again")
    else:
        warnings.append(f"ring failed for {to}: {failure.reason}; the mail is in its inbox; "
                        f"the next send to {to} rings again")
    return Delivery(landed.exit, "\n".join(words), warnings)


# CARDS fix round 1 (Claude Opus 5.5, unreviewed): the ring, apart from its bookkeeping.
def ring_codex(card, sender, to, count):
    """Ring the Codex thread named on `card` once. None when codex exits 0, else a RingFailure.

    The RingFailure says why not, in words, and whether codex ran past
    CODEX_RING_SECONDS (timed_out), which is all the caller's backoff
    needs (D16). A thread_id that is missing, or is not a str of
    THREAD_ID_PATTERN's shape, never reaches codex's argv (D14): the
    words say which. The line names the mailbox root as well as tc, both
    quoted, so a Codex session whose own default root differs reads and
    replies in this one. codex runs in a session of its own: past
    CODEX_RING_SECONDS its whole process group is killed, so a child it
    started (a node CLI's native codex) is not left behind. Its output is
    decoded with errors="replace", so odd bytes never fail a send.

    Known limit (D17, documented, not fixed): codex runs as the sending
    Linux user. Under a shared mailbox (C4), a Codex session run by
    another Linux user is probably not reachable by its ring, since its
    threads live under that user's home. The ring fails, the marker stays
    and the backoff holds (D16), and the mail still lands in the inbox.

    @interacts  when the thread_id passes, starts `codex queue --thread
                <thread_id> --message <C2's line>` in a new session with
                stdin from /dev/null, reads its stdout and stderr until it
                exits or CODEX_RING_SECONDS pass, then SIGKILLs its process
                group (that group only) and reaps it. Writes nothing.
    @deps       THREAD_ID_PATTERN, CODEX_RING_SECONDS, ROOT, RingFailure;
                subprocess, os, signal, shlex, pathlib; the `codex` CLI on
                PATH.
    @complexity O(t) over t characters of the thread_id, plus one codex run
                of at most CODEX_RING_SECONDS.
    @alloc      the message and codex's captured output, freed on return;
                one child and its two pipes, closed and reaped on return;
                one RingFailure on a failure.
    """
    thread = card.get("thread_id") if card else None
    if thread is None or thread == "":
        return RingFailure("its card has no thread_id", False)
    if not isinstance(thread, str) or not THREAD_ID_PATTERN.fullmatch(thread):
        return RingFailure("its card's thread_id is not a thread id", False)
    # CARDS fix round 1 (Claude Opus 5.5, unreviewed): the root in the line, a session of its own, odd bytes.
    run = f"TC_ROOT={shlex.quote(str(ROOT.resolve()))} {shlex.quote(str(pathlib.Path(__file__).resolve()))}"
    message = (f"MAIL: {count} unread for {to}. Run: {run} read {to}, act on it, "
               f"reply with {run} send --from {to} --to {sender}.")
    try:
        with subprocess.Popen(["codex", "queue", "--thread", thread, "--message", message],
                              stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                              stderr=subprocess.PIPE, encoding="utf-8", errors="replace",
                              start_new_session=True) as proc:
            try:
                _, said = proc.communicate(timeout=CODEX_RING_SECONDS)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(proc.pid, signal.SIGKILL)  # its own group: start_new_session
                except ProcessLookupError:
                    pass  # every process in the group is already gone
                proc.wait()
                return RingFailure(f"no answer in {CODEX_RING_SECONDS} s", True)
    except OSError as err:
        return RingFailure(f"could not run codex ({err.strerror})", False)
    if proc.returncode != 0:
        lines = said.strip().splitlines()
        return RingFailure(lines[0] if lines else f"codex exited {proc.returncode} with no stderr", False)
    return None


# One function per route; a card's route picks one. A route not here
# answers "route <route> is not built yet" (C2). Each lane adds its own line.
ROUTES = {
    "local": deliver_local,
    "codex": deliver_codex,
}


# ---------- health: machine, sessions, listeners, mail ----------

def machine_stats():
    """Load, memory and GPU right now. GPU is None when nvidia-smi is absent."""
    load1 = os.getloadavg()[0]
    cores = os.cpu_count() or 1
    info = {}
    with open("/proc/meminfo") as f:
        for line in f:
            key, _, rest = line.partition(":")
            info[key] = int(rest.split()[0])
    mem_pct = 100.0 * info["MemAvailable"] / info["MemTotal"]
    return {"load1": round(load1, 2), "cores": cores,
            "mem_avail_pct": round(mem_pct, 1), "gpus": gpu_stats()}


def gpu_stats():
    exe = shutil.which("nvidia-smi")
    if not exe:
        return None
    try:
        out = subprocess.run([exe, "--query-gpu=temperature.gpu,utilization.gpu",
                              "--format=csv,noheader,nounits"], capture_output=True,
                             text=True, timeout=GPU_QUERY_TIMEOUT_SECONDS).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    gpus = []
    for line in out.strip().splitlines():
        parts = [x.strip() for x in line.split(",")]
        if len(parts) == 2 and all(x.isdigit() for x in parts):
            gpus.append({"temp_c": int(parts[0]), "util_pct": int(parts[1])})
    return gpus or None


def _cmdline(pid):
    try:
        raw = pathlib.Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return []
    return [a.decode(errors="replace") for a in raw.split(b"\0") if a]


def _is_codex(argv):
    if not argv or any("app-server-daemon" in a for a in argv):
        return False
    first = os.path.basename(argv[0])
    return first == "codex" or (first == "node" and len(argv) > 1 and os.path.basename(argv[1]) == "codex")


def session_counts():
    """Claude Code sessions (process name `claude`) and Codex CLI sessions.

    Codex is approximate: a CLI started through node spawns a native `codex`
    child, so a codex process whose parent is also codex is not counted again,
    and the app-server daemon is skipped.
    """
    claude, codex_pids, parent = 0, set(), {}
    for d in pathlib.Path("/proc").iterdir():
        if not d.name.isdigit():
            continue
        try:
            stat = (d / "stat").read_text()
        except OSError:
            continue
        # comm is in parens and may hold spaces; fields after it are fixed.
        comm = stat[stat.index("(") + 1:stat.rindex(")")]
        fields = stat[stat.rindex(")") + 2:].split()
        state, ppid = fields[0], fields[1]
        if state == "Z":
            continue
        if comm == "claude":
            claude += 1
        elif _is_codex(_cmdline(d.name)):
            codex_pids.add(d.name)
            parent[d.name] = ppid
    codex = sum(1 for pid in codex_pids if parent[pid] not in codex_pids)
    return {"claude": claude, "codex": codex}


def _flock_holders():
    """Map 'major:minor:inode' to the pid holding an flock on that file."""
    holders = {}
    try:
        lines = pathlib.Path("/proc/locks").read_text().splitlines()
    except OSError:
        return holders
    for line in lines:
        f = line.split()
        if len(f) >= 6 and f[1] == "FLOCK":
            holders[f[5]] = int(f[4])
    return holders


def _lock_key(st):
    """The 'major:minor:inode' key /proc/locks gives the file whose stat result is `st`.

    SHARED fix round 1 (Claude Opus 5.5, unreviewed): it takes the stat
    result, so the caller decides whether a link is followed (listeners
    never follows one).

    @interacts  none.
    @deps       os.
    @complexity O(1).
    @alloc      one short string, returned.
    """
    return f"{os.major(st.st_dev):02x}:{os.minor(st.st_dev):02x}:{st.st_ino}"


def listeners(kind="wait"):
    """Each name that ever ran `tc <kind>`, with the pid holding its lock or None.

    Reads /proc/locks instead of trying the lock, so probing never races a
    listener that is starting up. SHARED fix round 1 (Claude Opus 5.5,
    unreviewed): each lock is lstat()ed, and one that is not a regular
    file (a symlink planted at a name's lock, a FIFO) is left out. A
    link's target may be another listener's lock, and the proof of life
    (CLAUDE.md rule 6) must never follow it, so tc health, tc watch and
    the board report no listener from a link.

    @interacts  reads /proc/locks; lists mail/ and lstats each lock file.
                Writes nothing.
    @deps       _flock_holders, _lock_key; os, stat; MAIL.
    @complexity O(k + n) over k lines in /proc/locks (tens) and n lock
                files of this kind (a few dozen).
    @alloc      the holder map and one dict of names, returned.
    """
    holders = _flock_holders()
    out = {}
    if not MAIL.exists():
        return out
    prefix = f".{kind}-"
    for lock in sorted(MAIL.glob(f"{prefix}*.lock")):
        name = lock.name[len(prefix):-len(".lock")]
        try:
            st = os.lstat(lock)
        except OSError:
            out[name] = None
            continue
        if not stat.S_ISREG(st.st_mode):
            continue  # SHARED fix round 1 (Claude Opus 5.5, unreviewed): a planted link is nobody's lock
        out[name] = holders.get(_lock_key(st))
    return out


def _age(seconds):
    if seconds is None:
        return None
    if seconds < SECONDS_PER_MINUTE:
        return f"{int(seconds)}s"
    if seconds < SECONDS_PER_HOUR:
        return f"{int(seconds // SECONDS_PER_MINUTE)}m"
    if seconds < SECONDS_PER_DAY:
        return f"{int(seconds // SECONDS_PER_HOUR)}h"
    return f"{int(seconds // SECONDS_PER_DAY)}d"


def mailbox_summary():
    """Each inbox's unread count, the age of its newest mail and of its status, and why a count is unknown, by name.

    SHARED fix round 1 (Claude Opus 5.5, unreviewed): an inbox is a real
    folder at mail/to-<name> (lstat). A linked one is left out, as send,
    read and wait refuse it, so this never counts or dates a folder
    outside the mailbox. Only regular *.md files count (message_files),
    unread and in a read/ that is itself a real folder; their ages come
    from lstat, never through a link. SHARED fix round 2 (Claude Opus
    5.5, unreviewed): the audit's LOW-3. That holds for what this
    returns, which tc health shows and any caller may read. The board
    also reads mail/ on its own (its wires and links); that reading is
    the board's, and nothing here governs it.

    SHARED fix round 2 (Claude Opus 5.5, unreviewed): the audit's LOW-2
    and BOARD's review, never a silent 0. When tc cannot list an inbox (a
    3770 inbox seen by a user outside the group), or cannot lstat an entry
    in it (an inbox its owner left readable without search), `unread` is
    None and `mail_problem` says why. When the same goes for read/ (or
    read/ itself cannot be looked at), `newest_mail_age_s` is None and
    `mail_problem` says why. `mail_problem` is None when every entry was
    looked at. Nothing here raises for an inbox it cannot see into.

    SHARED, from BOARD's review (Claude Opus 5.5, unreviewed): a status
    file's age comes from lstat too. A link there, or anything that is
    not a regular file, or one lstat cannot reach, has no status age
    (null). A member who links their status file into a folder others
    cannot search can no longer make this raise PermissionError, and so
    stop tc health.

    @interacts  lists mail/; lstats each inbox, its read/, each *.md
                entry and each name's status file; lists each inbox and
                read/ (message_files). Writes nothing.
    @deps       real_folder, message_files; os, stat, time; MAIL, STATUS.
    @complexity O(n + m) over n inboxes (a few dozen) and m message files
                in every inbox and read/ (hundreds to thousands, growing
                with the history), one lstat each.
    @alloc      one dict per inbox, returned; each inbox's message lists
                while it is counted.
    """
    now = time.time()
    out = {}
    for box in sorted(MAIL.glob("to-*")) if MAIL.exists() else []:
        if not real_folder(box):
            continue
        name = box.name[len("to-"):]
        unread, _, unread_problem = message_files(box)  # SHARED fix round 2 (Claude Opus 5.5, unreviewed): LOW-2
        read = box / "read"
        try:
            read_is_folder, history_problem = stat.S_ISDIR(os.lstat(read).st_mode), None
        except FileNotFoundError:
            read_is_folder, history_problem = False, None
        except OSError as err:
            read_is_folder, history_problem = False, f"tc could not look at {read} ({err.strerror})"
        if read_is_folder:
            history, _, history_problem = message_files(read)
        else:
            history = []
        problem = unread_problem or history_problem
        newest = None if problem else max((st.st_mtime for _, st in unread + history), default=None)
        try:  # SHARED, from BOARD's review (Claude Opus 5.5, unreviewed): lstat, never through a link
            st = os.lstat(STATUS / f"{name}.md")
        except OSError:
            st = None
        out[name] = {
            "unread": None if unread_problem else len(unread),
            "newest_mail_age_s": None if newest is None else round(now - newest),
            "status_age_s": round(now - st.st_mtime) if st is not None and stat.S_ISREG(st.st_mode) else None,
            "mail_problem": problem,
        }
    return out


# CARDS R5 (Claude Opus 5.5, unreviewed): the cards tc health shows.
def cards_summary():
    """Every card's name, kind, account, route, reports_to and ssh_target, in name order.

    The name is the file's (cards/<name>.json), the one the router reads.
    ssh_target is an ssh card's target (`u@h`), so `tc health` can say
    what `tc cards` says; null for any other route. A card that is
    not a JSON object keeps its name with the other five fields null, so
    it still shows.

    @interacts  reads cards/*.json through all_cards. Writes nothing.
    @deps       all_cards; pathlib.
    @complexity O(c) over c cards (a few dozen).
    @alloc      one list of c small dicts, returned.
    """
    out = []
    for file_name, card in all_cards():
        card = card or {}
        ssh = card.get("ssh")  # CARDS fix round 1 (Claude Opus 5.5, unreviewed): ssh_target
        target = ssh.get("target") if card.get("route") == "ssh" and isinstance(ssh, dict) else None
        out.append({"name": pathlib.Path(file_name).stem, "kind": card.get("kind"),
                    "account": card.get("account"), "route": card.get("route"),
                    "reports_to": card.get("reports_to"), "ssh_target": target})
    return out


def health_snapshot():
    """One snapshot of the machine, sessions, listeners, watchers, mail and cards.

    `shared_group` (SHARED H1, Claude Opus 5.5, unreviewed) is the group
    the mailbox is shared with, or null when it is private (C4).
    SHARED fix round 1 (Claude Opus 5.5, unreviewed): the audit's LOW-8.
    An unreadable .shared never raises here: `shared_group` is null and
    `shared_problem` says why. `shared_problem` is null otherwise.
    Reworded from BOARD's review (Claude Opus 5.5, unreviewed): the
    reason is tc health's own, since BOARD's feed builds from tc's parts
    and never calls this. main() refuses tc health on a .shared that is
    already unreadable, before this runs, but one that turns unreadable
    after main() read it still gets an answer, not a traceback, and so
    does any caller that loads tc as a module (the tests do). tc watch
    does not call this. SHARED fix round 2 (Claude Opus 5.5,
    unreviewed): each `mail` entry carries `mail_problem`, and its
    `unread` or `newest_mail_age_s` is null when tc could not see into
    that inbox or its read/ (mailbox_summary, the audit's LOW-2).

    @interacts  reads /proc, mail/, status/, cards/ and ROOT/.shared; may
                run nvidia-smi (machine_stats). Writes nothing.
    @deps       now_iso, machine_stats, session_counts, listeners,
                mailbox_summary, cards_summary, shared_group.
    @complexity O(p + k + n + m + c): p processes, k lines in /proc/locks,
                n mailbox names, m message files in every inbox and read/
                (mailbox_summary stats each one: hundreds to thousands), c
                cards.
    @alloc      one dict, returned.
    """
    try:  # SHARED fix round 1 (Claude Opus 5.5, unreviewed): LOW-8, a field, never a raise
        group, problem = shared_group(), None
    except ValueError as err:
        group, problem = None, str(err)
    return {"time": now_iso(), "machine": machine_stats(), "sessions": session_counts(),
            "listeners": listeners("wait"), "watchers": listeners("watch"),
            "mail": mailbox_summary(), "cards": cards_summary(),
            "shared_group": group, "shared_problem": problem}  # SHARED H1 (Claude Opus 5.5, unreviewed): C4


def _gpu_text(gpus):
    if not gpus:
        return "GPU none"
    return " · ".join(f"GPU {g['temp_c']}C {g['util_pct']}%" for g in gpus)


# Phase fix round 1 (Claude Opus 5.5, unreviewed): names escaped, and this block.
def _who(table):
    """Listener or watcher names in words: `<name> (pid <p>)` for each live one, then the stopped ones.

    A name comes from a lock file's name, so it goes through printable().

    @interacts  none; string work only.
    @deps       printable.
    @complexity O(n) over n names in `table` (a few dozen).
    @alloc      two lists and one string, returned.
    """
    up = [f"{printable(n)} (pid {pid})" for n, pid in table.items() if pid]
    down = [printable(n) for n, pid in table.items() if not pid]
    text = " · ".join(up) if up else "none running"
    return text + (f" · stopped: {', '.join(down)}" if down else "")


def cmd_health(args):
    """`tc health [--json]`: the snapshot, as JSON or one screen of words.

    In words, every card field and every name taken from a file name (a
    card, an inbox, a listener's lock) goes through printable(); the JSON
    is escaped by json.dumps. The last line says `mailbox shared with
    group <g>` or `mailbox private` (C4).

    SHARED fix round 2 (Claude Opus 5.5, unreviewed): the audit's LOW-4
    and LOW-2. When health_snapshot reports `shared_problem` (.shared
    turned unreadable after main() read it), the last line is `mailbox
    shared, group unknown: <why>`, never `mailbox private`. An inbox whose
    count mailbox_summary could not know reads `unread unknown`, then the
    reason, never `0 unread`.

    @interacts  see health_snapshot; prints to stdout.
    @deps       health_snapshot, describe_card, printable, _who, _age,
                _gpu_text; json.
    @complexity as health_snapshot.
    @alloc      the snapshot and the printed text, freed on exit.
    """
    snap = health_snapshot()
    if args.json:
        print(json.dumps(snap, indent=2))
        return
    m, s = snap["machine"], snap["sessions"]
    print(f"machine    load {m['load1']} / {m['cores']} cores · mem free {m['mem_avail_pct']}% · {_gpu_text(m['gpus'])}")
    print(f"sessions   {s['claude']} Claude Code · {s['codex']} Codex")
    print(f"listeners  {_who(snap['listeners'])}")
    print(f"watchers   {_who(snap['watchers'])}")
    # CARDS R5 (Claude Opus 5.5, unreviewed): one line per card, `?` for a field it lacks.
    cards = []
    for c in snap["cards"]:
        shown = {k: ("?" if v is None and k != "reports_to" else v) for k, v in c.items()}
        if c["ssh_target"] is not None:  # CARDS fix round 1 (Claude Opus 5.5, unreviewed): `route ssh to <target>`
            shown["ssh"] = {"target": c["ssh_target"]}
        cards.append(describe_card(shown))
    print("cards      " + ("\n           ".join(cards) if cards else "none"))
    rows = []
    for name, b in snap["mail"].items():
        bits = ["unread unknown" if b["unread"] is None else f"{b['unread']} unread"]  # SHARED fix round 2 (Claude Opus 5.5, unreviewed): LOW-2
        if b["newest_mail_age_s"] is not None:
            bits.append(f"last mail {_age(b['newest_mail_age_s'])} ago")
        if b["status_age_s"] is not None:
            bits.append(f"status {_age(b['status_age_s'])} ago")
        if b["mail_problem"] is not None:
            bits.append(printable(b["mail_problem"]))
        rows.append(f"{printable(name)}: " + ", ".join(bits))  # Phase fix round 1 (Claude Opus 5.5, unreviewed)
    print("mail       " + ("\n           ".join(rows) if rows else "empty"))
    group, problem = snap["shared_group"], snap["shared_problem"]  # SHARED H1 (Claude Opus 5.5, unreviewed): C4
    if group is not None:
        print(f"mailbox shared with group {printable(group)}")
    elif problem is not None:  # SHARED fix round 2 (Claude Opus 5.5, unreviewed): LOW-4
        print(f"mailbox shared, group unknown: {printable(problem)}")
    else:
        print("mailbox private")


# ---------- watch: heartbeat and alerts that wake the session ----------

def _breaches(m, args, strikes):
    found = []
    if strikes >= LOAD_STRIKES:
        found.append(f"load {m['load1']} over {args.load_ratio} x {m['cores']} cores for {strikes} polls")
    if m["mem_avail_pct"] < args.mem_min_pct:
        found.append(f"mem free {m['mem_avail_pct']}% under {args.mem_min_pct}%")
    for i, g in enumerate(m["gpus"] or []):
        if g["temp_c"] > args.gpu_max_c:
            found.append(f"GPU{i} {g['temp_c']}C over {args.gpu_max_c}C")
    return found


def cmd_watch(args):
    """`tc watch <name>`: heartbeat or alert that wakes the session <name>.

    @interacts  checks the name first (C0, exit 6, nothing written); caps
                its own address space; reads ROOT/.shared and makes mail/
                (make_folder) and holds mail/.watch-<name>.lock (flock)
                until it exits, opened through open_by_name, which refuses
                a symlink or a FIFO there (exit 1, D17, D19); reads /proc
                and lstats each wait lock every poll (see machine_stats,
                listeners) and runs nvidia-smi; prints a HEARTBEAT or ALERT
                line.
    @deps       require_names, make_folder, open_by_name, machine_stats,
                listeners, session_counts, _breaches; fcntl, os, resource.
    @complexity O(k + n) per poll: k lines in /proc/locks and n wait lock
                files (listeners), plus /proc/meminfo and one nvidia-smi
                run where it exists (machine_stats); no cards. O(p) once per
                heartbeat over p processes (session_counts). One poll every
                args.poll seconds until the heartbeat.
    @alloc      one open lock file for its lifetime; the peaks, a few floats.
    """
    require_names(args.name)  # CARDS R1 (Claude Opus 5.5, unreviewed)
    resource.setrlimit(resource.RLIMIT_AS, (WAIT_MEMORY_CAP_BYTES, WAIT_MEMORY_CAP_BYTES))
    make_folder(MAIL)  # SHARED H1 (Claude Opus 5.5, unreviewed): D16
    lock = open(open_by_name(MAIL / f".watch-{args.name}.lock", os.O_WRONLY | os.O_TRUNC), "w")  # SHARED D17 (Claude Opus 5.5, unreviewed)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print(f"ALREADY WATCHING: another `tc watch {args.name}` is running. Not starting a second.")
        sys.exit(EXIT_ALREADY_LISTENING)
    tracked = [n for n in (args.names.split(",") if args.names else []) if n]
    alive_at_start = {n for n, pid in listeners("wait").items() if n in tracked and pid}
    peak_load, low_mem, peak_gpu, strikes = 0.0, 100.0, None, 0
    deadline = time.monotonic() + args.heartbeat
    while True:
        m = machine_stats()
        over = m["load1"] > args.load_ratio * m["cores"]
        strikes = strikes + 1 if over else 0
        peak_load = max(peak_load, m["load1"])
        low_mem = min(low_mem, m["mem_avail_pct"])
        for g in m["gpus"] or []:
            peak_gpu = g["temp_c"] if peak_gpu is None else max(peak_gpu, g["temp_c"])
        problems = _breaches(m, args, strikes)
        now_alive = {n for n, pid in listeners("wait").items() if pid}
        problems += [f"LISTENER DOWN: {n}" for n in sorted(alive_at_start - now_alive)]
        if problems:
            print(f"ALERT {now_iso()}: " + "; ".join(problems))
            print(f"  now: load {m['load1']} / {m['cores']}, mem free {m['mem_avail_pct']}%, {_gpu_text(m['gpus'])}")
            print(f"Re-arm after handling: tc watch {args.name}")
            sys.exit(EXIT_ALERT)
        if time.monotonic() >= deadline:
            break
        time.sleep(min(args.poll, max(0.0, deadline - time.monotonic())))
    s = session_counts()
    gpu = "GPU none" if peak_gpu is None else f"GPU peak {peak_gpu}C"
    up = sorted(n for n, pid in listeners("wait").items() if pid)
    print(f"HEARTBEAT {now_iso()}: load {m['load1']} (peak {peak_load}) / {m['cores']}, "
          f"mem free {m['mem_avail_pct']}% (low {low_mem}%), {gpu}, "
          f"{s['claude']} Claude Code, {s['codex']} Codex, listening: {', '.join(up) or 'none'}")
    print(f"Re-arm: tc watch {args.name}")


# CARDS R6 (Claude Opus 5.5, unreviewed): the one parser class (D12).
class TcParser(argparse.ArgumentParser):
    """An ArgumentParser whose usage errors exit EXIT_USAGE (9), never 2.

    main() builds the top parser from it and hands it to add_subparsers as
    parser_class, so every subcommand's parser is one too: an error a
    subcommand finds (a missing --from, a bad --timeout) exits 9 as well.

    @interacts  see error().
    @deps       argparse, sys.
    @complexity as argparse.
    @alloc      as argparse.
    """

    def error(self, message):
        """Print the usage and the message to stderr, then exit EXIT_USAGE.

        @interacts  writes the usage line and one error line to stderr; exits.
        @deps       argparse.ArgumentParser.print_usage and exit.
        @complexity O(a) over the arguments the usage line names.
        @alloc      the usage text, freed on exit.
        """
        self.print_usage(sys.stderr)
        self.exit(EXIT_USAGE, f"{self.prog}: error: {message}\n")


def main():
    """Parse the command line and run one command.

    @interacts  reads sys.argv; a usage error exits EXIT_USAGE (TcParser);
                else sets the shared umask when ROOT/.shared exists
                (set_shared_umask), then whatever the chosen cmd_* does.
    @deps       TcParser, set_shared_umask; every cmd_* function.
    @complexity O(a) over a arguments to parse, plus the command.
    @alloc      the parser and the parsed arguments, freed on exit.
    """
    # Phase fix round 1 (Claude Opus 5.5, unreviewed): agent sessions, not only Claude.
    ap = TcParser(prog="tc", description="Mailbox between agent sessions: a Claude Code session "
                                          "wakes when its tc wait exits; a Codex session runs tc "
                                          "join once, and then a send rings it.")
    sub = ap.add_subparsers(dest="cmd", required=True, parser_class=TcParser)

    s = sub.add_parser("send", help="send a message (text arg or stdin)")
    s.add_argument("--from", dest="sender", required=True)
    s.add_argument("--to", required=True)
    s.add_argument("message", nargs="?")
    s.set_defaults(fn=cmd_send)

    for name, fn, text in (("read", cmd_read, "print unread and mark read"),
                           ("peek", cmd_peek, "print unread, leave unread")):
        p = sub.add_parser(name, help=text)
        p.add_argument("name")
        p.set_defaults(fn=fn)

    w = sub.add_parser("wait", help="block until mail arrives (run in background)")
    w.add_argument("name")
    w.add_argument("--timeout", type=float, default=None,
                   help=f"seconds (default {DEFAULT_WAIT_SECONDS}, or just under the cache TTL with --keepalive)")
    w.add_argument("--keepalive", action="store_true",
                   help="wake just before the prompt cache expires, so an idle session stays warm")
    w.set_defaults(fn=cmd_wait)

    st = sub.add_parser("status", help="post status (with text) or show all (without)")
    st.add_argument("name", nargs="?")
    st.add_argument("text", nargs="?")
    st.set_defaults(fn=cmd_status)

    lg = sub.add_parser("log", help="full history, both directions")
    lg.add_argument("--last", type=int, default=0)
    lg.set_defaults(fn=cmd_log)

    h = sub.add_parser("health", help="machine load, memory, GPU, sessions, listeners, cards, mail")
    h.add_argument("--json", action="store_true", help="machine-readable, for a board")
    h.set_defaults(fn=cmd_health)

    wt = sub.add_parser("watch", help="heartbeat for a session; exits early on an alert (run in background)")
    wt.add_argument("name", help="the session this watcher wakes")
    wt.add_argument("--heartbeat", type=float, default=keepalive_seconds(),
                    help="seconds between heartbeats (default: just under the cache TTL)")
    wt.add_argument("--poll", type=float, default=WATCH_POLL_SECONDS)
    wt.add_argument("--names", default="", help="comma list of listeners to watch; alert if one goes down")
    wt.add_argument("--load-ratio", type=float, default=LOAD_ALERT_RATIO)
    wt.add_argument("--mem-min-pct", type=float, default=MEM_AVAIL_MIN_PCT)
    wt.add_argument("--gpu-max-c", type=float, default=GPU_TEMP_MAX_C)
    wt.set_defaults(fn=cmd_watch)

    # CARDS R2 (Claude Opus 5.5, unreviewed): join, card, cards (C1).
    j = sub.add_parser("join", help="write the address card for the session this runs in; a Codex "
                                    "session must join before a send can ring it")
    j.add_argument("name")
    j.add_argument("--account", help="account label (default: CLAUDE_CONFIG_DIR's base name, else unknown)")
    j.add_argument("--kind", choices=CARD_KINDS, help="override the kind tc works out")
    j.add_argument("--reports-to", dest="reports_to", help="a hint for the board's levels, never a route")
    j.set_defaults(fn=cmd_join)

    cd = sub.add_parser("card", help="write a card for a name that lives on another machine")
    cd.add_argument("name")
    cd.add_argument("--ssh", required=True, metavar="USER@HOST")
    cd.add_argument("--remote-tc", dest="remote_tc", default=DEFAULT_REMOTE_TC,
                    help=f"tc's path on that machine (default {DEFAULT_REMOTE_TC})")
    cd.add_argument("--account")
    cd.add_argument("--reports-to", dest="reports_to")
    cd.add_argument("--force", action="store_true", help="write it even with unread mail here")
    cd.set_defaults(fn=cmd_card)

    cs = sub.add_parser("cards", help="every card, one line each")
    cs.set_defaults(fn=cmd_cards)

    # SHARED H1 (Claude Opus 5.5, unreviewed): tc init --shared --group <g> (C4).
    ini = sub.add_parser("init", help="share this mailbox with a group of Linux users (one per account)")
    ini.add_argument("--shared", action="store_true", required=True,
                     help="share it: group-writable files, setgid folders, ROOT/.shared")
    ini.add_argument("--group", required=True, help="a group every user of the mailbox is in")
    ini.set_defaults(fn=cmd_init)

    args = ap.parse_args()
    set_shared_umask(args.fn)  # SHARED H1 (Claude Opus 5.5, unreviewed): before any write (C4)
    args.fn(args)


if __name__ == "__main__":
    main()
