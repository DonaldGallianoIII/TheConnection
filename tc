# SSH task 0 (Claude Opus 5.5, unreviewed): the publish that deliver_local
# held inline, lifted out so the ssh route's outbox (D25) publishes the
# same way. What it hands back: the number and path the message landed
# at, the warnings so far, and, when it did not land, the Delivery that
# says why (refusal), with n and path then the last ones tried.
Published = collections.namedtuple("Published", "n path warnings refusal")


def publish_message(box, box_fd, history, n, sender, to, body, header_note, mode, deadline, *, busy_on_passing=False):
    """Publish one message in the folder open at `box_fd` (its path `box`) at number `n`, or the first number after it nothing has: a Published.

    P3 fix round 1a (Claude Opus 5.5, unreviewed): D35 and the audit's
    HIGH-1. Every step is by name in the open folders, never by a path:
    the .tmp is made in `box_fd`, linked to its name there and removed
    there, and `history` holds (name, descriptor) pairs, the subfolders
    open (descriptor None when one is not there). So a folder swapped for
    a link after the caller opened it leads no step elsewhere; `box`
    names the paths in the words and in the Published only.

    The message is written whole to a new .tmp (write_new_file, so
    nothing at that name is ever written through), hard-linked to
    NNNNNN-from-<sender>.md (os.link fails on anything at that name, where
    a rename would replace it; it never follows a link at the .tmp's
    name), and the .tmp's name removed. It skips to the next number
    (next_seq) three ways: a name already in one of the subfolders in
    `history` (read/ for an inbox; sent/ and refused/ for an outbox), the
    message's own name taken, or its .tmp name taken.
    The .tmp's FileExistsError is caught ahead of any other OSError. All
    three share PUBLISH_MAX_TRIES and the command's one `deadline` (each
    next_seq waits no later than it, then exits 10). Out of tries: a
    refusal Delivery exit 10, busy (EXIT_BUSY), whose words name the last
    name a try found taken and say mail/.seq was behind only when a try
    found a message's own name or a history name taken (TMP_TAKEN_WHY
    otherwise). A .tmp that cannot be made for any other reason, a link
    that fails for a reason but a taken name, or a filesystem with no hard
    links (NO_HARD_LINK_ERRNOS) is a refusal Delivery exit 1, nothing
    published, no .tmp left. The header is `# #<n> from <sender> to <to>,
    <time>`, plus `, <header_note>` when one is given; the body follows
    a blank line, trailing whitespace cut, one newline at its end.
    SSH fix round 1 (Claude Opus 5.5, unreviewed): D33 part 4.
    `header_note` may be a function of the number a try takes, called
    once per try, so the outbox's note can carry an origin id built from
    the number the message lands at.

    P3 fix round 1c (Claude Opus 5.5, unreviewed): D36 (4), the audit's
    LOW-4. With `busy_on_passing` (the far gate's delivery,
    route_and_deliver), a .tmp that cannot be made, written or linked for
    a reason that passes (PASSING_WRITE_ERRNOS: no space, a quota, an I/O
    error) is a refusal Delivery exit 10, busy, not 1, with words saying
    so: nothing is left behind (write_new_file removes a .tmp whose write
    failed, and a failed link's .tmp is removed as always), and the near
    side keeps the message queued for tc flush. Without it, tc send's own
    refusal stays exit 1, as row 10 names only the gate for this.

    Lifted unchanged from deliver_local's SHARED fix rounds 2 to 7 (D20,
    D23, DEBT-1, LOW-1 to LOW-3); their record is in deliver_local's
    block.

    @interacts  per try: lstats NNNNNN-from-<sender>.md by name in each
                open folder of `history`, creates NNNNNN-from-<sender>.tmp
                by name in `box_fd` at `mode` (write_new_file), links it
                to its .md name there and removes the .tmp's name there;
                every try after the first takes a number (next_seq: the
                mail/.seq flock, waiting no later than `deadline`, then
                exit 10). Reads the clock (now_iso).
    @deps       next_seq, write_new_file, name_taken, now_iso, Delivery;
                os; ROOT, SEQ_WIDTH, PUBLISH_MAX_TRIES,
                NO_HARD_LINK_ERRNOS, PASSING_WRITE_ERRNOS, TMP_TAKEN_WHY,
                PASSING_WORDS, EXIT_REFUSED, EXIT_BUSY.
    @complexity O(b) over b bytes of body, once per try: one try in an
                honest mailbox, at most PUBLISH_MAX_TRIES, a bound reached
                by a set-back mail/.seq or by names planted ahead of it;
                plus h lstats per try, h = len(history), one or two.
    @alloc      the message text while written; one message file, kept;
                at most one .tmp per try, removed before the next; the
                last taken name, one short string; one Published,
                returned.
    """
    warnings = []
    taken, behind = None, False  # SHARED fix round 6 (Claude Opus 5.5, unreviewed): LOW-2, the name each try found taken
    # SHARED fix round 2 (Claude Opus 5.5, unreviewed): D20, never over a message; a taken name takes the next number.
    for tries in range(PUBLISH_MAX_TRIES):
        if tries:
            n = next_seq(deadline)
        path = box / f"{n:0{SEQ_WIDTH}d}-from-{sender}.md"
        kept = next((f"{folder}/{path.name}" for folder, folder_fd in history
                     if folder_fd is not None and name_taken(path.name, folder_fd)), None)  # P3 fix round 1a: D35, by name
        if kept is not None:
            taken, behind = kept, True
            continue  # a filed message has this name (in read/, tc read would rename over it)
        tmp = path.with_suffix(".tmp")
        note = header_note(n) if callable(header_note) else header_note  # SSH fix round 1 (Claude Opus 5.5, unreviewed): D33 part 4
        header = f"# #{n} from {sender} to {to}, {now_iso()}" + (f", {note}" if note else "")
        try:  # CARDS fix round 1 (Claude Opus 5.5, unreviewed): a planted link is refused
            write_new_file(tmp.name, f"{header}\n\n{body.rstrip()}\n", mode, dir_fd=box_fd)  # P3 fix round 1a: D35
        except FileExistsError:  # SHARED fix round 5 (Claude Opus 5.5, unreviewed): DEBT-1, a taken .tmp takes the next number
            taken = tmp.name
            continue
        except OSError as err:
            if busy_on_passing and err.errno in PASSING_WRITE_ERRNOS:  # P3 fix round 1c (Claude Opus 5.5, unreviewed): D36 (4)
                return Published(n, path, [], Delivery(EXIT_BUSY, PASSING_WORDS.format(
                    what=f"could not write {tmp}", why=err.strerror), []))
            return Published(n, path, [], Delivery(EXIT_REFUSED, f"tc send: could not create {tmp} "
                                                                f"({err.strerror}); nothing sent", []))
        try:  # P3 fix round 1a (Claude Opus 5.5, unreviewed): D35, by name in the open folder, never through a link
            os.link(tmp.name, path.name, src_dir_fd=box_fd, dst_dir_fd=box_fd, follow_symlinks=False)
            failed = None
        except OSError as err:
            failed = err
        try:
            os.unlink(tmp.name, dir_fd=box_fd)  # this send's own .tmp, made just above; a linked message stays at path
        except OSError as err:
            warnings.append(f"tc send: could not remove {tmp} ({err.strerror})")
        if failed is None:
            break
        if failed.errno in NO_HARD_LINK_ERRNOS:  # SHARED fix round 3 (Claude Opus 5.5, unreviewed): LOW-3
            return Published(n, path, warnings, Delivery(
                EXIT_REFUSED, f"tc send: the filesystem under {ROOT} has no hard links ({failed.strerror}), and tc "
                              f"needs them to publish a message without ever replacing another (D20); nothing sent. "
                              f"Put the mailbox (TC_ROOT) on a filesystem that has them, such as ext4.", warnings))
        if busy_on_passing and failed.errno in PASSING_WRITE_ERRNOS:  # P3 fix round 1c (Claude Opus 5.5, unreviewed): D36 (4)
            return Published(n, path, warnings, Delivery(EXIT_BUSY, PASSING_WORDS.format(
                what=f"could not publish {path}", why=failed.strerror), warnings))
        if not isinstance(failed, FileExistsError):
            return Published(n, path, warnings, Delivery(
                EXIT_REFUSED, f"tc send: could not publish {path} ({failed.strerror}); nothing sent", warnings))
        taken, behind = path.name, True  # a message in the folder has this name
    else:  # SHARED fix round 4 (Claude Opus 5.5, unreviewed): DEBT-3, busy, not refused (dev exit row 10)
        why = ("mail/.seq was behind the names there: set back, or names planted ahead of it" if behind
               else TMP_TAKEN_WHY)  # SHARED fix round 7 (Claude Opus 5.5, unreviewed): LOW-1, what tc knows and no more
        return Published(n, path, warnings, Delivery(
            EXIT_BUSY, f"tc send: {PUBLISH_MAX_TRIES} message numbers in a row were taken in {box}, the last by "
                       f"{taken} ({why}); nothing sent. Each try moved mail/.seq on, so the next send starts past "
                       f"them.", warnings))
    return Published(n, path, warnings, None)


# Phase fix round 1 (Claude Opus 5.5, unreviewed): D16, the ring marker and
# the clock its backoff reads.
# What ring_codex hands back when a ring did not go through: why, in words,
# and whether codex ran past CODEX_RING_SECONDS (the one outcome that holds
# later rings back).
RingFailure = collections.namedtuple("RingFailure", "reason timed_out")


def wall_clock():
    """Seconds since the epoch, on the same scale as a file's st_mtime.

    The clock the ring backoff reads (D16), in a function of its own so a
    test replaces it and never sleeps RING_BACKOFF_SECONDS.

    @interacts  reads the system clock.
    @deps       time.
    @complexity O(1).
    @alloc      none.
    """
    return time.time()


def clock_words(seconds):
    """`seconds` since the epoch as the local time of day, HH:MM:SS (CLOCK_FORMAT).

    @interacts  reads the local time zone.
    @deps       datetime; CLOCK_FORMAT.
    @complexity O(1).
    @alloc      one short string, returned.
    """
    return datetime.datetime.fromtimestamp(seconds).strftime(CLOCK_FORMAT)


# SHARED fix round 1 (Claude Opus 5.5, unreviewed): D20 item 5, the
# marker's state lives in its contents; it is rewritten, never removed.
def write_ring_marker(name, state, detail):
    """Rewrite mail/.ring-pending-<name> in place: `state` on the first line, the time and `detail` on the second. None when written, else why, in words.

    D20 item 5: the marker is never removed or renamed over, only
    rewritten, so under a shared mailbox (sticky mail/, where only its
    owner could remove or replace it) every member can still set its
    state, and no .tmp is ever left behind. It is opened through
    open_regular: no link followed, a FIFO refused at once, made at
    NEW_FILE_MODE when missing (group-writable under SHARED_UMASK). Its
    own flock is held while it is truncated and written, so two writers
    never mix lines. A reader that catches it mid-rewrite sees it empty
    or cut short, which reads as owed: one more ring at worst.

    SHARED fix round 2 (Claude Opus 5.5, unreviewed): D20. The marker is
    0664 under a shared mailbox, so a member may hold its flock on
    purpose. The wait is bounded (flock_within): past LOCK_WAIT_SECONDS
    nothing is written and the words say another process is holding the
    marker's lock, which every caller already reports as a marker it
    could not write. SHARED fix round 3 (Claude Opus 5.5, unreviewed): the
    audit's LOW-7. With the lock held through a codex send, neither of its
    writes lands, so the marker keeps its old state. A ring that then
    succeeds may leave a pending state behind, and the next send rings
    once more. A ring that then fails leaves a `clear` marker clear, and
    the next send to the inbox, which is not empty, does not ring: one
    ring fewer, which the send's warning says (a later send may not
    ring). Either way the mail is in the inbox, never lost or altered.

    @interacts  opens mail/.ring-pending-<name> (making it when missing),
                waits at most LOCK_WAIT_SECONDS for its flock, then
                truncates and writes it.
    @deps       open_regular, flock_within, now_iso; fcntl, os; MAIL,
                LOCK_HELD_WORDS.
    @complexity O(d) over d characters of `detail`, plus at most
                LOCK_WAIT_SECONDS of waiting.
    @alloc      the text, freed on return; one descriptor, closed on
                return; the marker file, kept (never removed).
    """
    marker = MAIL / f".ring-pending-{name}"
    try:
        fd = open_regular(marker, os.O_WRONLY)
    except (OSError, ValueError) as err:
        return err.strerror if isinstance(err, OSError) and err.strerror else str(err)
    try:
        with open(fd, "w") as f:
            if not flock_within(f, fcntl.LOCK_EX):  # SHARED fix round 2 (Claude Opus 5.5, unreviewed): D20
                return LOCK_HELD_WORDS.format(what=marker)
            f.truncate(0)
            f.write(f"{state}\n{now_iso()} {detail}\n")
    except OSError as err:
        return err.strerror
    return None


def ring_marker_problem(marker):
    """Words when something that is not a regular file sits at the ring marker's name (D17, D19); None when it is one, or nothing is there.

    @interacts  lstats `marker`. Writes nothing.
    @deps       os, stat.
    @complexity O(1).
    @alloc      none.
    """
    try:
        mode = os.lstat(marker).st_mode
    except FileNotFoundError:
        return None
    if stat.S_ISLNK(mode):
        return "is a symlink, which tc never follows"
    if not stat.S_ISREG(mode):
        return "is not a regular file, which tc never opens"
    return None


def ring_owed(marker):
    """True when the marker says a ring is owed: there and not RING_CLEAR on its first line, or there and unreadable (D14, D20).

    Nothing at the name owes nothing. A marker read_regular_file will not
    read owes a ring, as D14 has it: the send rings rather than lose a
    wake.

    @interacts  reads `marker` through read_regular_file. Writes nothing.
    @deps       read_regular_file; RING_CLEAR, RING_MARKER_READ_MAX_BYTES.
    @complexity O(1): one short file.
    @alloc      the marker's text, freed on return.
    """
    try:
        state = read_regular_file(marker, RING_MARKER_READ_MAX_BYTES).partition("\n")[0]
    except FileNotFoundError:
        return False
    except (OSError, ValueError):
        return True
    return state != RING_CLEAR


def ring_backoff(marker):
    """When the last ring timed out under RING_BACKOFF_SECONDS ago: that time (the marker's mtime). Else None.

    Only a marker whose first line is RING_TIMED_OUT holds a ring back. Its
    time is the file's mtime, set when the timeout rewrote it, and its age
    is read on wall_clock(). A marker dated after now (the clock was set
    back) holds nothing, so a clock change cannot stop rings for long. A
    marker that cannot be read holds nothing either: the send rings, as
    D14 has it. It is read through read_regular_file, so a FIFO or a link
    at its name never blocks the send that holds the inbox lock.

    @interacts  reads (read_regular_file) and stats `marker`; reads the
                clock (wall_clock). Writes nothing.
    @deps       read_regular_file, wall_clock; RING_TIMED_OUT,
                RING_BACKOFF_SECONDS, RING_MARKER_READ_MAX_BYTES.
    @complexity O(1): one short file.
    @alloc      the marker's text, freed on return.
    """
    try:
        state = read_regular_file(marker, RING_MARKER_READ_MAX_BYTES).partition("\n")[0]
        stamp = marker.stat().st_mtime
    except (OSError, ValueError):
        return None
    if state == RING_TIMED_OUT and 0 <= wall_clock() - stamp < RING_BACKOFF_SECONDS:
        return stamp
    return None


# P3 fix round 1b (Claude Opus 5.5, unreviewed): D35 (2) and D36 (1), each
# sender's own last-ring record (C2 item 5).
def rang_long_ago(to):
    """True when this Linux user's own last ring to `to` was RING_BACKOFF_SECONDS ago or more, or its record says nothing a send can trust: missing, unreadable, not this user's own regular file, or dated after now (the clock was set back). False only when this user rang `to` less than RING_BACKOFF_SECONDS ago.

    The record is outbox/<user>/RANG_RECORD_NAME, its mtime the time of
    the ring, read against wall_clock() (C2 item 5). The branch is opened
    by its path with FOLDER_FLAGS (its last name never followed; outbox/
    is the init user's, D34) and must be a folder this user owns; the
    record is lstat()ed by name in it, never followed. Whatever cannot be
    trusted counts as old: a ring too many, never a lost wake (D14).

    @interacts  opens and fstats this user's outbox branch, lstats one
                name in it; reads this process's user id and the clock
                (wall_clock). Writes nothing.
    @deps       outbox_branch, wall_clock; os, stat; FOLDER_FLAGS,
                RANG_RECORD_NAME, RING_BACKOFF_SECONDS.
    @complexity O(1).
    @alloc      one descriptor, closed before return.
    """
    try:
        fd = os.open(outbox_branch(), FOLDER_FLAGS)
    except OSError:
        return True
    try:
        st = os.fstat(fd)
        if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid():
            return True
        try:
            record = os.stat(RANG_RECORD_NAME.format(to=to), dir_fd=fd, follow_symlinks=False)
        except OSError:
            return True
    finally:
        os.close(fd)
    if not stat.S_ISREG(record.st_mode) or record.st_uid != os.geteuid():
        return True
    age = wall_clock() - record.st_mtime
    return age < 0 or age >= RING_BACKOFF_SECONDS


def write_rang_record(to):
    """Write this Linux user's own last-ring record for `to`, outbox/<user>/RANG_RECORD_NAME, its mtime set to wall_clock(): None when written, else a warning in words. A send calls it before it rings, as it writes the marker (C2 item 5).

    The branch is made or found and checked by D33's branch checks
    (claim_branch: this user's own real folder, and under a shared
    mailbox in its group with no group write), then opened by its path
    with FOLDER_FLAGS and judged again on its descriptor (branch_problem).
    The record is opened by name in it with O_NOFOLLOW and O_NONBLOCK,
    made at RANG_RECORD_MODE (an own one at another mode is set to it
    through its descriptor), and its time is set through the descriptor.
    A squatted branch, or a record that cannot be written, is a warning:
    the next send from this user finds it missing or old and rings, a
    ring too many, never a lost wake (D14).

    @interacts  reads ROOT/.shared and the group database, makes or finds
                outbox/ and this user's branch (claim_branch); opens and
                fstats the branch; creates or opens the record by name in
                it, may fchmod it, and sets its times; reads the clock
                (wall_clock).
    @deps       outbox_branch, claim_branch, branch_problem, wall_clock;
                os, stat; FOLDER_FLAGS, RANG_RECORD_NAME, RANG_RECORD_MODE.
    @complexity O(1), plus claim_branch's (at most two levels).
    @alloc      the record, made on the first ring and kept (an empty file
                whose mtime is the time); two descriptors, closed before
                return; the words, on a failure.
    """
    branch = outbox_branch()
    path = branch / RANG_RECORD_NAME.format(to=to)
    lost = f"so this user's next send to {to} rings again"
    try:
        share = claim_branch(branch)
        fd = os.open(branch, FOLDER_FLAGS)
    except OSError as err:
        return f"{path} could not be written ({err.strerror}), {lost}"
    try:
        problem = branch_problem(branch, os.fstat(fd), share, True)
        if problem is not None:
            return f"{path} could not be written ({problem}), {lost}"
        record = os.open(path.name, os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK, RANG_RECORD_MODE,
                         dir_fd=fd)
        try:
            st = os.fstat(record)
            if not stat.S_ISREG(st.st_mode):
                return f"{path} could not be written (it is not a regular file), {lost}"
            if stat.S_IMODE(st.st_mode) != RANG_RECORD_MODE:
                os.fchmod(record, RANG_RECORD_MODE)
            now = wall_clock()
            os.utime(record, (now, now))
        finally:
            os.close(record)
    except OSError as err:
        return f"{path} could not be written ({err.strerror}), {lost}"
    finally:
        os.close(fd)
    return None


# CARDS R4 (Claude Opus 5.5, unreviewed): the codex route, a doorbell (D3).
# CARDS fix round 1 (Claude Opus 5.5, unreviewed): D14, a failed ring is never lost.
# Phase fix round 1 (Claude Opus 5.5, unreviewed): D16, the marker before the
# ring, and the backoff after a timeout.
def deliver_codex(card, sender, to, body, header_note=None, *, deadline=None, on_landed=None, busy_on_passing=False):
    """Route codex: deliver_local under the inbox lock, then ring the Codex thread when a wake is owed.

    A listener started inside Codex dies when its command returns (D3), so
    a Codex session is woken by `codex queue`, which hands its thread a
    line to act on when its turn ends or the session is resumed.

    Under mail/.box-<to>.lock, held alone (D14): count unread, read the
    marker mail/.ring-pending-<to>, deliver, and decide. A ring is owed
    when the inbox held no unread mail before this send (one ring per
    batch) or the marker says one is owed (ring_owed: there and not
    RING_CLEAR): an earlier ring failed, a sender died while it rang, or
    `tc join` found mail waiting (D16). The ring is held
    instead when the marker says the last ring timed out under
    RING_BACKOFF_SECONDS ago (D16): the marker is kept as it is, and the
    warning says when a send rings again. When a ring is owed, the marker
    is written (RING_RINGING) before the lock is released, so a sender
    killed mid-ring leaves it for the next send. So two quick sends to an
    empty inbox may both ring: the second finds the first one's marker.
    That is two doorbells and one read, harmless, and it is what keeps a
    wake from being lost; do not "fix" it back.

    The ring runs after the lock is released, so a slow ring never holds
    up `tc read`. A ring that exits 0 rewrites the marker as RING_CLEAR;
    it is never removed (D20 item 5, SHARED fix round 1, Claude Opus 5.5,
    unreviewed). A timeout
    rewrites it as RING_TIMED_OUT, which starts the backoff; every other
    failure rewrites it as RING_FAILED, and the next send rings again:
    codex exiting non-zero, codex missing, or a card whose thread_id is
    missing or not a thread id, which is never handed to codex. The mail
    is in the inbox either way, so the send still exits 0. A marker that
    cannot be written before the ring is not said on its own: if the ring
    then fails, the second write fails the same way and its warning says
    a later send may not ring.

    A symlink at the marker's name is refused (D17): Delivery exit 1,
    words, nothing sent and nothing rung, so no member can point the
    marker at a file another user's send would then replace or read. So
    is a FIFO or anything else that is not a regular file (D19).

    SSH fix round 1 (Claude Opus 5.5, unreviewed): D33 part 3.
    `on_landed` goes to deliver_local, which calls it once the message is
    published, under the inbox lock, so the far gate's origin id is filed
    before the ring runs.

    P3 fix round 1a (Claude Opus 5.5, unreviewed): D35 and the audit's
    HIGH-1. The inbox is opened once under the lock (pinned_inbox, which
    refuses a bad one, exit 1, as deliver_local did), and the count
    before, the publish (deliver_local, handed this Inbox) and the count
    after all happen in that one open folder (unread_count), never by a
    path. So the ring decision always counts the folder the message
    lands in, and a swap mid-send leads none of the three elsewhere. A
    private inbox the send makes (it was not there to pin) is counted
    after in its own descriptor, opened then.

    P3 fix round 1b (Claude Opus 5.5, unreviewed): D35 (2), D36 (1) and
    the audit's MEDIUM-1, the doorbell can't be switched off (C2 item 5).
    The steps above, and the ring, are ring_doorbell's, which a retry of a
    message the far gate already delivered shares (the audit's LOW-1). A
    send also rings whenever this sender's own last ring to `to` is
    RING_BACKOFF_SECONDS old or more, whatever the marker says; see
    ring_doorbell's block for the rule and its cost.

    P3 fix round 1c (Claude Opus 5.5, unreviewed): D36 (4).
    `busy_on_passing` goes to deliver_local (the far gate's, so a write
    that fails for a reason that passes is exit 10).

    @interacts  see ring_doorbell, with this send's message written
                through deliver_local in the inbox ring_doorbell opened.
    @deps       ring_doorbell, deliver_local.
    @complexity as ring_doorbell's, plus O(b) over b bytes of body.
    @alloc      as ring_doorbell's; one message file, kept.
    """
    def land(inbox):
        return deliver_local(card, sender, to, body, header_note, deadline=deadline, on_landed=on_landed, inbox=inbox,
                             busy_on_passing=busy_on_passing)
    return ring_doorbell(card, sender, to, land, deadline=deadline)


# P3 fix round 1b (Claude Opus 5.5, unreviewed): D35 (2) and D36 (1), the
# ring decision a fresh landing and a gate's retry share (C2 item 5, LOW-1).
def ring_doorbell(card, sender, to, land=None, *, deadline=None, already=None):
    """The codex route's doorbell for `to` (its `card`), after a landing: a Delivery. `land`, given the open Inbox, lands this send's message and returns its Delivery (a fresh send, deliver_codex); None means nothing lands now and `already` is the Delivery to answer with (a retry whose origin id the far gate already filed, deliver_once).

    Under mail/.box-<to>.lock, held alone (D14): read the marker, open the
    inbox once (pinned_inbox), count, land, count again, and decide. A
    fresh landing rings (C2 steps 1 to 5) when the inbox held no unread
    mail before it, or the marker says a ring is owed (ring_owed), unless
    a timed-out ring holds the backoff (ring_backoff); and, whatever the
    marker says (clear, timed out, or freshly touched), whenever this
    sender's own last ring to `to` is RING_BACKOFF_SECONDS old or older,
    or its record is missing, unreadable or dated after now
    (rang_long_ago, D35 (2), D36 (1)). The marker is group-writable, so
    its words and its time can be forged by any member; the record is in
    this Linux user's own branch, which only it can write, so a member
    can hold off only their own rings. The cost, accepted: at most one
    ring per sender per name per backoff while unread mail waits, and on
    a dead Codex one CODEX_RING_SECONDS wait per sender per backoff
    instead of one in all.

    A retry (the audit's LOW-1) runs the same rule with nothing landing:
    step 1's "the inbox held nothing before" has no before, so it reads
    False, and a ring needs unread mail now. So a far gate killed after
    it filed the origin id and before its ring is rung by the near side's
    retry (the marker it wrote before the ring says owed), and a retry
    after a ring that went through rings nothing. A retry never refuses:
    a bad marker or inbox only skips the ring, with a warning for the
    marker, and the retry still answers `already`.

    When a ring is owed, the marker is written (RING_RINGING) and this
    sender's record (write_rang_record, D33's branch checks) before the
    lock is released, so a sender killed mid-ring leaves both for the
    next send; two quick sends may both ring: two doorbells, one read,
    harmless, and what keeps a wake from being lost. The ring runs after
    the lock is released (ring_codex), so a slow ring never holds up a
    tc read, and the marker is rewritten by the outcome: RING_CLEAR on
    exit 0, RING_TIMED_OUT (the backoff) or RING_FAILED. A fresh send with
    a symlink, FIFO or anything but a regular file at the marker's name
    is refused, Delivery exit 1, nothing sent (D17, D19).

    @interacts  holds mail/.box-<to>.lock (inbox_lock: busy past
                `deadline`, exit 10, nothing landed or rung) while it
                lstats and reads the marker, opens mail/, the inbox and
                its read/ (pinned_inbox, refusing a bad one for a fresh
                send only), counts the inbox's messages in its descriptor,
                calls `land`, opens this user's outbox branch and lstats
                its record (rang_long_ago), and when a ring is owed writes
                the marker (write_ring_marker) and the record
                (write_rang_record: may make outbox/ and the branch);
                then, released, rings (ring_codex: one `codex queue` run,
                at most CODEX_RING_SECONDS) and rewrites the marker. Reads
                the clock through wall_clock.
    @deps       lock_deadline, inbox_lock, ring_marker_problem,
                pinned_inbox, unread_count, ring_owed, ring_backoff,
                rang_long_ago, write_ring_marker, write_rang_record,
                ring_codex, clock_words, wall_clock, Delivery;
                RING_RINGING, RING_FAILED, RING_TIMED_OUT, RING_CLEAR,
                RING_BACKOFF_SECONDS, EXIT_REFUSED.
    @complexity O(U + u log u) over U names in the inbox and the u of
                them that are messages (listed and counted twice), plus
                `land`'s, plus one codex run of at most CODEX_RING_SECONDS
                per ring: at most one per sender per name per
                RING_BACKOFF_SECONDS while mail waits unread. The inbox
                lock and mail/.seq wait at most LOCK_WAIT_SECONDS in all
                (one deadline); each marker write, before and after the
                ring, at most LOCK_WAIT_SECONDS of its own.
    @alloc      the ring's words, freed on return; the marker file and
                this sender's record, kept (never removed); two
                descriptors while the lock is held.
    """
    marker = MAIL / f".ring-pending-{to}"
    fresh = land is not None
    if deadline is None:  # SHARED fix round 4 (Claude Opus 5.5, unreviewed): LOW-3, the command's own when given
        deadline = lock_deadline()  # SHARED fix round 3 (Claude Opus 5.5, unreviewed): LOW-2, one per command
    with inbox_lock(to, deadline=deadline):
        bad = ring_marker_problem(marker)  # SHARED D17 (Claude Opus 5.5, unreviewed): a planted link; D19 a FIFO
        if bad is not None:
            if fresh:
                return Delivery(EXIT_REFUSED, f"tc send: {marker} {bad}; nothing sent", [])
            return Delivery(already.exit, already.words, already.warnings + [f"{marker} {bad}, so {to} was not rung"])
        with pinned_inbox(to, check=fresh) as inbox:  # P3 fix round 1a (Claude Opus 5.5, unreviewed): D35, one folder
            waiting = unread_count(to, inbox)
            owed = ring_owed(marker)  # SHARED fix round 1 (Claude Opus 5.5, unreviewed): D20, the state, not the file
            held = ring_backoff(marker) if owed else None
            landed = land(inbox) if fresh else already
            # A private inbox this send made was not there to pin: it is counted in its own, fresh.
            count = unread_count(to, inbox if inbox.box.fd is not None else None) if fresh else waiting
        old = landed.exit == 0 and count > 0 and rang_long_ago(to)  # P3 fix round 1b (Claude Opus 5.5, unreviewed): C2 item 5
        if fresh:
            ring = landed.exit == 0 and ((held is None and (owed or not waiting)) or old)
        else:
            ring = count > 0 and ((owed and held is None) or old)
        record = None
        if ring:
            write_ring_marker(to, RING_RINGING, f"a send from {sender} is ringing")
            record = write_rang_record(to)  # P3 fix round 1b (Claude Opus 5.5, unreviewed): before the ring, as the marker
    if landed.exit != 0:
        return landed
    words, warnings = [landed.words], list(landed.warnings) + ([record] if record is not None else [])
    if not ring:
        if held is not None and count > 0:
            warnings.append(f"ring pending for {to}: the last ring timed out at {clock_words(held)}; "
                            f"a send after {clock_words(held + RING_BACKOFF_SECONDS)} rings again")
        return Delivery(landed.exit, landed.words, warnings)
    failure = ring_codex(card, sender, to, count)
    if failure is None:
        words.append(f"rang codex {to} (queued; delivered when its turn ends or the session is resumed)")
        problem = write_ring_marker(to, RING_CLEAR, f"a send from {sender} rang")  # SHARED fix round 1 (Claude Opus 5.5, unreviewed): D20
        if problem is not None:
            warnings.append(f"rang codex {to}, but {marker} could not be cleared ({problem}); "
                            f"the next send to {to} may ring again")
        return Delivery(landed.exit, "\n".join(words), warnings)
    problem = write_ring_marker(to, RING_TIMED_OUT if failure.timed_out else RING_FAILED, failure.reason)
    if problem is not None:
        warnings.append(f"ring failed for {to}: {failure.reason}; the mail is in its inbox; {marker} could "
                        f"not be written ({problem}), so a later send may not ring")
    elif failure.timed_out:
        try:
            stamp = marker.stat().st_mtime
        except OSError:
            stamp = wall_clock()
        warnings.append(f"ring failed for {to}: {failure.reason}; the mail is in its inbox; "
                        f"a send after {clock_words(stamp + RING_BACKOFF_SECONDS)} rings again")
    else:
        warnings.append(f"ring failed for {to}: {failure.reason}; the mail is in its inbox; "
                        f"the next send to {to} rings again")
    return Delivery(landed.exit, "\n".join(words), warnings)


# CARDS fix round 1 (Claude Opus 5.5, unreviewed): the ring, apart from its bookkeeping.
def ring_codex(card, sender, to, count):
    """Ring the Codex thread named on `card` once. None when codex exits 0, else a RingFailure.

    The RingFailure says why not, in words, and whether codex ran past
    CODEX_RING_SECONDS (timed_out), which is all the caller's backoff
    needs (D16). A thread_id that is missing, or is not a str of
    THREAD_ID_PATTERN's shape, never reaches codex's argv (D14): the
    words say which. The line names the mailbox root as well as tc, both
    quoted, so a Codex session whose own default root differs reads and
    replies in this one. codex runs in a session of its own: past
    CODEX_RING_SECONDS its whole process group is killed, so a child it
    started (a node CLI's native codex) is not left behind. Its output is
    decoded with errors="replace", so odd bytes never fail a send.

    Known limit (D17, documented, not fixed): codex runs as the sending
    Linux user. Under a shared mailbox (C4), a Codex session run by
    another Linux user is probably not reachable by its ring, since its
    threads live under that user's home. The ring fails, the marker stays
    and the backoff holds (D16), and the mail still lands in the inbox.

    @interacts  when the thread_id passes, starts `codex queue --thread
                <thread_id> --message <C2's line>` in a new session with
                stdin from /dev/null, reads its stdout and stderr until it
                exits or CODEX_RING_SECONDS pass, then SIGKILLs its process
                group (that group only) and reaps it. Writes nothing.
    @deps       THREAD_ID_PATTERN, CODEX_RING_SECONDS, ROOT, RingFailure;
                subprocess, os, signal, shlex, pathlib; the `codex` CLI on
                PATH.
    @complexity O(t) over t characters of the thread_id, plus one codex run
                of at most CODEX_RING_SECONDS.
    @alloc      the message and codex's captured output, freed on return;
                one child and its two pipes, closed and reaped on return;
                one RingFailure on a failure.
    """
    thread = card.get("thread_id") if card else None
    if thread is None or thread == "":
        return RingFailure("its card has no thread_id", False)
    if not isinstance(thread, str) or not THREAD_ID_PATTERN.fullmatch(thread):
        return RingFailure("its card's thread_id is not a thread id", False)
    # CARDS fix round 1 (Claude Opus 5.5, unreviewed): the root in the line, a session of its own, odd bytes.
    run = f"TC_ROOT={shlex.quote(str(ROOT.resolve()))} {shlex.quote(str(pathlib.Path(__file__).resolve()))}"
    message = (f"MAIL: {count} unread for {to}. Run: {run} read {to}, act on it, "
               f"reply with {run} send --from {to} --to {sender}.")
    try:
        with subprocess.Popen(["codex", "queue", "--thread", thread, "--message", message],
                              stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                              stderr=subprocess.PIPE, encoding="utf-8", errors="replace",
                              start_new_session=True) as proc:
            try:
                _, said = proc.communicate(timeout=CODEX_RING_SECONDS)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(proc.pid, signal.SIGKILL)  # its own group: start_new_session
                except ProcessLookupError:
                    pass  # every process in the group is already gone
                proc.wait()
                return RingFailure(f"no answer in {CODEX_RING_SECONDS} s", True)
    except OSError as err:
        return RingFailure(f"could not run codex ({err.strerror})", False)
    if proc.returncode != 0:
        lines = said.strip().splitlines()
        return RingFailure(lines[0] if lines else f"codex exited {proc.returncode} with no stderr", False)
    return None


# ---------- ssh route: deliver_ssh and the outbox (C3, D22, D23, D25) ----------
# SSH S1 (Claude Opus 5.5, unreviewed). Every ssh send leaves a record: it
# is published into outbox/<user>/to-<to>/ first (the sender's own branch,
# D32; SSH fix round 1, Claude Opus 5.5, unreviewed), then sent, then
# filed in sent/ or refused/ by the far tc's answer.

# Where an ssh card sends: its target (user@host or host), the far tc's
# path as the first word of the remote command (C3's quoting), and why the
# card cannot be used (None when it can; then the other two are None).
SshWhere = collections.namedtuple("SshWhere", "target remote why")
# How one ssh run came out (ssh_run): kind is SSH_SENT, SSH_KEPT or
# SSH_REFUSED; code the exit code (None when ssh never finished); out and
# err the far side's stdout and stderr; reason, for a kept message, why in
# words. SSH fix round 1 (Claude Opus 5.5, unreviewed): the audit's
# MEDIUM-4. out and err are at most SSH_OUTPUT_MAX_BYTES each, and cut
# names the streams that held more ("stdout", "stderr"), which tc says.
SshOutcome = collections.namedtuple("SshOutcome", "kind code out err reason cut")
# What ssh_capture hands back: the exit code (None when the run passed
# SSH_SEND_SECONDS and was killed), the kept stdout and stderr, decoded,
# and the names of the streams it cut.
Captured = collections.namedtuple("Captured", "code out err cut")
# One message waiting directly in an outbox/<user>/to-<to>/: its number and
# sender (from its name), the name it is for, its path and its lstat
# result.
OutboxFile = collections.namedtuple("OutboxFile", "n sender to path st")


# SSH fix round 1 (Claude Opus 5.5, unreviewed): D32 and D33 part 1, the
# audit's HIGH-1 and DEBT-1. One helper names a branch and one a queue, so
# the layout is spelled in one place.
def branch_user(uid=None):
    """The name of user `uid`'s branch (None: this process's effective user): that user's login, or the number as text when the machine has no such user.

    @interacts  reads this process's user id and the user database.
    @deps       user_name; os.
    @complexity O(1): one lookup.
    @alloc      one short string, returned.
    """
    return user_name(os.geteuid() if uid is None else uid)


def outbox_branch(uid=None):
    """outbox/<user>/ for user `uid` (None: this process's user): the one folder that user's ssh mail waits and is filed under (C3, D32).

    @interacts  reads the user database (branch_user).
    @deps       branch_user; ROOT, OUTBOX_NAME.
    @complexity O(1).
    @alloc      one path, returned.
    """
    return ROOT / OUTBOX_NAME / branch_user(uid)


def outbox_queue(to, uid=None):
    """outbox/<user>/to-<to>/: where user `uid`'s (None: this process's user's) ssh mail to `to` waits, with its sent/ and refused/ below (C3, D25, D32).

    @interacts  reads the user database (branch_user).
    @deps       outbox_branch.
    @complexity O(1).
    @alloc      one path, returned.
    """
    return outbox_branch(uid) / f"to-{to}"


def init_user_name():
    """The login of the user who ran init: the owner of ROOT/.shared, or of outbox/ when there is no .shared to look at (a private mailbox).

    @interacts  lstats ROOT/.shared, or outbox/; reads the user database.
    @deps       user_name; os; ROOT, SHARED_MARKER_NAME, OUTBOX_NAME.
    @complexity O(1): at most two lstats.
    @alloc      one short string, returned.
    """
    for path in (ROOT / SHARED_MARKER_NAME, ROOT / OUTBOX_NAME):
        try:
            return user_name(os.lstat(path).st_uid)
        except OSError:
            continue
    return "the owner of the mailbox"


def clearer(path):
    """Who may move the entry at `path` aside, in words: the owner of the sticky folder it sits in (outbox/ is the init user's; so is mail/.origins/ once init made it, P3 fix round 1c, else its first filer's), named as the user who ran init when it is.

    @interacts  lstats `path`'s folder (and ROOT/.shared, init_user_name);
                reads the user database.
    @deps       init_user_name, user_name; os.
    @complexity O(1).
    @alloc      one short string, returned.
    """
    init = init_user_name()
    try:
        owner = user_name(os.lstat(path.parent).st_uid)
    except OSError:
        owner = init
    return f"The user who ran init ({init})" if owner == init else f"{owner}, who owns {path.parent},"


def aside_path(path):
    """Where `path` goes when it is moved aside: SQUATTED_NAME in its own folder, k the first count from 1 that nothing holds there.

    @interacts  lstats each name tried (os.path.lexists). Writes nothing.
    @deps       os; SQUATTED_NAME.
    @complexity O(k) over k names already taken (none, in practice).
    @alloc      one path per name tried; the free one, returned.
    """
    k = 1
    while os.path.lexists(path.parent / SQUATTED_NAME.format(name=path.name, k=k)):
        k += 1
    return path.parent / SQUATTED_NAME.format(name=path.name, k=k)


def branch_problem(path, st, share, top_level):
    """Why the folder at `path` (its lstat result `st`) cannot hold this user's mail, in words, or None when it is this user's own real folder (D32, D33).

    Refused: a link, anything but a folder, a folder another user owns,
    and, under a shared mailbox (`share`), a folder in another group or
    one its group or anyone else may write. The words name the owner and
    the one command that clears it: a `mv -T` aside (aside_path), run,
    when `top_level` (the branch itself, in outbox/ or mail/.origins/,
    sticky folders where only their owner and the entry's may rename),
    by that folder's owner (clearer: for outbox/, the user who ran init),
    else by this user, in whose own branch it sits. A folder of this
    user's own in the wrong group or mode is fixed
    by this user's own tc init (OWN_FIX_WORDS). tc prints a `mv -T` line
    and no other: rename(2) moves the name itself, never what a link at it
    leads to, and -T never moves it into a folder that already has the
    new name.

    @interacts  reads this process's user id and the user database;
                lstats names beside `path` and its folder (aside_path,
                clearer). Writes nothing.
    @deps       aside_path, clearer, user_name, group_name, printable; os,
                stat; OWN_FIX_WORDS.
    @complexity O(1), plus aside_path's.
    @alloc      the words, returned.
    """
    me = os.geteuid()
    if stat.S_ISLNK(st.st_mode):
        what = "is a symlink, which tc never follows"
    elif not stat.S_ISDIR(st.st_mode):
        what = "is not a folder"
    elif st.st_uid != me:
        what = f"belongs to {user_name(st.st_uid)}, not to {user_name(me)}"
    else:
        what = None
    if what is not None:
        if top_level:
            who = f"{clearer(path)} clears it with one command"
        else:
            who = "It sits in your own branch, so you clear it with one command"
        return (f"{path} {what}: a branch and every folder in it are their member's alone (D32, D33), so tc "
                f"wrote nothing there. {who}: mv -T {path} {aside_path(path)}")
    mode = stat.S_IMODE(st.st_mode)
    if share is not None and st.st_gid != share.gid:
        what = f"is in group {printable(group_name(st.st_gid))}, not {printable(share.group)}"
    elif share is not None and mode & (stat.S_IWGRP | stat.S_IWOTH):
        what = f"is {mode:04o}: others may write in it, so it is no branch of yours (D33)"
    else:
        return None
    return (f"{path} {what}; tc wrote nothing there. Its owner, you, "
            f"{OWN_FIX_WORDS.format(group=printable(share.group))}.")


def claim_branch(path):
    """Make, or find, each folder from this user's outbox branch down to `path` (the branch or a folder in it), checking each before anything is made in it: the mailbox's Share, or None when private. Raises OSError, its words in strerror.

    The audit's HIGH-1, conditions (a) and (b). outbox/ is made when
    missing (it is the init user's, C4; its owner is not checked). Then,
    top down, each level below it: a missing one is made as this user
    (make_folder_with, raising: SHARED_BRANCH_MODE under a shared
    mailbox), and each, made or found, is lstat()ed and must be this
    user's own real folder (branch_problem) before the next is made in
    it. So nothing is ever made in a folder another member owns, and a
    member who made outbox/<user>/ first, or planted a link there, gets
    words naming them and the one command that clears it, never this
    user's mail.

    @interacts  reads ROOT/.shared and the group database
                (share_or_raise); lstats outbox/ and each level below it,
                making those missing (make_folder_with); reads the user
                database for the words. Raises OSError.
    @deps       share_or_raise, make_folder_with, branch_problem; os,
                errno; ROOT, OUTBOX_NAME.
    @complexity O(d) over d levels from the branch down to `path` (at most
                three: the branch, to-<name>/, sent/ or refused/).
    @alloc      the folders it makes, kept; one stat result per level.
    """
    share = share_or_raise()
    top = ROOT / OUTBOX_NAME

    def make(folder):
        try:
            make_folder_with(folder, share, raising=True)
        except FileExistsError:
            raise OSError(errno.ENOTDIR, f"{folder} is not a folder, so tc wrote nothing there") from None
    make(top)
    parts = path.relative_to(top).parts
    for depth in range(1, len(parts) + 1):
        level = top.joinpath(*parts[:depth])
        try:
            st = os.lstat(level)
        except FileNotFoundError:
            make(level)
            st = os.lstat(level)
        problem = branch_problem(level, st, share, depth == 1)
        if problem is not None:
            raise OSError(errno.EPERM, problem)
    return share


def squatted_branches():
    """Each branch named for a user of this machine that is not that user's own real folder, in outbox/ and mail/.origins/: a list of {"path", "why", "fix"}, for tc health (D33).

    A name counts as a branch when the user database has a login of that
    name; names starting with a dot (the origin token, a folder moved
    aside) never do. `why` says what is there instead (a link, not a
    folder, another user's folder); `fix` is the one command the owner of
    the folder it sits in runs (clearer: for outbox/, the user who ran
    init), a `mv -T` aside.

    @interacts  lists outbox/ and mail/.origins/, and lstats each entry
                named for a login and its folder; reads the user
                database. Writes nothing.
    @deps       aside_path, clearer, user_name; os, pwd, stat; ROOT, MAIL,
                OUTBOX_NAME, ORIGINS_NAME.
    @complexity O(e) over e entries in the two folders: one per member,
                plus the token and anything moved aside.
    @alloc      one dict per squatted branch, returned.
    """
    found = []
    for top in (ROOT / OUTBOX_NAME, MAIL / ORIGINS_NAME):
        try:
            names = sorted(os.listdir(top))
        except OSError:
            continue
        for name in names:
            if name.startswith("."):
                continue
            try:
                uid = pwd.getpwnam(name).pw_uid
                st = os.lstat(top / name)
            except (KeyError, OSError):
                continue
            if stat.S_ISLNK(st.st_mode):
                why = "a symlink"
            elif not stat.S_ISDIR(st.st_mode):
                why = "not a folder"
            elif st.st_uid != uid:
                why = f"a folder {user_name(st.st_uid)} owns"
            else:
                continue
            path = top / name
            found.append({"path": str(path), "why": f"{why}, not {name}'s own branch",
                          "fix": f"{clearer(path)} runs: mv -T {path} {aside_path(path)}"})
    return found


def ssh_where(card):
    """The SshWhere for an ssh card: its target and the remote command's first word, or why it cannot be used.

    C3: a remote path that starts with ~/ goes bare as ~/, the rest
    quoted (shlex.quote), since a quoted ~ never expands on the far side;
    any other path is quoted whole, so a space or a quote in it stays one
    word. A hand-made card is checked again here, as tc card checks it
    (C1): the target must match SSH_TARGET_PATTERN (no leading dash on
    either part, no spaces), and the path must be a string that starts
    with / or ~/, so ~ alone and ~user/... are refused, never guessed
    (D13). A card with no ssh field, or no tc path in it, is refused too:
    tc never guesses where the far tc lives.

    @interacts  none; reads the card dict.
    @deps       printable; shlex; SSH_TARGET_PATTERN, REMOTE_TC_PREFIXES.
    @complexity O(c) over c characters of the target and the path.
    @alloc      the quoted path and one SshWhere, returned.
    """
    ssh = card.get("ssh") if isinstance(card, dict) else None
    if not isinstance(ssh, dict):
        return SshWhere(None, None, "has no ssh field with a target and a tc path")
    target, path = ssh.get("target"), ssh.get("tc")
    if not isinstance(target, str) or not SSH_TARGET_PATTERN.fullmatch(target):
        return SshWhere(None, None, f'has a bad ssh target "{printable(target)}": user@host or host, no '
                                    f'leading dash on either part, no spaces')
    if not isinstance(path, str) or not path.startswith(REMOTE_TC_PREFIXES):
        return SshWhere(None, None, f'has a bad remote tc path "{printable(path)}": it starts with / or ~/, '
                                    f'and ~ alone or ~user/... is refused')
    remote = "~/" + shlex.quote(path[2:]) if path.startswith("~/") else shlex.quote(path)
    return SshWhere(target, remote, None)


def queue_route(to):
    """The SshWhere for `to`'s card as it stands now: where tc flush and the queue check send `to`'s outbox mail.

    The queue is keyed by target (C3), and a file's target is its `to`'s
    card at the time it is looked at. A card that is missing, unreadable
    or not route ssh gives why in words, so its mail stays in the outbox
    and is never sent another way.

    @interacts  reads cards/<to>.json (read_card). Writes nothing.
    @deps       read_card, ssh_where, printable; SshWhere.
    @complexity O(1): one small file.
    @alloc      one SshWhere, returned.
    """
    try:
        card = read_card(to)
    except ValueError as problem:
        return SshWhere(None, None, f"its card is unreadable ({problem})")
    if card is None:
        return SshWhere(None, None, f"{to} has no card now")
    if card.get("route") != "ssh":
        return SshWhere(None, None, f"{to}'s card no longer says ssh (it says route "
                                    f"{printable(card.get('route'))})")
    return ssh_where(card)


def owned_by_me(st):
    """True when the stat result `st` belongs to the Linux user running tc (D22: each member sends only their own outbox files).

    A function of its own so a test can stand a second member's file in
    for one this user owns: one user cannot make a file another user owns.

    @interacts  reads this process's effective user id.
    @deps       os.
    @complexity O(1).
    @alloc      none.
    """
    return st.st_uid == os.geteuid()


def outbox_files(branch, branch_fd=None):
    """Every message waiting directly in a to-<name>/ of the outbox branch `branch`, in queue order, as OutboxFiles; and (path, why) for each entry left out. `branch_fd`, when given, is the branch's open descriptor (other_branches); None opens it here.

    Only real folders named to-<name> with a C0 name are entered (never a
    link), and only regular files named NNNNNN-from-<sender>.md with a C0
    sender count (message_files: a link, a FIFO or a folder is left out
    with words). sent/ and refused/ are below, never listed here. Whoever
    owns a file, it is listed: the caller asks owned_by_me.

    SSH fix round 1 (Claude Opus 5.5, unreviewed): D32 and the audit's
    REC-12. One branch, outbox/<user>/, is listed (this user's, for a
    send or a flush; another member's, for flush's count of theirs),
    never the whole outbox, so a scan costs this user's own files. The
    audit's LOW-7: queue order is publish order, the file's mtime (which
    only its owner can set, in a branch no other member writes in), then
    its number, so a newer message whose number a set-back mail/.seq made
    lower still waits behind an older one.

    P3 fix round 1a (Claude Opus 5.5, unreviewed): D35 and the audit's
    HIGH-1. The branch is listed in its open descriptor (the caller's,
    or one opened here by its path with FOLDER_FLAGS: its last name never
    followed, the folder above it the init user's, D34), and each
    to-<name>/ is opened by its name in it (pin_folder) and listed and
    stat'ed in its own descriptor, never by a path. So another member who
    swaps their branch, or a queue in it, for a link after it was opened
    leads flush's count nowhere. The paths returned name the files for the
    caller's words, and for this user's own later moves of its own files.

    @interacts  opens `branch` when no descriptor is given; lists it,
                opens each to-<name>/ in it by name (pin_folder), lists
                each and stats each message name in it (message_files);
                closes every descriptor it opened. Writes nothing.
    @deps       pin_folder, unpin, message_files, valid_name; os;
                FOLDER_FLAGS, NOT_PINNED, MESSAGE_NAME_PATTERN, OutboxFile.
    @complexity O(q log q + w log w) over q entries in the branch (one per
                name this user ever sent to over ssh, a few dozen) and w
                files waiting in it (single digits, unless a target has
                been down a while): one listing per folder, one stat per
                message name, and the sorts.
    @alloc      two lists, returned; one descriptor for the branch (when
                opened here) and one per queue while it is listed.
    """
    found, left_out = [], []
    own = branch_fd is None  # P3 fix round 1a (Claude Opus 5.5, unreviewed): D35, opened once
    if own:
        try:
            branch_fd = os.open(branch, FOLDER_FLAGS)
        except FileNotFoundError:
            return found, left_out
        except OSError as err:
            return found, [(branch, f"tc could not list it ({err.strerror})")]
    try:
        try:
            names = os.listdir(branch_fd)
        except OSError as err:
            return found, [(branch, f"tc could not list it ({err.strerror})")]
        for entry in sorted(names):
            if not entry.startswith("to-"):
                continue
            box = branch / entry
            queue = pin_folder(branch_fd, entry, box) if valid_name(entry[len("to-"):]) else NOT_PINNED
            if queue.fd is None:
                left_out.append((box, queue.problem or "not a real folder named to-<name>, so tc never enters it"))
                continue
            try:
                messages, skipped, problem = message_files(box, queue.fd)
            finally:
                unpin(queue)
            left_out += skipped
            if problem is not None and not messages and not skipped:
                left_out.append((box, problem))
            for path, st in messages:
                named = MESSAGE_NAME_PATTERN.fullmatch(path.name)
                if named is None or not valid_name(named.group(2)):
                    left_out.append((path, "not named like a message (NNNNNN-from-<sender>.md)"))
                    continue
                found.append(OutboxFile(int(named.group(1)), named.group(2), entry[len("to-"):], path, st))
    finally:
        if own:
            os.close(branch_fd)
    found.sort(key=lambda f: (f.st.st_mtime_ns, f.n, str(f.path)))  # SSH fix round 1 (Claude Opus 5.5, unreviewed): LOW-7
    return found, left_out


@contextlib.contextmanager
def other_branches():
    """The outbox branches of every other member, each opened once, held open for the `with` block: yields a list of (path, descriptor), one per real folder directly in outbox/ but this user's own whose name starts with no dot (D32). Every descriptor is closed when the block ends.

    For tc flush's count of other members' waiting files (D22). Names
    starting with a dot (the origin token, a folder moved aside) are not
    branches. P3 fix round 1a (Claude Opus 5.5, unreviewed): D35 and the
    audit's HIGH-1. outbox/ is opened by its path (only the init user can
    swap it, D34) and each branch by its name in it (pin_folder), never
    through a link; the caller lists each in its descriptor
    (outbox_files). So a member who swaps their branch for a link or
    another folder after it was opened leads the count nowhere. A link,
    anything but a folder, and a folder this user cannot open are left
    out, as before.

    @interacts  opens and lists outbox/, opens each entry in it by name
                (pin_folder); reads the user database (branch_user);
                closes every descriptor. Writes nothing.
    @deps       branch_user, pin_folder; contextlib, os; ROOT,
                OUTBOX_NAME, TOP_FOLDER_FLAGS.
    @complexity O(m log m) over m entries in outbox/ (one per member).
    @alloc      one list of (path, descriptor), and one descriptor per
                branch, held for the block.
    """
    top, mine = ROOT / OUTBOX_NAME, branch_user()
    found = []
    try:
        try:
            top_fd = os.open(top, TOP_FOLDER_FLAGS)
        except OSError:
            top_fd = None
        if top_fd is not None:
            try:
                try:
                    names = sorted(os.listdir(top_fd))
                except OSError:
                    names = []
                for name in names:
                    if name.startswith(".") or name == mine:
                        continue
                    branch = pin_folder(top_fd, name, top / name)
                    if branch.fd is not None:
                        found.append((top / name, branch.fd))
            finally:
                os.close(top_fd)
        yield found
    finally:
        for _, fd in found:
            os.close(fd)


def queue_ahead(target, path):
    """How many of this user's own outbox messages for `target` wait ahead of the one just published at `path` ("queue order first", C3, D22).

    A file counts when this user owns it (owned_by_me), it is not `path`,
    and its `to`'s card points at `target` now (queue_route). Other
    members' files never count: each member's queue is their own, in
    their own branch (D32), and only this user's branch is listed.

    SSH fix round 1 (Claude Opus 5.5, unreviewed): the audit's LOW-7. Every
    other waiting file counts, whatever its number: with mail/.seq set
    back, a newer message can take a lower number than one already
    waiting, and counting only lower numbers let it go first. The caller
    holds the send lock and has published, so nothing it counts is sent
    meanwhile.

    @interacts  lists this user's outbox branch (outbox_files) and reads
                the card of each name with a file that could count.
                Writes nothing.
    @deps       outbox_files, outbox_branch, owned_by_me, queue_route.
    @complexity O(q + w log w) as outbox_files, plus one card read per
                name among the files counted.
    @alloc      the outbox lists and one dict of routes, freed on return.
    """
    routes, ahead = {}, 0
    for f in outbox_files(outbox_branch())[0]:
        if f.path == path or not owned_by_me(f.st):
            continue
        if f.to not in routes:
            routes[f.to] = queue_route(f.to)
        ahead += routes[f.to].target == target
    return ahead


@contextlib.contextmanager
def send_lock(target):
    """Hold this user's send lock for `target` for the `with` block: yields (held, why).

    outbox/<user>/SEND_LOCK_NAME, one per Linux user per target, so one tc
    at a time sends a user's queue for a target, in order, and never sends
    one file twice at once. held is True once the flock is held; False
    when it was not taken within SEND_LOCK_WAIT_SECONDS (flock_within:
    another send or a flush is sending to that target), with why None; or
    False with words
    when the branch is not this user's own (claim_branch) or the lock file
    would not open (a link or a FIFO at its name, D17, D19: open_regular
    refuses both). It never exits here: a caller that cannot hold it
    still publishes its message and keeps it in the outbox (deliver_ssh,
    exit 4), or leaves the target for the next flush (cmd_flush).

    SSH fix round 1 (Claude Opus 5.5, unreviewed): D33 part 2, the audit's
    LOW-3. The lock lives in this user's own branch, which no other member
    can write in, so nobody can plant a link or a FIFO at its name; it is
    made SEND_LOCK_MODE, its owner's alone, so nobody else can open it and
    hold its flock. Init finds it already right (shared_file_mode).

    The lock is held through the ssh run, which may take
    SSH_SEND_SECONDS. SSH fix round 1 (Claude Opus 5.5, unreviewed): the
    audit's LOW-9. Nobody waits on it past SEND_LOCK_WAIT_SECONDS, the
    holder's one ssh run and its filing, not the command's lock deadline
    (only this member's own tc can hold it now): a send that overlaps
    another send's run goes once that run ends, and one that finds a long
    flush holding it keeps its message queued for that flush; a flush
    that cannot take it leaves that target for the next flush. Neither
    the inbox locks nor mail/.seq is ever held while ssh runs.

    @interacts  reads ROOT/.shared, makes or finds this user's outbox
                branch and checks it (claim_branch); opens or makes
                outbox/<user>/.send-<key>.lock (open_regular) and waits
                for its flock at most SEND_LOCK_WAIT_SECONDS
                (flock_within); the kernel drops it when the block ends or
                the process dies. Reads the monotonic clock.
    @deps       claim_branch, outbox_branch, open_regular, flock_within;
                contextlib, fcntl, hashlib, os, time; SEND_LOCK_NAME,
                SEND_LOCK_KEY_CHARS, SEND_LOCK_MODE, SEND_LOCK_WAIT_SECONDS.
    @complexity O(t) over t characters of the target, plus waiting
                SEND_LOCK_WAIT_SECONDS at most.
    @alloc      one open lock file for the block; the lock file, made on
                first use and kept.
    """
    branch = outbox_branch()
    try:
        claim_branch(branch)
    except OSError as err:
        yield False, err.strerror
        return
    key = hashlib.sha256(target.encode()).hexdigest()[:SEND_LOCK_KEY_CHARS]
    path = branch / SEND_LOCK_NAME.format(key=key)
    try:
        fd = open_regular(path, os.O_WRONLY | os.O_APPEND, SEND_LOCK_MODE)
    except (OSError, ValueError) as err:
        why = "it is a symlink" if isinstance(err, OSError) and err.errno == errno.ELOOP else (
            err.strerror if isinstance(err, OSError) and err.strerror else str(err))
        yield False, f"tc could not open the send lock {path} ({why})"
        return
    with open(fd, "a") as lock:
        yield flock_within(lock, fcntl.LOCK_EX, time.monotonic() + SEND_LOCK_WAIT_SECONDS), None


def origin_token():
    """This mailbox's origin token (D25): 2 x ORIGIN_TOKEN_BYTES hex digits, made once at outbox/ORIGIN_TOKEN_NAME and read back by every later ssh send (tc flush reads each id from its message's header, SSH fix round 1).

    Made from os.urandom, never from the hostname. Published like a
    message: written whole to a .tmp of this process's own, hard-linked
    to its name (which never replaces a token another send made first,
    and then that one is the mailbox's), and the .tmp removed. Raises
    ValueError, with words naming the file, when it is not a regular
    file holding one line of hex (a hand-made or planted one: tc never
    replaces it), and OSError when it cannot be made. P3 fix round 1c
    (Claude Opus 5.5, unreviewed): the audit's LOW-11. A .tmp whose write
    fails is removed by write_new_file before the OSError reaches here,
    so no .tmp is left either way.

    @interacts  reads ROOT/.shared and makes outbox/ (make_folder); reads
                outbox/.origin-token (read_regular_file), or creates
                outbox/.origin-token.<pid>.tmp (removed again when its
                write fails), links it to outbox/.origin-token, removes
                the .tmp and reads it.
    @deps       make_folder, read_regular_file, write_new_file; os; ROOT,
                OUTBOX_NAME, ORIGIN_TOKEN_NAME, ORIGIN_TOKEN_BYTES,
                ORIGIN_TOKEN_PATTERN, ORIGIN_TOKEN_READ_MAX_BYTES,
                SHARED_OWNED_FILE_MODE, NEW_FILE_MODE.
    @complexity O(1): one small file.
    @alloc      the token string, returned; the token file, kept.
    @rng        os.urandom(ORIGIN_TOKEN_BYTES), only when no token file is
                there yet: once per mailbox (SSH fix round 1, Claude Opus
                5.5, unreviewed: the audit's LOW-16).
    """
    top = ROOT / OUTBOX_NAME
    share = make_folder(top)
    path = top / ORIGIN_TOKEN_NAME
    try:
        try:
            text = read_regular_file(path, ORIGIN_TOKEN_READ_MAX_BYTES)
        except FileNotFoundError:
            tmp = top / f"{ORIGIN_TOKEN_NAME}.{os.getpid()}.tmp"
            mode = SHARED_OWNED_FILE_MODE if share is not None else NEW_FILE_MODE
            write_new_file(tmp, f"{os.urandom(ORIGIN_TOKEN_BYTES).hex()}\n", mode)
            try:
                os.link(tmp, path)
            except FileExistsError:
                pass  # another send made it first: that one is the mailbox's
            finally:
                tmp.unlink()  # this call's own .tmp, made just above
            text = read_regular_file(path, ORIGIN_TOKEN_READ_MAX_BYTES)
    except ValueError as err:
        raise ValueError(f"the origin token {path} is unreadable ({err})") from err
    token = text.strip()
    if not ORIGIN_TOKEN_PATTERN.fullmatch(token):
        raise ValueError(f"the origin token {path} does not hold {2 * ORIGIN_TOKEN_BYTES} hex digits on one line")
    return token


# SSH fix round 1 (Claude Opus 5.5, unreviewed): D33 part 4, the audit's
# HIGH-2, an origin id unique to its message.
def origin_nonce():
    """A new random part for one message's origin id: ORIGIN_NONCE_BYTES from Python's secrets module, as hex.

    The one place an origin id's randomness is drawn, so a test swaps
    this function for a seeded source and every id it builds is known.
    deliver_ssh calls it once per message it publishes; a retry (tc
    flush) reads the id back from the message's header, never draws.

    @interacts  none; draws from the operating system's random source.
    @deps       secrets; ORIGIN_NONCE_BYTES.
    @complexity O(1).
    @alloc      one short string, returned.
    @rng        secrets.token_hex(ORIGIN_NONCE_BYTES), once per call.
    """
    return secrets.token_hex(ORIGIN_NONCE_BYTES)


def origin_id(token, n, nonce, sender):
    """The origin id of message `n` from `sender`: <token>-<n>-<nonce>-<sender>, ORIGIN_PATTERN's shape (C3, D25, D33).

    @interacts  none; string work only.
    @deps       none.
    @complexity O(1).
    @alloc      one short string, returned.
    """
    return f"{token}-{n}-{nonce}-{sender}"


def printable_lines(text):
    """`text` with each line through printable(), the lines kept apart: what tc prints of anything a far tc said.

    @interacts  none; string work only.
    @deps       printable.
    @complexity O(c) over c characters.
    @alloc      one string, returned.
    """
    return "\n".join(printable(line) for line in text.splitlines())


# SSH fix round 1 (Claude Opus 5.5, unreviewed): the audit's MEDIUM-4,
# what the far side prints is read with a cap.
def ssh_capture(argv, text):
    """Run `argv` with `text` on its stdin for at most SSH_SEND_SECONDS, keeping at most SSH_OUTPUT_MAX_BYTES of each of its stdout and stderr: a Captured. Raises OSError when it will not start.

    The child's three pipes are served together through a selector, so a
    far side that prints while it reads never deadlocks: stdin is written
    PIPE_CHUNK_BYTES at a time, and each output pipe read the same way,
    the first SSH_OUTPUT_MAX_BYTES kept and the rest read and dropped, so
    the child never blocks on a full pipe and this side never holds more.
    Past SSH_SEND_SECONDS the child is killed and reaped (that process
    only, as subprocess.run's timeout did) and the code is None. A child
    that closed stdin early (a broken pipe) gets no more of the text.
    Output is decoded as UTF-8 with errors="replace", so odd bytes from
    the far side never fail a send.

    @interacts  starts one child (subprocess.Popen) and reads and writes
                its pipes until they close, or kills it at the bound.
                Writes nothing to disk.
    @deps       subprocess, selectors, os, time; SSH_SEND_SECONDS,
                SSH_OUTPUT_MAX_BYTES, PIPE_CHUNK_BYTES, Captured.
    @complexity O(b + p) over b bytes of `text` and p bytes the child
                prints (read once each, at most SSH_SEND_SECONDS), plus
                the child's run.
    @alloc      the encoded text; at most SSH_OUTPUT_MAX_BYTES kept per
                output stream, plus one PIPE_CHUNK_BYTES read at a time;
                one child and its pipes, reaped and closed before return.
    """
    data = text.encode("utf-8")
    deadline = time.monotonic() + SSH_SEND_SECONDS
    with subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE) as proc, \
            selectors.DefaultSelector() as pipes:
        kept = {proc.stdout: bytearray(), proc.stderr: bytearray()}
        names, cut, sent = {proc.stdout: "stdout", proc.stderr: "stderr"}, [], 0
        for stream in kept:
            pipes.register(stream, selectors.EVENT_READ)
        if data:
            os.set_blocking(proc.stdin.fileno(), False)
            pipes.register(proc.stdin, selectors.EVENT_WRITE)
        else:
            proc.stdin.close()
        while pipes.get_map():
            left = deadline - time.monotonic()
            if left <= 0:
                proc.kill()
                proc.wait()
                return Captured(None, "", "", ())
            for key, _ in pipes.select(left):
                if key.fileobj is proc.stdin:
                    try:
                        sent += os.write(key.fd, data[sent:sent + PIPE_CHUNK_BYTES])
                    except BlockingIOError:
                        continue
                    except BrokenPipeError:
                        sent = len(data)
                    if sent >= len(data):
                        pipes.unregister(proc.stdin)
                        proc.stdin.close()
                    continue
                chunk = os.read(key.fd, PIPE_CHUNK_BYTES)
                if not chunk:
                    pipes.unregister(key.fileobj)
                    continue
                room = SSH_OUTPUT_MAX_BYTES - len(kept[key.fileobj])
                kept[key.fileobj] += chunk[:max(room, 0)]
                if len(chunk) > room and names[key.fileobj] not in cut:
                    cut.append(names[key.fileobj])
        try:
            code = proc.wait(timeout=max(deadline - time.monotonic(), 0))
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()
            return Captured(None, "", "", ())
        out, err = (kept[stream].decode("utf-8", errors="replace") for stream in (proc.stdout, proc.stderr))
    return Captured(code, out, err, tuple(cut))


def ssh_run(where, sender, to, origin, text):
    """Send one message over ssh to `where` (an SshWhere) and sort the far side's answer: an SshOutcome.

    The argv is C3's, with `--origin <id>` added for D25: ssh -T -o
    BatchMode=yes -o ConnectTimeout=SSH_CONNECT_SECONDS -- <target>
    "<remote tc> send --from <sender> --to <to> --origin <id>", the words
    after the remote tc joined with shlex.join. `--` comes right before
    the target, so no target reads as an option. The body goes on stdin,
    never on the command line. Sorted: exit 0 is SSH_SENT;
    SSH_CONNECT_FAILED (255), a far EXIT_BUSY (10, D23), a run past
    SSH_SEND_SECONDS, ssh killed by a signal, or ssh that would not start
    is SSH_KEPT, with why; any other exit is the far side's answer,
    SSH_REFUSED (file_outcome passes 1, 6, 7 and 8 through and turns any
    other into exit 11, D33 part 7).

    SSH fix round 1 (Claude Opus 5.5, unreviewed): the audit's MEDIUM-4.
    The run goes through ssh_capture, which keeps at most
    SSH_OUTPUT_MAX_BYTES of each of the far side's stdout and stderr and
    says which it cut, so a far side that prints without end costs this
    machine a bounded amount, not gigabytes.

    @interacts  runs `ssh` (found on PATH) once, feeding `text` on its
                stdin and reading its stdout and stderr, for at most
                SSH_SEND_SECONDS, then kills it (ssh_capture). Writes
                nothing here.
    @deps       ssh_capture, printable; shlex; SSH_CONNECT_SECONDS,
                SSH_SEND_SECONDS, SSH_CONNECT_FAILED, EXIT_BUSY, SSH_SENT,
                SSH_KEPT, SSH_REFUSED, SshOutcome; the ssh client.
    @complexity O(b + p) over b bytes of `text` and p bytes the far side
                prints, plus one ssh run of at most SSH_SEND_SECONDS.
    @alloc      the argv, at most SSH_OUTPUT_MAX_BYTES of each output
                stream and one SshOutcome, returned; one child and its
                pipes, reaped and closed before return.
    """
    argv = ["ssh", "-T", "-o", "BatchMode=yes", "-o", f"ConnectTimeout={SSH_CONNECT_SECONDS}",
            "--", where.target,
            where.remote + " " + shlex.join(["send", "--from", sender, "--to", to, "--origin", origin])]
    try:
        done = ssh_capture(argv, text)
    except OSError as err:
        return SshOutcome(SSH_KEPT, None, "", "", f"could not run ssh ({err.strerror})", ())
    if done.code is None:
        return SshOutcome(SSH_KEPT, None, "", "", f"no answer in {SSH_SEND_SECONDS} s", ())
    code, first = done.code, (done.err.strip().splitlines() or [""])[0]
    if code == 0:
        return SshOutcome(SSH_SENT, code, done.out, done.err, None, done.cut)
    if code == SSH_CONNECT_FAILED:
        return SshOutcome(SSH_KEPT, code, done.out, done.err,
                          printable(first) if first else f"ssh exited {SSH_CONNECT_FAILED}", done.cut)
    if code == EXIT_BUSY:
        return SshOutcome(SSH_KEPT, code, done.out, done.err,
                          f"the far tc was busy, exit {EXIT_BUSY}" + (f": {printable(first)}" if first else ""),
                          done.cut)
    if code < 0:
        return SshOutcome(SSH_KEPT, code, done.out, done.err, f"ssh was killed by signal {-code}", done.cut)
    return SshOutcome(SSH_REFUSED, code, done.out, done.err, None, done.cut)


def file_away(path, folder):
    """Move the outbox message at `path` into `folder` beside it (sent/ or refused/) without replacing anything: its new path. Raises OSError.

    SSH fix round 1 (Claude Opus 5.5, unreviewed): D32, D33 and the
    audit's MEDIUM-2. The folder is made or found through claim_branch,
    which raises OSError with words, never exits: every level from this
    user's branch down to it must be this user's own real folder
    (SHARED_BRANCH_MODE under a shared mailbox), so a link, anything but
    a folder, or a folder another user made there is a warning for the
    caller, after the far side answered. The file is hard-linked into it,
    never renamed, since a rename replaces what holds its target (D25: a
    move into sent/ or refused/ never replaces a file already there);
    then its outbox name is removed. A name the folder already holds
    takes BY_HAND_NAME with the first free k (by_hand_name, cut to the
    folder's name limit), up to PUBLISH_MAX_TRIES names, then
    FileExistsError. The link never follows a link at `path`.

    @interacts  reads ROOT/.shared, makes or finds the folder and checks
                each level of the branch above it (claim_branch); reads
                its name limit; links the file in and unlinks its outbox
                name.
    @deps       claim_branch, by_hand_name; os, errno; PUBLISH_MAX_TRIES.
    @complexity O(k) over k names already taken (none in an honest
                outbox), plus claim_branch's three levels.
    @alloc      one path per name tried; the new one, returned.
    """
    dest = path.parent / folder
    claim_branch(dest)
    limit = os.pathconf(dest, "PC_NAME_MAX")
    for k in range(PUBLISH_MAX_TRIES):
        filed = dest / (path.name if k == 0 else by_hand_name(k, path.name, limit))
        try:
            os.link(path, filed, follow_symlinks=False)
        except FileExistsError:
            continue
        os.unlink(path)  # its outbox name; the message stays at `filed`
        return filed
    raise FileExistsError(errno.EEXIST, f"{PUBLISH_MAX_TRIES} names already taken", str(dest))


# P3 fix round 1c (Claude Opus 5.5, unreviewed): D36 (4), the audit's
# LOW-4. A queue that stays stuck is shown, not hidden: each failed try
# leaves its words beside the waiting file, and they move with it.
def note_path(path):
    """The note beside the outbox message at `path`: its name plus REFUSAL_NOTE_SUFFIX, in the same folder.

    @interacts  none; path work only.
    @deps       REFUSAL_NOTE_SUFFIX.
    @complexity O(1).
    @alloc      one path, returned.
    """
    return path.with_name(path.name + REFUSAL_NOTE_SUFFIX)


def write_note(note, lines):
    """Write `lines` (already through printable_lines) as the note at `note`, replacing any note there: whole or not at all. Raises OSError.

    Written to a .tmp of this process's own beside it (write_new_file,
    which never writes through anything at that name and leaves nothing
    when the write fails), then renamed over the note, so a reader finds
    the last try's words or the one before, never half of either. The note
    sits in this user's own outbox branch, which no other member can write
    in (D32, D33), so the rename replaces only this user's own note. A
    shared mailbox's note is SHARED_OWNED_FILE_MODE, as a refusal's.

    @interacts  reads ROOT/.shared (share_or_raise); creates
                <note>.<pid>.tmp, renames it over `note`, and removes the
                .tmp again when the rename fails.
    @deps       write_new_file, share_or_raise; os, contextlib;
                SHARED_OWNED_FILE_MODE, NEW_FILE_MODE.
    @complexity O(s) over s characters written, at most what the far side
                printed (SSH_OUTPUT_MAX_BYTES, through printable).
    @alloc      the text while written; the note, kept.
    """
    try:
        mode = SHARED_OWNED_FILE_MODE if share_or_raise() is not None else NEW_FILE_MODE
    except OSError:
        mode = SHARED_OWNED_FILE_MODE
    tmp = note.with_name(f"{note.name}.{os.getpid()}.tmp")
    write_new_file(tmp, "".join(f"{line}\n" for line in lines), mode)
    try:
        os.replace(tmp, note)
    except OSError:
        with contextlib.suppress(OSError):
            os.unlink(tmp)  # this call's own .tmp, made just above
        raise


def carry_note(path, filed):
    """Move the note beside the outbox message that was at `path` to sit beside it at `filed` (in sent/ or refused/): None, or a warning in words. Never removed (D36 (4)).

    Hard-linked to its new name, which never replaces a file there, then
    its old name removed, as file_away moves the message. No note there
    (no try ever failed) is None. A note that cannot move stays where it
    was, said in the warning: it is never removed.

    @interacts  links the note into `filed`'s folder and unlinks its old
                name.
    @deps       note_path; os.
    @complexity O(1).
    @alloc      none kept.
    """
    note, moved = note_path(path), note_path(filed)
    try:
        os.link(note, moved, follow_symlinks=False)
    except FileNotFoundError:
        return None
    except OSError as err:
        return f"the note of its last failed try stays at {note} ({err.strerror})"
    try:
        os.unlink(note)  # its old name; the note stays at `moved`
    except OSError as err:
        return f"its note is filed at {moved} too, but its old name {note} stays ({err.strerror})"
    return None


def file_outcome(path, where, outcome):
    """File the outbox message at `path` by the far side's answer `outcome`: (exit, words, warnings), C3's.

    SSH_SENT: into sent/ (file_away); exit 0, words `sent over ssh to
    <target>: <remote stdout>`, or `sent over ssh to <target>` alone when
    the far tc printed nothing. A message sent and not filed (the move
    failed) stays waiting, with a warning: the next tc flush sends it
    again and the far side answers already delivered (D25). SSH_KEPT:
    left where it is; exit 4, words `could not reach <target> (<reason>);
    kept in outbox: <path>. Run: tc flush`. SSH_REFUSED: into refused/,
    with the far exit code and stderr in a note beside it
    (REFUSAL_NOTE_SUFFIX); exit the far code, words the far stderr and
    then where the message went; nothing retries it. What the far side
    said is printed through printable_lines.

    SSH fix round 1 (Claude Opus 5.5, unreviewed): D33 parts 7 and 8, the
    audit's MEDIUM-4, MEDIUM-5, LOW-1 and LOW-4. On SSH_SENT each line of
    the far tc's stderr (its warnings, such as `new inbox: nobody has
    joined as <to>`) comes back as a warning, `<target> said: <line>`, as
    a local send's warnings do. A refusal passes the far code through only
    for FAR_ANSWER_CODES (1, 6, 7, 8); any other far code exits
    EXIT_FAR_UNKNOWN (11), its words naming the far code. The note beside
    a refused message goes through printable_lines, as the printed copy
    does, so it holds no raw terminal escape. When ssh_capture cut either
    stream at SSH_OUTPUT_MAX_BYTES, a warning says so (and the note too).

    P3 fix round 1c (Claude Opus 5.5, unreviewed): D36 (4), the audit's
    LOW-4. SSH_KEPT (a connection failure, a timeout, a far 10) also
    writes this try's words into the note beside the waiting file
    (note_path, write_note): first line the same summary the words open
    with, then what ssh printed on stderr, through printable_lines, and
    the cut line, replacing the last try's note. A message filed in sent/
    or refused/ takes its note along (carry_note), never removed; a
    refusal's own note then replaces it there, as a later try's would. A
    note that cannot be written or moved is a warning.

    @interacts  see file_away; reads ROOT/.shared (share_or_raise) and
                writes or replaces the note beside the message, waiting or
                refused (write_note); moves the note beside a filed
                message with it (carry_note).
    @deps       file_away, write_note, carry_note, note_path,
                printable_lines; EXIT_QUEUED, EXIT_FAR_UNKNOWN,
                FAR_ANSWER_CODES, OUTBOX_SENT, OUTBOX_REFUSED,
                SSH_OUTPUT_MAX_BYTES, SSH_SENT, SSH_KEPT.
    @complexity O(s) over s characters the far side printed, at most
                SSH_OUTPUT_MAX_BYTES per stream.
    @alloc      the words and warnings, returned; the filed message and
                its note, kept; a waiting message's note, kept until it
                moves with the message.
    """
    cut = [f"tc kept the first {SSH_OUTPUT_MAX_BYTES} bytes of what {where.target} printed on "
           f"{' and '.join(outcome.cut)}, and dropped the rest"] if outcome.cut else []
    said = printable_lines(outcome.err.strip())
    if outcome.kind == SSH_KEPT:
        summary = f"could not reach {where.target} ({outcome.reason})"
        warnings = list(cut)
        stderr = ["what ssh printed on stderr, through tc's printable filter:", *said.splitlines()] if said else []
        try:  # P3 fix round 1c (Claude Opus 5.5, unreviewed): D36 (4), this try's words beside the waiting file
            write_note(note_path(path), [summary, *stderr, *cut])
        except OSError as err:
            warnings.append(f"this try's words could not be kept beside it at {note_path(path)} ({err.strerror})")
        return (EXIT_QUEUED, f"{summary}; kept in outbox: {path}. Run: tc flush", warnings)
    if outcome.kind == SSH_SENT:
        answer = printable_lines(outcome.out.strip())
        words = f"sent over ssh to {where.target}" + (f": {answer}" if answer else "")
        warnings = [f"{where.target} said: {line}" for line in said.splitlines() if line.strip()] + cut
        try:
            filed = file_away(path, OUTBOX_SENT)
        except OSError as err:
            return (0, words, warnings + [f"sent, but {path} could not be filed in {OUTBOX_SENT}/ ({err.strerror}); "
                                          f"it stays in the outbox, so the next tc flush sends it again and the "
                                          f"far side answers already delivered"])
        moved = carry_note(path, filed)  # P3 fix round 1c (Claude Opus 5.5, unreviewed): D36 (4), never removed
        return (0, words, warnings + ([moved] if moved else []))
    lead = f"{said}\n" if said else ""
    code = outcome.code if outcome.code in FAR_ANSWER_CODES else EXIT_FAR_UNKNOWN
    how =(f"refused by {where.target} (exit {code})" if code == outcome.code else
           f"refused by {where.target} with far exit {outcome.code}, a code tc does not know (exit {code})")
    try:
        filed = file_away(path, OUTBOX_REFUSED)
    except OSError as err:
        return (code, f"{lead}{how}; {path} could not be filed in {OUTBOX_REFUSED}/ ({err.strerror}), so it stays "
                      f"in the outbox and the next tc flush sends it again", cut)
    warnings = list(cut)
    moved = carry_note(path, filed)  # P3 fix round 1c (Claude Opus 5.5, unreviewed): D36 (4), then replaced below
    if moved is not None:
        warnings.append(moved)
    note = note_path(filed)
    try:
        write_note(note, [f"the far side exited {outcome.code}; its stderr, through tc's printable filter:",
                          *said.splitlines(), *cut])
    except OSError as err:
        warnings.append(f"the far stderr could not be kept beside it at {note} ({err.strerror})")
    return (code, f"{lead}{how}; filed in {filed}, and nothing retries it", warnings)


def outbox_text(body):
    """The text an ssh send puts on ssh's stdin: the body with its trailing whitespace cut, and no newline added.

    The same text a later tc flush sends from the outbox file (which holds
    the body cut the same way, plus one newline, which this cuts again),
    so a first try and a retry send exactly the same message. SSH fix
    round 1 (Claude Opus 5.5, unreviewed): the audit's LOW-5. The far tc
    adds the one newline when it publishes, so a body of exactly
    SEND_BODY_MAX_BYTES reaches it at the limit, not one byte over, which
    it would refuse with exit 8 for good.

    @interacts  none; string work only.
    @deps       none.
    @complexity O(b) over b bytes of body.
    @alloc      one string, returned.
    """
    return body.rstrip()


def deliver_ssh(card, sender, to, body, header_note=None, *, deadline=None):
    """Route ssh (C3): publish the message in the outbox, then send it over ssh to the far tc, then file it by the answer. A Delivery.

    1. The card is checked (ssh_where): a bad target or remote path is
       Delivery exit 6, words, nothing written and ssh never run (D13).
    2. SSH fix round 1 (Claude Opus 5.5, unreviewed): D32, D33 part 1.
       This user's queue, outbox/<user>/to-<to>/ (outbox_queue), is made
       or found and every level of it checked (claim_branch): a branch
       or folder another member owns, a link or not a folder is Delivery
       exit 1, words naming the owner and the one command that clears
       it, nothing written.
    3. The mailbox's origin token is read, or made (origin_token); one
       that cannot be is Delivery exit 1, nothing written.
    4. This user's send lock for the target is taken (send_lock, in this
       user's branch), within SEND_LOCK_WAIT_SECONDS (SSH fix round 1:
       the audit's LOW-9, one ssh run of the tc that holds it).
    5. The message is published in outbox/<user>/to-<to>/ (D25, D32)
       exactly as local mail is (publish_message: same mail/.seq, same
       header, never a replace, sent/ and refused/ as its history), as
       this user, at SHARED_OWNED_FILE_MODE under a shared mailbox. From
       here every send leaves a record. It is published whether or not
       the lock was taken, but after the wait for it: with the lock held,
       no flush can send this file before this send does, and a flush
       that held the lock meanwhile may find and send it (C3, lane note
       5). Lock not taken: Delivery exit 4, kept, words saying another tc
       is sending to the target.
    6. Queue order first (C3, D22): when this user's own outbox already
       holds other mail for the same target (queue_ahead: every waiting
       file but this one, whatever its number, SSH fix round 1, the
       audit's LOW-7), the message stays queued behind it without
       trying, exit 4, `<target> has <n> waiting in the outbox; queued
       behind them. Run: tc flush`.
    7. Else one ssh run (ssh_run) with --origin
       <token>-<number>-<random part>-<sender> (D25), and the message is
       filed by the answer (file_outcome), all under the send lock:
       sent/ and exit 0; kept, exit 4 (255, a timeout, a far 10 busy,
       D23), with this try's words in the note beside it (P3 fix round
       1c, Claude Opus 5.5, unreviewed: D36 (4)); refused/ with the far
       stderr beside it and the far code. Then the lock is let go.

    SSH fix round 1 (Claude Opus 5.5, unreviewed): D33 part 4, the
    audit's HIGH-2. The random part is drawn once per message
    (origin_nonce), before the publish, and the whole id ends the outbox
    file's header line (ORIGIN_HEADER_NOTE, built from the number the
    publish lands at), so every retry from tc flush sends the same id,
    and a number mail/.seq repeats never repeats an id. The audit's LOW-6:
    a number past ORIGIN_SEQ_MAX_DIGITS digits, which no far gate would
    take, is Delivery exit 1, SEQ_TOO_LONG_WORDS naming mail/.seq, and no
    ssh run; one a taken name moved past the bound during the publish is
    filed in refused/ with those words.

    `deadline` is the command's lock_deadline (route_and_deliver); None
    takes one here. SSH fix round 1 (Claude Opus 5.5, unreviewed): the
    send lock waits on its own bound, so mail/.seq waits until the later
    of `deadline` and LOCK_WAIT_SECONDS from the moment the send lock is
    held: still one bound for mail/.seq in this command, and a long wait
    for the send lock never leaves mail/.seq no time. No inbox lock is
    taken: there is no local inbox.
    Neither mail/.seq's lock nor any inbox lock is held while ssh runs;
    the send lock is (see send_lock). A crash after the send and before
    the move leaves the message waiting: tc flush sends it again, a
    duplicate the origin id turns into `already delivered`, never a loss.

    @interacts  reads ROOT/.shared; makes or finds outbox/, this user's
                branch outbox/<user>/, outbox/<user>/to-<to>/ and, when it
                files one, sent/ or refused/, lstat()ing each level
                (claim_branch); reads or makes the origin token; takes the
                send lock; takes numbers from mail/.seq (next_seq,
                publish_message) and publishes one file in
                outbox/<user>/to-<to>/, opened once by its path with its
                sent/ and refused/ by name in it, every publish step by
                name in those descriptors, closed after (P3 fix round 1a,
                Claude Opus 5.5, unreviewed: D35); lists this user's branch and reads
                the card of each name waiting (queue_ahead); runs ssh once
                (ssh_run); links the file into sent/ or refused/ and
                removes its outbox name, writing the far stderr beside a
                refused one, or writes this try's words beside a kept
                one, and moves a note with a filed one (file_outcome; P3
                fix round 1c, Claude Opus 5.5, unreviewed: D36 (4)).
    @deps       ssh_where, outbox_queue, claim_branch, origin_token,
                origin_nonce, origin_id, lock_deadline, next_seq,
                pin_folder, publish_message, send_lock, queue_ahead,
                ssh_run, file_outcome, file_away, outbox_text, Delivery;
                os; CARDS, SEQ_FILE, SEQ_WIDTH, FOLDER_FLAGS, OUTBOX_SENT,
                OUTBOX_REFUSED, ORIGIN_HEADER_NOTE, ORIGIN_SEQ_MAX_DIGITS,
                SEQ_TOO_LONG_WORDS, SHARED_OWNED_FILE_MODE, NEW_FILE_MODE,
                EXIT_BAD_NAME, EXIT_REFUSED, EXIT_QUEUED.
    @complexity O(b) over b bytes of body per publish try (one in an
                honest mailbox), plus queue_ahead's O(q + w log w) over
                this user's branch, plus one ssh run of at most
                SSH_SEND_SECONDS; the send lock waits at most
                SEND_LOCK_WAIT_SECONDS, then mail/.seq at most
                LOCK_WAIT_SECONDS.
    @alloc      the message text while written; one outbox file, kept in
                outbox/<user>/to-<to>/, sent/ or refused/ (D25, D32); a
                refusal's note, kept; one open lock file while the lock
                is held; up to three descriptors while it publishes.
    @rng        one origin_nonce draw per call that gets past the card,
                branch and token checks (D33 part 4).
    """
    where = ssh_where(card)
    if where.why is not None:
        return Delivery(EXIT_BAD_NAME, f"tc send: the card {CARDS / f'{to}.json'} {where.why}; nothing sent. "
                                       f"Write it again with tc card {to} --ssh <target>.", [])
    if deadline is None:
        deadline = lock_deadline()
    box = outbox_queue(to)  # SSH fix round 1 (Claude Opus 5.5, unreviewed): D32, this user's own branch
    try:
        share = claim_branch(box)
    except OSError as err:
        return Delivery(EXIT_REFUSED, f"tc send: {err.strerror}", [])
    try:
        token = origin_token()
    except (OSError, ValueError) as err:
        why = (f"{err.strerror}" + (f" at {err.filename}" if err.filename else "")
               if isinstance(err, OSError) else str(err))
        return Delivery(EXIT_REFUSED, f"tc send: could not read or make the origin token ({why}); nothing sent", [])
    mode = SHARED_OWNED_FILE_MODE if share is not None else NEW_FILE_MODE
    nonce = origin_nonce()  # SSH fix round 1 (Claude Opus 5.5, unreviewed): D33 part 4, once per message

    def note(n):
        origin = ORIGIN_HEADER_NOTE.format(origin=origin_id(token, n, nonce, sender))
        return f"{header_note}, {origin}" if header_note else origin
    with send_lock(where.target) as (held, why):
        deadline = max(deadline, lock_deadline())  # SSH fix round 1 (Claude Opus 5.5, unreviewed): LOW-9, mail/.seq's own bound
        n = next_seq(deadline)  # under the lock when held, so no flush takes this file before this send does
        if len(str(n)) > ORIGIN_SEQ_MAX_DIGITS:  # SSH fix round 1 (Claude Opus 5.5, unreviewed): LOW-6
            return Delivery(EXIT_REFUSED, SEQ_TOO_LONG_WORDS.format(seq=SEQ_FILE, n=n, digits=len(str(n)),
                                                                    most=ORIGIN_SEQ_MAX_DIGITS), [])
        try:  # P3 fix round 1a (Claude Opus 5.5, unreviewed): D35, publish_message works by name in an open folder
            queue_fd = os.open(box, FOLDER_FLAGS)  # claim_branch judged each level just above
        except OSError as err:
            return Delivery(EXIT_REFUSED, f"tc send: could not create {box / f'{n:0{SEQ_WIDTH}d}-from-{sender}.tmp'} "
                                          f"({err.strerror}); nothing sent", [])
        history = []
        try:
            for folder in (OUTBOX_SENT, OUTBOX_REFUSED):
                history.append((folder, pin_folder(queue_fd, folder, box / folder).fd))
            published = publish_message(box, queue_fd, history, n, sender, to, body, note, mode, deadline)
        finally:
            for _, folder_fd in history:
                if folder_fd is not None:
                    os.close(folder_fd)
            os.close(queue_fd)
        if published.refusal is not None:
            return published.refusal
        path, warnings = published.path, published.warnings
        if len(str(published.n)) > ORIGIN_SEQ_MAX_DIGITS:  # a taken name moved it past the bound: never sent
            words = SEQ_TOO_LONG_WORDS.format(seq=SEQ_FILE, n=published.n, digits=len(str(published.n)),
                                              most=ORIGIN_SEQ_MAX_DIGITS)
            try:
                filed = file_away(path, OUTBOX_REFUSED)
            except OSError as err:
                return Delivery(EXIT_REFUSED, f"{words} It stays in the outbox ({err.strerror}): {path}", warnings)
            return Delivery(EXIT_REFUSED, f"{words} It is filed in {filed}.", warnings)
        if not held:
            busy = why if why is not None else "another tc is sending to it right now (a send or a tc flush)"
            return Delivery(EXIT_QUEUED, f"{where.target} was not tried: {busy}; kept in outbox: {path}. "
                                         f"Run: tc flush", warnings)
        ahead = queue_ahead(where.target, path)
        if ahead:
            return Delivery(EXIT_QUEUED, f"{where.target} has {ahead} waiting in the outbox; queued behind them. "
                                         f"Run: tc flush", warnings)
        outcome = ssh_run(where, sender, to, origin_id(token, published.n, nonce, sender), outbox_text(body))
        code, words, filed = file_outcome(path, where, outcome)
    return Delivery(code, words, warnings + filed)


# One function per route; a card's route picks one. A route not here
# answers "route <route> is not built yet" (C2). Each lane adds its own line.
ROUTES = {
    "local": deliver_local,
    "codex": deliver_codex,
    "ssh": deliver_ssh,  # SSH S1 (Claude Opus 5.5, unreviewed): C3
}


# SSH S2 (Claude Opus 5.5, unreviewed): tc flush (C3, D22, D23).
def outbox_message(path):
    """The origin id and the text an outbox message sends: (id, body), the id that ends its header line and what follows that line and the blank line after it. Raises OSError or ValueError, with words.

    Read through read_regular_file (no link followed, a FIFO never
    waited on, at most MESSAGE_READ_MAX_BYTES), so the body is the same
    text deliver_ssh put on ssh's stdin the first time (outbox_text).
    SSH fix round 1 (Claude Opus 5.5, unreviewed): D33 part 4. The id is
    the one deliver_ssh wrote at the end of the header line
    (ORIGIN_HEADER_PATTERN), so a retry sends the id the first try sent;
    a header with none is refused with words, since an id made up now
    could deliver the message twice.

    @interacts  opens, fstats and reads one file.
    @deps       read_regular_file; MESSAGE_READ_MAX_BYTES,
                ORIGIN_HEADER_PATTERN.
    @complexity O(b) over b bytes of the file.
    @alloc      the file's text, the id and the body, returned.
    """
    text = read_regular_file(path, MESSAGE_READ_MAX_BYTES)
    header, blank, body = text.partition("\n\n")
    if not blank:
        raise ValueError("it has no header line and blank line, so it is not a message tc wrote")
    found = ORIGIN_HEADER_PATTERN.search(header)
    if found is None:
        raise ValueError("its header line ends with no origin id, so a send could deliver it twice")
    return found.group(1), body


def cmd_flush(args):
    """`tc flush [--to <name>]`: send this user's waiting outbox mail over ssh, oldest first for each target (C3, D22, D23).

    Each waiting file's target is its `to`'s card, read once per run
    (queue_route; SSH fix round 1, Claude Opus 5.5, unreviewed: the
    audit's LOW-8). For each target, this user's send lock is taken
    (send_lock; another send or flush holding it past
    SEND_LOCK_WAIT_SECONDS leaves that target for the next flush), and
    then, until none is left, the oldest of this user's files for that
    target is sent (ssh_run, with the origin id its header line ends
    with, D25, D33 part 4: the id its first try sent, never one made up
    now) and filed by the answer (file_outcome): sent/; refused/ with the
    far stderr beside it, and on to the next; or, on 255, a timeout or a
    far 10 (D23), kept and the target stopped, so its mail stays in
    order (P3 fix round 1c, Claude Opus 5.5, unreviewed: D36 (4), with
    this try's words in the note beside the file, which moves with it
    once it is filed). This user's branch is listed again before each
    file, so a message a send queued while this flush runs goes out with
    it, behind every older one. A file that cannot be read, or whose
    header holds no origin id, stops its target too, with words.

    SSH fix round 1 (Claude Opus 5.5, unreviewed): the audit's LOW-13
    (option B), LOW-14 and LOW-15. What is left for a target is counted
    while that target's lock is still held, so a send that was waiting
    for the lock, and publishes once it is let go, never reads as left
    (it sends its own message, or queues it). With `--to`, an empty
    selection says `nothing waiting for <name>`, with why when its card
    says it (no card, not ssh), not that the whole outbox is empty. Every
    line to stdout is flushed as it is printed, so a capture that merges
    stdout and stderr keeps the lines in the order they happened.

    D22: only files this user owns are sent (owned_by_me); for each
    target, a line counts the files waiting in other members' branches
    and says each member sends their own. A file whose card no longer
    says ssh (or is missing or unreadable) stays where it is, with words
    saying why and what fixes it; it is never sent another way. `--to
    <name>` sends the queue of the target <name>'s card points at, so
    every name whose card points there goes, in order; with no ssh card
    for <name>, only outbox/<user>/to-<name>/ is looked at, and its
    files are left.

    SSH fix round 1 (Claude Opus 5.5, unreviewed): D32 and D33 part 1.
    This user's mail waits in this user's own branch, outbox/<user>/,
    and only that branch is listed in the loop. A branch that is not
    this user's own real folder (another member made it first, a link,
    not a folder) is refused, exit 1, with words naming its owner and the
    one command that clears it (claim_branch), and nothing is sent.

    One line per file: sent ones on stdout, the rest on stderr, then a
    line per file still waiting that was not tried. Exit 0 when none of
    this user's files in the selection is left waiting, 4 when any is
    (EXIT_QUEUED). Refused files are filed, not left.

    @interacts  checks --to (C0, exit 6); lstats this user's branch and
                each level of it (claim_branch, exit 1 on a refusal);
                lists it (outbox_files) and reads each waiting name's card
                once (queue_route); opens each other member's branch once
                and lists it and each queue in it by name in its
                descriptor, never by a path (other_branches, outbox_files;
                P3 fix round 1a, Claude Opus 5.5, unreviewed: D35, the
                audit's HIGH-1), closing them after; per target takes the send
                lock (send_lock), lists this user's branch before each
                file and once more before letting the lock go; per file
                reads it and the origin id its header ends with
                (outbox_message), runs ssh once (ssh_run) and files it in
                sent/ or refused/ with its note, or writes this try's
                note beside it when kept (file_outcome); reads the user
                database for other members' names; prints.
    @deps       require_names, outbox_branch, outbox_queue, claim_branch,
                outbox_files, other_branches, queue_route, owned_by_me,
                send_lock, outbox_message, outbox_text, ssh_run,
                file_outcome, printable, user_name, refuse; os, sys;
                SSH_SENT, SSH_KEPT, EXIT_QUEUED, EXIT_REFUSED.
    @complexity O(w x (q + w log w) + c + W log W) plus one ssh run of at
                most SSH_SEND_SECONDS per file (SSH fix round 1, the
                audit's LOW-12): w of this user's files waiting in this
                user's branch and q to-<name>/ folders there (the branch
                is listed again before each file, and once more per
                target), c names with a file waiting (one card read
                each, per run), W files waiting in every other member's
                branch (listed once, for the count). w is single digits
                unless a target has been down for a long time; W is
                other members' queues, never sent here.
    @alloc      the outbox lists, one dict of routes, the set of paths
                tried and the list of files left with why, freed on exit;
                one open lock file per target while it is flushed.
    """
    require_names(args.to)
    routes = {}

    def route(name):  # SSH fix round 1 (Claude Opus 5.5, unreviewed): LOW-8, each card once per run
        if name not in routes:
            routes[name] = queue_route(name)
        return routes[name]

    pick = route(args.to) if args.to is not None else None

    def chosen(f):
        return args.to is None or f.to == args.to or (pick.target is not None and route(f.to).target == pick.target)

    branch = outbox_branch()  # SSH fix round 1 (Claude Opus 5.5, unreviewed): D32, this user's branch only
    if os.path.lexists(branch):
        try:
            claim_branch(branch)
        except OSError as err:
            refuse(f"tc flush: {err.strerror}", EXIT_REFUSED)
    files, left_out = outbox_files(branch)
    box = outbox_queue(args.to) if args.to is not None else None
    for path, why in left_out:
        if box is None or path == box or box in path.parents:
            print(f"tc flush: skipped {printable(path)}: {why}", file=sys.stderr)
    mine = [f for f in files if chosen(f) and owned_by_me(f.st)]
    with other_branches() as others:  # P3 fix round 1a (Claude Opus 5.5, unreviewed): D35, each branch counted in its descriptor
        theirs = [f for other, other_fd in others for f in outbox_files(other, other_fd)[0] if chosen(f)]
    left, said, targets = [], set(), []  # left: (file, why); said: every file this run tried
    for f in mine:
        where = route(f.to)
        if where.target is None:
            left.append((f, f"{where.why}; it is never sent another way. To send it over ssh, write the card again "
                            f"with tc card {printable(f.to)} --ssh <target>, then run tc flush"))
        elif where.target not in targets:
            targets.append(where.target)
    for target in targets:
        with send_lock(target) as (held, why):
            if not held:
                busy = why if why is not None else "another tc is sending to it right now (a send or a tc flush)"
                left += [(f, busy) for f in mine if route(f.to).target == target]
                continue
            stopped = None
            while True:
                queue = [f for f in outbox_files(branch)[0]
                         if owned_by_me(f.st) and f.path not in said and route(f.to).target == target]
                if not queue:
                    break
                f = queue[0]
                said.add(f.path)
                lead = f"#{f.n} to {printable(f.to)}"
                try:
                    origin, body = outbox_message(f.path)  # SSH fix round 1 (Claude Opus 5.5, unreviewed): D33 part 4
                except (OSError, ValueError) as err:
                    why = err.strerror if isinstance(err, OSError) and err.strerror else str(err)
                    print(f"tc flush: {lead}: could not read {printable(f.path)} ({why}); stopped for {target}, "
                          f"so its mail stays in order. Move it out of the outbox by hand, then run tc flush.",
                          file=sys.stderr)
                    stopped = f"{lead}, ahead of it, could not be read"
                    break
                where = route(f.to)
                outcome = ssh_run(where, f.sender, f.to, origin, outbox_text(body))
                code, words, warnings = file_outcome(f.path, where, outcome)
                print(f"{lead}: {words}" if outcome.kind == SSH_SENT else f"tc flush: {lead}: {words}",
                      file=sys.stdout if outcome.kind == SSH_SENT else sys.stderr, flush=True)
                for warning in warnings:
                    print(f"tc flush: {lead}: {warning}", file=sys.stderr)
                if outcome.kind == SSH_KEPT:
                    stopped = f"{target} could not be reached ({outcome.reason}); it waits behind {lead}"
                    break
            # SSH fix round 1 (Claude Opus 5.5, unreviewed): LOW-13, counted before the lock is let go
            left += [(f, stopped) for f in outbox_files(branch)[0]
                     if owned_by_me(f.st) and route(f.to).target == target]
    for f, why in left:
        if f.path not in said:
            print(f"tc flush: left {printable(f.path)}: {why}", file=sys.stderr)
    owners = {}
    for f in theirs:
        target = route(f.to).target or "a name with no ssh card"
        owners.setdefault(target, []).append(user_name(f.st.st_uid))
    for target, names in owners.items():
        print(f"{len(names)} waiting for {target} belong to other members ({', '.join(sorted(set(names)))}); "
              f"each member sends their own with tc flush", flush=True)
    selection = "in the outbox" if args.to is None else f"for {printable(args.to)}"  # SSH fix round 1 (Claude Opus 5.5, unreviewed): LOW-14
    if not mine and not theirs:
        print(f"nothing waiting {selection}" + (f": {pick.why}" if pick is not None and pick.why else ""),
              flush=True)
    elif not mine:
        print(f"nothing of yours waiting {selection}", flush=True)
    if left:
        sys.exit(EXIT_QUEUED)


# ---------- gate: the forced command for inbound ssh (C3, D16, D18, D25) ----------
# SSH S3 (Claude Opus 5.5, unreviewed).

# A far command the gate allows (gate_command): its shape, "send" or
# "health"; for a send, the far side's --from (checked, then ignored), the
# --to and the --origin id (None when not given).
GateCommand = collections.namedtuple("GateCommand", "shape sender to origin")


def gate_command(text):
    """The far side's command `text` (SSH_ORIGINAL_COMMAND) as a GateCommand when it is one of C3's two shapes, else None.

    Split with shlex.split, never by a shell; the first word, the far
    side's path to its own tc, is ignored. Allowed, word for word:
    `send --from <name> --to <name>`, optionally followed by `--origin
    <id>` (D25), both names valid under C0 and the id matching
    ORIGIN_PATTERN with a C0 sender; or `health --json`. Anything else,
    a quote left open, no text at all, or one word more or less, is None.

    @interacts  none; string work only.
    @deps       valid_name; shlex; ORIGIN_PATTERN, GATE_HEALTH_ARGV,
                GateCommand.
    @complexity O(c) over c characters of `text`.
    @alloc      the split words and one GateCommand, returned.
    """
    if text is None:
        return None
    try:
        words = shlex.split(text)
    except ValueError:
        return None
    rest = words[1:]
    if rest == GATE_HEALTH_ARGV:
        return GateCommand("health", None, None, None)
    if len(rest) not in (5, 7) or rest[0] != "send" or rest[1] != "--from" or rest[3] != "--to":
        return None
    sender, to, origin = rest[2], rest[4], None
    if len(rest) == 7:
        if rest[5] != "--origin":
            return None
        origin = rest[6]
        found = ORIGIN_PATTERN.fullmatch(origin)
        if found is None or not valid_name(found.group("sender")):
            return None
    if not (valid_name(sender) and valid_name(to)):
        return None
    return GateCommand("send", sender, to, origin)


# P3 fix round 1c (Claude Opus 5.5, unreviewed): D36 (5), the gate's health is an allow list.
def gate_health(value, allow=GATE_HEALTH_KEYS):
    """The part of the health snapshot `value` that `allow` names (GATE_HEALTH_KEYS at the top): what the gate's `health --json` gives a far key.

    `allow` None keeps `value` whole. A dict keeps only the keys it names,
    each through its own entry; a "*" entry keeps every key of `value` (a
    mailbox name) through the entry under it. A value that should be a
    dict and is not becomes None, so nothing unnamed passes. A key not in
    `allow` never reaches the far key, however health came by it.

    @interacts  none; dict work only.
    @deps       GATE_HEALTH_KEYS.
    @complexity O(v) over v entries kept: the names under listeners,
                watchers and mail (a few dozen) and the fixed keys.
    @alloc      one new dict per level kept, returned.
    """
    if allow is None:
        return value
    if not isinstance(value, dict):
        return None
    if "*" in allow:
        return {name: gate_health(entry, allow["*"]) for name, entry in value.items()}
    return {key: gate_health(value[key], sub) for key, sub in allow.items() if key in value}


def cmd_gate(args):
    """`tc gate --as <name>`: what one far key may do here, as the forced command in authorized_keys (C3).

    It reads SSH_ORIGINAL_COMMAND (gate_command) and nothing else of the
    far side's but the body on stdin. A send shape delivers the body as
    from the `--as` name, never the far --from, with the header note `via
    ssh gate, key <as>`, through the router (deliver_once, then
    route_and_deliver, with forward False), so a codex name is rung and
    the inbox lock taken as for any send (D16), and a name whose card
    says ssh is refused, exit 7, `tc gate: <name> is not a local name;
    the gate does not forward` (D18). With --origin, an id this key
    already filed is `already delivered`, exit 0, and the id is filed
    for this key the moment its message lands, before any ring (D25; SSH
    fix round 1, Claude Opus 5.5, unreviewed: D33 parts 3 and 5, under
    mail/.origins/<user>/<as>/). The size limit holds (exit 8, C0), and an empty
    body is refused, exit 1. A health shape prints `tc health --json`'s
    snapshot without reading cards and without a GPU query (D16, D18),
    or listing outbox/ and mail/.origins/ (SSH fix round 1, Claude Opus
    5.5, unreviewed: paths that name this machine's users). P3 fix round
    1c (Claude Opus 5.5, unreviewed): D36 (5), the audit's DEBT-5 and
    LOW-2. What it prints is an allow list (gate_health,
    GATE_HEALTH_KEYS): the keys the gate gave at 616b9db less
    `mail_problem` and `shared_problem`, which carry this mailbox's
    path, so `held_by_others`, `stuck_outbox` and any key health gains
    later stay home unless named there. Anything else: `tc gate:
    refused`, exit 7, nothing written.

    It starts no shell and no program but the codex ring, reached through
    the router for a card that says codex (D18): an argv list, a checked
    thread id and a fixed line that never holds the body.

    @interacts  checks --as (C0, exit 6); reads SSH_ORIGINAL_COMMAND; for
                a send, reads the body from stdin (read_body: over the
                limit exit 8, not UTF-8 exit 1; empty, exit 1, row 1) and
                delivers it (deliver_once: see route_and_deliver and the
                routes it reaches, local and codex; an inbox lock or
                mail/.seq held past LOCK_WAIT_SECONDS exits 10, row 10,
                nothing written); for health, reads /proc and mail/
                (health_snapshot) and prints only what GATE_HEALTH_KEYS
                names (gate_health); prints; on a refusal one line to
                stderr and exit 7.
    @deps       require_names, gate_command, read_body, refuse,
                deliver_once, print_delivery, health_snapshot,
                gate_health; json, os; GATE_REFUSED_WORDS,
                GATE_HEADER_NOTE, EXIT_GATE_REFUSED, EXIT_REFUSED.
    @complexity O(c + b) over c characters of the far command and b bytes
                of body, plus the route's own work; or health_snapshot's,
                less its cards and branches, plus gate_health's.
    @alloc      the split command and the body, freed on exit; whatever
                the route keeps.
    """
    require_names(args.as_name)
    command = gate_command(os.environ.get("SSH_ORIGINAL_COMMAND"))
    if command is None:
        refuse(GATE_REFUSED_WORDS, EXIT_GATE_REFUSED)
    if command.shape == "health":
        # P3 fix round 1c (Claude Opus 5.5, unreviewed): D36 (5), only the keys GATE_HEALTH_KEYS names.
        print(json.dumps(gate_health(health_snapshot(cards=False, gpu=False, branches=False)), indent=2))
        return
    body = read_body(None)
    if not body.strip():
        refuse("tc gate: empty message; nothing written", EXIT_REFUSED)
    print_delivery(deliver_once(args.as_name, command.to, body, GATE_HEADER_NOTE.format(key=args.as_name),
                                origin=command.origin, forward=False))


# ---------- health: machine, sessions, listeners, mail ----------

def machine_stats(gpu=True):
    """Load, memory and GPU right now. GPU is None when nvidia-smi is absent, or when `gpu` is False.

    SSH S3 (Claude Opus 5.5, unreviewed): `gpu` False never asks
    nvidia-smi, so the gate's health runs no program (D18).

    @interacts  reads the load average and /proc/meminfo; runs nvidia-smi
                once (gpu_stats) only when `gpu` is True.
    @deps       gpu_stats; os.
    @complexity O(l) over l lines of /proc/meminfo (about fifty), plus
                one nvidia-smi run when asked.
    @alloc      one dict, returned.
    """
    load1 = os.getloadavg()[0]
    cores = os.cpu_count() or 1
    info = {}
    with open("/proc/meminfo") as f:
        for line in f:
            key, _, rest = line.partition(":")
            info[key] = int(rest.split()[0])
    mem_pct = 100.0 * info["MemAvailable"] / info["MemTotal"]
    return {"load1": round(load1, 2), "cores": cores,
            "mem_avail_pct": round(mem_pct, 1), "gpus": gpu_stats() if gpu else None}


def gpu_stats():
    exe = shutil.which("nvidia-smi")
    if not exe:
        return None
    try:
        out = subprocess.run([exe, "--query-gpu=temperature.gpu,utilization.gpu",
                              "--format=csv,noheader,nounits"], capture_output=True,
                             text=True, timeout=GPU_QUERY_TIMEOUT_SECONDS).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    gpus = []
    for line in out.strip().splitlines():
        parts = [x.strip() for x in line.split(",")]
        if len(parts) == 2 and all(x.isdigit() for x in parts):
            gpus.append({"temp_c": int(parts[0]), "util_pct": int(parts[1])})
    return gpus or None


def _cmdline(pid):
    try:
        raw = pathlib.Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return []
    return [a.decode(errors="replace") for a in raw.split(b"\0") if a]


def _is_codex(argv):
    if not argv or any("app-server-daemon" in a for a in argv):
        return False
    first = os.path.basename(argv[0])
    return first == "codex" or (first == "node" and len(argv) > 1 and os.path.basename(argv[1]) == "codex")


def session_counts():
    """Claude Code sessions (process name `claude`) and Codex CLI sessions.

    Codex is approximate: a CLI started through node spawns a native `codex`
    child, so a codex process whose parent is also codex is not counted again,
    and the app-server daemon is skipped.
    """
    claude, codex_pids, parent = 0, set(), {}
    for d in pathlib.Path("/proc").iterdir():
        if not d.name.isdigit():
            continue
        try:
            stat = (d / "stat").read_text()
        except OSError:
            continue
        # comm is in parens and may hold spaces; fields after it are fixed.
        comm = stat[stat.index("(") + 1:stat.rindex(")")]
        fields = stat[stat.rindex(")") + 2:].split()
        state, ppid = fields[0], fields[1]
        if state == "Z":
            continue
        if comm == "claude":
            claude += 1
        elif _is_codex(_cmdline(d.name)):
            codex_pids.add(d.name)
            parent[d.name] = ppid
    codex = sum(1 for pid in codex_pids if parent[pid] not in codex_pids)
    return {"claude": claude, "codex": codex}


def _flock_holders():
    """Map 'major:minor:inode' (_lock_key) to the pids holding an flock on that file, in /proc/locks order.

    P3 fix round 1b (Claude Opus 5.5, unreviewed): D35 (1) and (3). Every
    holder of a file is kept, not only the last one read: a lock held
    shared has several, and a listener is named only when its holder is
    the name's owner (listeners). A waiter's line carries "->" before
    FLOCK, so it is never read as a holder.

    @interacts  reads /proc/locks. Writes nothing.
    @deps       pathlib.
    @complexity O(k) over k lines in /proc/locks (tens).
    @alloc      one dict of short lists, returned.
    """
    holders = {}
    try:
        lines = pathlib.Path("/proc/locks").read_text().splitlines()
    except OSError:
        return holders
    for line in lines:
        f = line.split()
        if len(f) >= 6 and f[1] == "FLOCK":
            holders.setdefault(f[5], []).append(int(f[4]))
    return holders


# P3 fix round 1b (Claude Opus 5.5, unreviewed): D35 (1) and (3), whose a
# lock's holder is.
def process_uid(pid):
    """The user id that owns process `pid` (its /proc/<pid>), or None when tc cannot look at it: it ended, or /proc hides other users' processes.

    @interacts  stats /proc/<pid>. Writes nothing.
    @deps       os.
    @complexity O(1).
    @alloc      none.
    """
    try:
        return os.stat(f"/proc/{pid}").st_uid
    except OSError:
        return None


def _lock_key(st):
    """The 'major:minor:inode' key /proc/locks gives the file whose stat result is `st`.

    SHARED fix round 1 (Claude Opus 5.5, unreviewed): it takes the stat
    result, so the caller decides whether a link is followed (listeners
    never follows one).

    @interacts  none.
    @deps       os.
    @complexity O(1).
    @alloc      one short string, returned.
    """
    return f"{os.major(st.st_dev):02x}:{os.minor(st.st_dev):02x}:{st.st_ino}"


def listeners(kind="wait", shared=None):
    """Each name that ever ran `tc <kind>`, with the pid holding its lock or None, in name order.

    Reads /proc/locks instead of trying the lock, so probing never races a
    listener that is starting up. SHARED fix round 1 (Claude Opus 5.5,
    unreviewed): each lock is lstat()ed, and one that is not a regular
    file (a symlink planted at a name's lock, a FIFO) is left out. A
    link's target may be another listener's lock, and the proof of life
    (CLAUDE.md rule 6) must never follow it, so tc health, tc watch and
    the board report no listener from a link.

    P3 fix round 1b (Claude Opus 5.5, unreviewed): D35 (1). A name's lock
    is WAKE_LOCK_NAME in its own inbox: mail/ is opened once and each
    mail/to-<name>/ by its name in it (pin_folder), and the lock is
    lstat()ed by name in the inbox's descriptor, never by a path. It counts
    only when it is a regular file the inbox's owner owns (a file another
    member planted there is nobody's lock), and a holder is named only
    when its process is that owner's, or one tc cannot look at
    (process_uid None: /proc may hide it; only the owner can open a lock
    at WAKE_LOCK_MODE). So no other member's pid is ever reported as a
    name's listener. The output keeps its shape (name to pid or None), so
    tc health, tc watch and the board (C6) read it unchanged. The
    switch-over (OLD_WAKE_LOCK_NAME), on a private mailbox only (`shared`
    False; None means look at ROOT/.shared here, and an unreadable one
    counts as shared): a lock at the old place, mail/.<kind>-<name>.lock,
    is still listed, and its holder is reported for a name whose new lock
    nobody holds, so a listener started before round 1b stays named until
    it re-arms. It can go once every session has re-armed (a later task).

    @interacts  reads ROOT/.shared when `shared` is None (shared_group);
                reads /proc/locks; opens and lists mail/, opens each inbox
                by name and lstats its lock in it; stats /proc/<pid> of
                each holder found; on a private mailbox lstats each old
                lock in mail/ by name. Writes nothing.
    @deps       shared_group, open_mail, pin_folder, unpin, _flock_holders,
                _lock_key, process_uid; os, stat; MAIL, WAKE_LOCK_NAME,
                OLD_WAKE_LOCK_NAME.
    @complexity O(k + n log n) over k lines in /proc/locks (tens) and n
                entries in mail/ (inboxes and locks, a few dozen): one
                listing, one folder open and one lstat per inbox, one
                /proc stat per holder, and a sort.
    @alloc      the holder map, the names of mail/ and one dict of names,
                returned; one inbox descriptor at a time.
    """
    if shared is None:  # P3 fix round 1b (Claude Opus 5.5, unreviewed): the switch-over is private only
        try:
            shared = shared_group() is not None
        except ValueError:
            shared = True
    holders = _flock_holders()
    out = {}
    try:  # P3 fix round 1b (Claude Opus 5.5, unreviewed): D35, mail/ once, each inbox by name in it
        mail_fd = open_mail()
    except OSError:
        mail_fd = None
    if mail_fd is None:
        return out
    try:
        try:
            names = sorted(os.listdir(mail_fd))
        except OSError:
            names = []
        lock_name = WAKE_LOCK_NAME.format(kind=kind)
        for entry in names:
            if not entry.startswith("to-"):
                continue
            box = pin_folder(mail_fd, entry, MAIL / entry)
            if box.fd is None:
                continue
            try:
                st = os.stat(lock_name, dir_fd=box.fd, follow_symlinks=False)
            except OSError as err:
                st = None if isinstance(err, FileNotFoundError) else err
            finally:
                unpin(box)
            if isinstance(st, OSError):
                out[entry[len("to-"):]] = None
                continue
            if st is None or not stat.S_ISREG(st.st_mode) or st.st_uid != box.st.st_uid:
                continue  # nothing there, a link or a FIFO, or a file another user planted: nobody's lock
            owner = box.st.st_uid
            out[entry[len("to-"):]] = next((pid for pid in holders.get(_lock_key(st), [])
                                            if process_uid(pid) in (owner, None)), None)
        if not shared:  # the switch-over (OLD_WAKE_LOCK_NAME): a listener from before round 1b, private only
            lead, _, tail = OLD_WAKE_LOCK_NAME.format(kind=kind, name="\0").partition("\0")
            for entry in names:
                if not (entry.startswith(lead) and entry.endswith(tail)) or len(entry) <= len(lead) + len(tail):
                    continue
                name = entry[len(lead):-len(tail)]
                try:
                    st = os.stat(entry, dir_fd=mail_fd, follow_symlinks=False)
                except OSError:
                    continue
                if not stat.S_ISREG(st.st_mode):
                    continue
                pid = next(iter(holders.get(_lock_key(st), [])), None)
                if out.get(name) is None and (pid is not None or name not in out):
                    out[name] = pid
    finally:
        os.close(mail_fd)
    return dict(sorted(out.items()))


# P3 fix round 1b (Claude Opus 5.5, unreviewed): D35 (3), tc health lists a
# lock held by someone other than its name's owner.
def held_by_others(shared):
    """Each wait, watch or inbox lock held by a process whose Linux user is not the name's owner: a list of {"name", "lock", "path", "pid", "user", "owner"}, in name order, for tc health. [] on a private mailbox (`shared` False), which has one user, so it never fires.

    A name's owner is the owner of cards/<name>.json, or with no card the
    owner of its inbox; a name with neither is left out. Its wait and
    watch locks are lstat()ed by name in its inbox, opened once in
    mail/'s descriptor (pin_folder), and its inbox lock by name in
    mail/'s; each that is a regular file is looked up in /proc/locks, and
    each holder whose process tc can see (process_uid) and is not the
    owner's is listed: a member holding another member's inbox lock (D20
    lets any member, for a send's moment), or a file someone planted at
    a wait or watch lock's name and holds. lock is "wait", "watch" or
    "inbox"; user and owner are logins (user_name). The gate's health
    leaves this out (GATE_HEALTH_KEYS does not name it; P3 fix round 1c).

    @interacts  reads /proc/locks; opens and lists mail/, opens each inbox
                by name, lstats each lock by name; lstats cards/<name>.json;
                stats /proc/<pid> of each holder; reads the user database.
                Writes nothing.
    @deps       open_mail, pin_folder, unpin, _flock_holders, _lock_key,
                process_uid, user_name; os, stat; MAIL, CARDS,
                WAKE_LOCK_KINDS, WAKE_LOCK_NAME, NOT_PINNED.
    @complexity O(k + n log n + h) over k lines in /proc/locks (tens), n
                entries in mail/ (inboxes and inbox locks, a few dozen),
                and h holders of their locks: three lstats per name.
    @alloc      the holder map, the names of mail/ and one dict per lock
                held by someone else, returned; one inbox descriptor at a
                time.
    """
    found = []
    if not shared:
        return found
    holders = _flock_holders()
    try:
        mail_fd = open_mail()
    except OSError:
        mail_fd = None
    if mail_fd is None:
        return found
    try:
        try:
            entries = os.listdir(mail_fd)
        except OSError:
            entries = []
        boxes = {entry[len("to-"):] for entry in entries if entry.startswith("to-")}
        inbox_locks = {entry[len(".box-"):-len(".lock")] for entry in entries
                       if entry.startswith(".box-") and entry.endswith(".lock") and len(entry) > len(".box-.lock")}
        for name in sorted(boxes | inbox_locks):
            box = pin_folder(mail_fd, f"to-{name}", MAIL / f"to-{name}") if name in boxes else NOT_PINNED
            try:
                try:
                    owner = os.lstat(CARDS / f"{name}.json").st_uid
                except OSError:
                    owner = box.st.st_uid if box.st is not None else None
                if owner is None:
                    continue
                places = [(kind, box.fd, WAKE_LOCK_NAME.format(kind=kind), MAIL / f"to-{name}") for kind in WAKE_LOCK_KINDS
                          if box.fd is not None]
                if name in inbox_locks:
                    places.append(("inbox", mail_fd, f".box-{name}.lock", MAIL))
                for lock, folder_fd, lock_name, folder in places:
                    try:
                        st = os.stat(lock_name, dir_fd=folder_fd, follow_symlinks=False)
                    except OSError:
                        continue
                    if not stat.S_ISREG(st.st_mode):
                        continue
                    for pid in holders.get(_lock_key(st), []):
                        uid = process_uid(pid)
                        if uid is not None and uid != owner:
                            found.append({"name": name, "lock": lock, "path": str(folder / lock_name), "pid": pid,
                                          "user": user_name(uid), "owner": user_name(owner)})
            finally:
                unpin(box)
    finally:
        os.close(mail_fd)
    return found


# P3 fix round 1c (Claude Opus 5.5, unreviewed): D36 (4), the audit's
# LOW-4. A queue that stays stuck is shown, not hidden (C3).
def note_first_line(name, folder_fd):
    """The first line of the note `name` in the folder open at `folder_fd`, through printable(); None when there is none or tc cannot read it as a regular file.

    Opened by its name in the open folder, never through a link, never
    blocking on a FIFO, and checked with fstat; at most
    NOTE_LINE_READ_MAX_BYTES are read, and bytes that are not UTF-8 read as
    replacement characters.

    @interacts  opens, fstats and reads one file by name; closes it.
    @deps       printable; os, stat; NOTE_LINE_READ_MAX_BYTES.
    @complexity O(1): at most NOTE_LINE_READ_MAX_BYTES read.
    @alloc      the bytes read and one string, returned.
    """
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=folder_fd)
    except OSError:
        return None
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return None
        data = os.read(fd, NOTE_LINE_READ_MAX_BYTES)
    except OSError:
        return None
    finally:
        os.close(fd)
    return printable(data.decode("utf-8", errors="replace").partition("\n")[0])


def stuck_outbox():
    """Every outbox message that has waited longer than OUTBOX_STALE_SECONDS, in any branch this user can read, retried or not: a list of {"member", "to", "path", "age_s", "note"} in branch and queue order, for tc health (D36 (4)).

    outbox/ is opened by its path (the init user's, D34), each branch by
    its name in it (pin_folder, never through a link) and listed in its
    descriptor (outbox_files); each queue holding a message that old is
    opened again by its name in the branch's descriptor to read the first
    line of the note beside it (note_first_line), which the last failed
    try wrote: None when no try failed yet. `member` is the branch's name
    (its member's login), `to` the name the message is for, `age_s` its
    age by its mtime (the publish) against wall_clock. A branch or queue
    this user cannot open is passed over. The gate's health leaves this
    out (GATE_HEALTH_KEYS does not name it).

    @interacts  opens and lists outbox/; opens each branch and each of its
                queues by name and lists them (pin_folder, outbox_files);
                reads one note's first line per old message; reads the
                clock (wall_clock). Writes nothing.
    @deps       pin_folder, unpin, outbox_files, note_first_line,
                note_path, wall_clock; os; ROOT, OUTBOX_NAME,
                TOP_FOLDER_FLAGS, OUTBOX_STALE_SECONDS.
    @complexity O(B + Q + W log W) over B branches (one per member), Q
                queues in them and W waiting files (a handful each), as
                outbox_files per branch, plus one note read per message
                past the bound.
    @alloc      one dict per message past the bound, returned; one
                descriptor per branch and one per queue while it is read.
    """
    now = wall_clock()
    found = []
    top = ROOT / OUTBOX_NAME
    try:
        top_fd = os.open(top, TOP_FOLDER_FLAGS)
    except OSError:
        return found
    try:
        try:
            names = sorted(os.listdir(top_fd))
        except OSError:
            names = []
        for member in names:
            if member.startswith("."):
                continue  # the origin token, a folder moved aside: no branch
            branch = pin_folder(top_fd, member, top / member)
            if branch.fd is None:
                continue
            try:
                for f in outbox_files(top / member, branch.fd)[0]:
                    age = now - f.st.st_mtime
                    if age <= OUTBOX_STALE_SECONDS:
                        continue
                    queue = pin_folder(branch.fd, f"to-{f.to}", top / member / f"to-{f.to}")
                    try:
                        note = None if queue.fd is None else note_first_line(note_path(f.path).name, queue.fd)
                    finally:
                        unpin(queue)
                    found.append({"member": member, "to": f.to, "path": str(f.path), "age_s": round(age),
                                  "note": note})
            finally:
                unpin(branch)
    finally:
        os.close(top_fd)
    return found


def _age(seconds):
    if seconds is None:
        return None
    if seconds < SECONDS_PER_MINUTE:
        return f"{int(seconds)}s"
    if seconds < SECONDS_PER_HOUR:
        return f"{int(seconds // SECONDS_PER_MINUTE)}m"
    if seconds < SECONDS_PER_DAY:
        return f"{int(seconds // SECONDS_PER_HOUR)}h"
    return f"{int(seconds // SECONDS_PER_DAY)}d"


def mailbox_summary():
    """Each inbox's unread count, the age of its newest mail and of its status, and why a count is unknown, by name.

    SHARED fix round 1 (Claude Opus 5.5, unreviewed): an inbox is a real
    folder at mail/to-<name> (lstat). A linked one is left out, as send,
    read and wait refuse it, so this never counts or dates a folder
    outside the mailbox. Only regular *.md files count (message_files),
    unread and in a read/ that is itself a real folder; their ages come
    from lstat, never through a link. SHARED fix round 2 (Claude Opus
    5.5, unreviewed): the audit's LOW-3. That holds for what this
    returns, which tc health shows and any caller may read. The board
    also reads mail/ on its own (its wires and links); that reading is
    the board's, and nothing here governs it.

    SHARED fix round 2 (Claude Opus 5.5, unreviewed): the audit's LOW-2
    and BOARD's review, never a silent 0. When tc cannot list an inbox (a
    3770 inbox seen by a user outside the group), or cannot lstat an entry
    in it (an inbox its owner left readable without search), `unread` is
    None and `mail_problem` says why. When the same goes for read/ (or
    read/ itself cannot be looked at), `newest_mail_age_s` is None and
    `mail_problem` says why. `mail_problem` is None when every entry was
    looked at. Nothing here raises for an inbox it cannot see into.

    SHARED, from BOARD's review (Claude Opus 5.5, unreviewed): a status
    file's age comes from lstat too. A link there, or anything that is
    not a regular file, or one lstat cannot reach, has no status age
    (null). A member who links their status file into a folder others
    cannot search can no longer make this raise PermissionError, and so
    stop tc health.

    P3 fix round 1a (Claude Opus 5.5, unreviewed): D35 and the audit's
    HIGH-1 (breaker's MEDIUM-1 on this function). mail/ is opened once,
    each inbox by its name in it and its read/ by name in the inbox's
    descriptor (open_inbox), and each is listed and its messages stat'ed
    in its own descriptor (message_files), never by a path. So an inbox's
    owner who swaps it for a link after it was opened cannot make tc
    health, the gate's health --json or the board's feed count or date
    the link's target. The read/ of an inbox tc could not open is not
    reached; its count is unknown already.

    @interacts  opens and lists mail/; opens each mail/to-*/ and its read/
                by name (open_inbox), lists each and stats each message
                name in it (message_files), closing both before the next
                inbox; lstats each name's status file. Writes nothing.
    @deps       open_mail, open_inbox, unpin, message_files; os, stat,
                time; STATUS.
    @complexity O(n log n + M + m log m) over n inboxes (a few dozen,
                sorted), M names listed in every inbox and read/, and m
                message files among them (hundreds to thousands, growing
                with the history: read/ is kept), one stat each and a sort
                per folder. tc health runs it once; the board's feed runs
                it on every poll (every 3 s while a page is open).
    @alloc      one dict per inbox, returned; each inbox's name and
                message lists, and its two descriptors, while it is
                counted.
    """
    now = time.time()
    out = {}
    try:  # P3 fix round 1a (Claude Opus 5.5, unreviewed): D35, mail/ opened once, each inbox by name in it
        mail_fd = open_mail()
    except OSError:
        mail_fd = None
    if mail_fd is None:
        return out
    try:
        try:
            names = sorted(name for name in os.listdir(mail_fd) if name.startswith("to-"))
        except OSError:
            names = []
        for entry in names:
            inbox = open_inbox(mail_fd, entry[len("to-"):])
            try:
                box, read = inbox.box, inbox.read
                if box.fd is None and (box.found is None or not stat.S_ISDIR(box.found.st_mode)):
                    continue  # nothing, a link or not a folder: left out, as send, read and wait refuse it
                if box.fd is None:
                    unread, unread_problem, history, history_problem = [], box.problem, [], None
                else:
                    unread, _, unread_problem = message_files(inbox.path, box.fd)  # SHARED fix round 2 (Claude Opus 5.5, unreviewed): LOW-2
                    if read.fd is not None:
                        history, _, history_problem = message_files(inbox.path / "read", read.fd)
                    else:
                        history, history_problem = [], read.problem
            finally:
                unpin(inbox.read, inbox.box)
            name = entry[len("to-"):]
            problem = unread_problem or history_problem
            newest = None if problem else max((st.st_mtime for _, st in unread + history), default=None)
            try:  # SHARED, from BOARD's review (Claude Opus 5.5, unreviewed): lstat, never through a link
                st = os.lstat(STATUS / f"{name}.md")
            except OSError:
                st = None
            out[name] = {
                "unread": None if unread_problem else len(unread),
                "newest_mail_age_s": None if newest is None else round(now - newest),
                "status_age_s": round(now - st.st_mtime) if st is not None and stat.S_ISREG(st.st_mode) else None,
                "mail_problem": problem,
            }
    finally:
        os.close(mail_fd)
    return out


# CARDS R5 (Claude Opus 5.5, unreviewed): the cards tc health shows.
def cards_summary():
    """Every card's name, kind, account, route, reports_to and ssh_target, in name order.

    The name is the file's (cards/<name>.json), the one the router reads.
    ssh_target is an ssh card's target (`u@h`), so `tc health` can say
    what `tc cards` says; null for any other route. A card that is
    not a JSON object keeps its name with the other five fields null, so
    it still shows.

    @interacts  reads cards/*.json through all_cards. Writes nothing.
    @deps       all_cards; pathlib.
    @complexity O(c) over c cards (a few dozen).
    @alloc      one list of c small dicts, returned.
    """
    out = []
    for file_name, card in all_cards():
        card = card or {}
        ssh = card.get("ssh")  # CARDS fix round 1 (Claude Opus 5.5, unreviewed): ssh_target
        target = ssh.get("target") if card.get("route") == "ssh" and isinstance(ssh, dict) else None
        out.append({"name": pathlib.Path(file_name).stem, "kind": card.get("kind"),
                    "account": card.get("account"), "route": card.get("route"),
                    "reports_to": card.get("reports_to"), "ssh_target": target})
    return out


def health_snapshot(cards=True, gpu=True, branches=True):
    """One snapshot of the machine, sessions, listeners, watchers, mail and cards.

    P3 fix round 1b (Claude Opus 5.5, unreviewed): D35 (3).
    `held_by_others` lists each wait, watch or inbox lock held by a
    process whose user is not the name's owner (held_by_others; [] on a
    private mailbox). P3 fix round 1c (Claude Opus 5.5, unreviewed): D36
    (5). Round 1b's `held` switch is gone: the gate prints only the keys
    GATE_HEALTH_KEYS names (gate_health), so who holds what never reaches
    a far key, nor anything else this snapshot gains.

    SSH S3 (Claude Opus 5.5, unreviewed): the gate's `health --json`
    passes both False. `cards` False leaves the `cards` key out, so a far
    key never reads account labels or ssh targets (D16); `gpu` False
    never runs nvidia-smi (machine_stats), so the gate runs no program
    but the codex ring (D18), and `gpus` is null.

    SSH fix round 1 (Claude Opus 5.5, unreviewed): D33 part 1. `squatted`
    lists each branch, in outbox/ or mail/.origins/, named for a user of
    this machine that is not that user's own real folder
    (squatted_branches), with the one command that clears it, so nobody
    learns of it from a failed send. The gate passes `branches` False:
    the paths name this machine's users, which a far key has no need of.
    P3 fix round 1c (Claude Opus 5.5, unreviewed): D36 (4). With
    `branches`, `stuck_outbox` lists every outbox message waiting longer
    than OUTBOX_STALE_SECONDS in any branch this user can read, with its
    member, name, age and the first line of its last failed try's note
    (stuck_outbox); the gate's list leaves it out either way.

    `shared_group` (SHARED H1, Claude Opus 5.5, unreviewed) is the group
    the mailbox is shared with, or null when it is private (C4).
    SHARED fix round 1 (Claude Opus 5.5, unreviewed): the audit's LOW-8.
    An unreadable .shared never raises here: `shared_group` is null and
    `shared_problem` says why. `shared_problem` is null otherwise.
    Reworded from BOARD's review (Claude Opus 5.5, unreviewed): the
    reason is tc health's own, since BOARD's feed builds from tc's parts
    and never calls this. main() refuses tc health on a .shared that is
    already unreadable, before this runs, but one that turns unreadable
    after main() read it still gets an answer, not a traceback, and so
    does any caller that loads tc as a module (the tests do). tc watch
    does not call this. SHARED fix round 2 (Claude Opus 5.5,
    unreviewed): each `mail` entry carries `mail_problem`, and its
    `unread` or `newest_mail_age_s` is null when tc could not see into
    that inbox or its read/ (mailbox_summary, the audit's LOW-2).

    P3 fix round 1b (Claude Opus 5.5, unreviewed): D35 (1). `listeners`
    and `watchers` come from each name's lock in its own inbox
    (listeners), told once whether the mailbox is shared (an unreadable
    .shared counts as shared), so the switch-over's old place is read on
    a private mailbox only.

    @interacts  reads /proc, mail/ and each inbox in it, status/, cards/ (only when `cards`)
                and ROOT/.shared; lists outbox/ and mail/.origins/, and
                each outbox branch and queue this user can open, reading
                the note beside each message past OUTBOX_STALE_SECONDS
                and the clock (only when `branches`); on a shared
                mailbox lstats each name's
                locks and card and stats each holder's /proc/<pid>
                (held_by_others); may run nvidia-smi (machine_stats, only
                when `gpu`). Writes nothing.
    @deps       now_iso, machine_stats, session_counts, listeners,
                mailbox_summary, cards_summary, squatted_branches,
                stuck_outbox, held_by_others, shared_group.
    @complexity O(p + k + n log n + M + m log m + c + e + h + W log W):
                p processes, k lines in /proc/locks, n mailbox names, M
                names in every inbox and read/ and the m message files
                among them (mailbox_summary lists each folder in its
                descriptor, sorts its message names and stats each one:
                hundreds to thousands, growing with the history), c cards,
                e entries in outbox/ and mail/.origins/ (one per member
                each), h holders of the names' locks (held_by_others), W
                files waiting in every outbox branch (stuck_outbox).
    @alloc      one dict, returned.
    """
    try:  # SHARED fix round 1 (Claude Opus 5.5, unreviewed): LOW-8, a field, never a raise
        group, problem = shared_group(), None
    except ValueError as err:
        group, problem = None, str(err)
    shared = group is not None or problem is not None  # P3 fix round 1b (Claude Opus 5.5, unreviewed): unreadable counts as shared
    snap = {"time": now_iso(), "machine": machine_stats(gpu), "sessions": session_counts(),
            "listeners": listeners("wait", shared), "watchers": listeners("watch", shared),
            "mail": mailbox_summary()}
    if cards:  # SSH S3 (Claude Opus 5.5, unreviewed): D16, never for the gate
        snap["cards"] = cards_summary()
    if branches:  # SSH fix round 1 (Claude Opus 5.5, unreviewed): D33 part 1, never for the gate
        snap["squatted"] = squatted_branches()
        snap["stuck_outbox"] = stuck_outbox()  # P3 fix round 1c (Claude Opus 5.5, unreviewed): D36 (4)
    snap["held_by_others"] = held_by_others(shared)  # P3 fix round 1b (Claude Opus 5.5, unreviewed): D35 (3); the gate's list leaves it out (1c)
    snap["shared_group"], snap["shared_problem"] = group, problem  # SHARED H1 (Claude Opus 5.5, unreviewed): C4
    return snap


def _gpu_text(gpus):
    if not gpus:
        return "GPU none"
    return " · ".join(f"GPU {g['temp_c']}C {g['util_pct']}%" for g in gpus)


# Phase fix round 1 (Claude Opus 5.5, unreviewed): names escaped, and this block.
def _who(table):
    """Listener or watcher names in words: `<name> (pid <p>)` for each live one, then the stopped ones.

    A name comes from a lock file's name, so it goes through printable().

    @interacts  none; string work only.
    @deps       printable.
    @complexity O(n) over n names in `table` (a few dozen).
    @alloc      two lists and one string, returned.
    """
    up = [f"{printable(n)} (pid {pid})" for n, pid in table.items() if pid]
    down = [printable(n) for n, pid in table.items() if not pid]
    text = " · ".join(up) if up else "none running"
    return text + (f" · stopped: {', '.join(down)}" if down else "")


def cmd_health(args):
    """`tc health [--json]`: the snapshot, as JSON or one screen of words.

    In words, every card field and every name taken from a file name (a
    card, an inbox, a listener's lock) goes through printable(); the JSON
    is escaped by json.dumps. The last line says `mailbox shared with
    group <g>` or `mailbox private` (C4).

    SHARED fix round 2 (Claude Opus 5.5, unreviewed): the audit's LOW-4
    and LOW-2. When health_snapshot reports `shared_problem` (.shared
    turned unreadable after main() read it), the last line is `mailbox
    shared, group unknown: <why>`, never `mailbox private`. An inbox whose
    count mailbox_summary could not know reads `unread unknown`, then the
    reason, never `0 unread`.

    SSH fix round 1 (Claude Opus 5.5, unreviewed): D33 part 1. One
    `squatted` line per branch that is not its member's own, naming what
    is there and the one command the user who ran init runs.

    P3 fix round 1b (Claude Opus 5.5, unreviewed): D35 (3). One `held`
    line per wait, watch or inbox lock held by someone other than its
    name's owner, naming the lock, the holder's user and pid, and the
    owner (held_by_others); never on a private mailbox.

    P3 fix round 1c (Claude Opus 5.5, unreviewed): D36 (4). One `stuck`
    line per outbox message waiting past OUTBOX_STALE_SECONDS
    (stuck_outbox): its path, member, the name it is for, its age, and
    the first line of its last failed try's note, or that none is noted.

    @interacts  see health_snapshot; prints to stdout.
    @deps       health_snapshot, describe_card, printable, _who, _age,
                _gpu_text; json.
    @complexity as health_snapshot.
    @alloc      the snapshot and the printed text, freed on exit.
    """
    snap = health_snapshot()
    if args.json:
        print(json.dumps(snap, indent=2))
        return
    m, s = snap["machine"], snap["sessions"]
    print(f"machine    load {m['load1']} / {m['cores']} cores · mem free {m['mem_avail_pct']}% · {_gpu_text(m['gpus'])}")
    print(f"sessions   {s['claude']} Claude Code · {s['codex']} Codex")
    print(f"listeners  {_who(snap['listeners'])}")
    print(f"watchers   {_who(snap['watchers'])}")
    # CARDS R5 (Claude Opus 5.5, unreviewed): one line per card, `?` for a field it lacks.
    cards = []
    for c in snap["cards"]:
        shown = {k: ("?" if v is None and k != "reports_to" else v) for k, v in c.items()}
        if c["ssh_target"] is not None:  # CARDS fix round 1 (Claude Opus 5.5, unreviewed): `route ssh to <target>`
            shown["ssh"] = {"target": c["ssh_target"]}
        cards.append(describe_card(shown))
    print("cards      " + ("\n           ".join(cards) if cards else "none"))
    rows = []
    for name, b in snap["mail"].items():
        bits = ["unread unknown" if b["unread"] is None else f"{b['unread']} unread"]  # SHARED fix round 2 (Claude Opus 5.5, unreviewed): LOW-2
        if b["newest_mail_age_s"] is not None:
            bits.append(f"last mail {_age(b['newest_mail_age_s'])} ago")
        if b["status_age_s"] is not None:
            bits.append(f"status {_age(b['status_age_s'])} ago")
        if b["mail_problem"] is not None:
            bits.append(printable(b["mail_problem"]))
        rows.append(f"{printable(name)}: " + ", ".join(bits))  # Phase fix round 1 (Claude Opus 5.5, unreviewed)
    print("mail       " + ("\n           ".join(rows) if rows else "empty"))
    for squat in snap["squatted"]:  # SSH fix round 1 (Claude Opus 5.5, unreviewed): D33 part 1
        print(f"squatted   {printable(squat['path'])}: {printable(squat['why'])}; {printable(squat['fix'])}")
    for stuck in snap["stuck_outbox"]:  # P3 fix round 1c (Claude Opus 5.5, unreviewed): D36 (4)
        last = f"last failed try: {stuck['note']}" if stuck["note"] is not None else "no failed try noted beside it"
        print(f"stuck      {printable(stuck['path'])}: {printable(stuck['member'])}'s mail to "
              f"{printable(stuck['to'])}, waiting {_age(stuck['age_s'])}; {last}")
    for hold in snap["held_by_others"]:  # P3 fix round 1b (Claude Opus 5.5, unreviewed): D35 (3)
