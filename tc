                fail(f"{path} is in group {printable(group_name(st.st_gid))}, not "
                     f"{printable(share.group)}; under a shared mailbox every folder under mail/, "
                     f"status/, cards/ and outbox/ is in that group, or other members cannot use it. "
                     f"Nothing written. Its owner, {user_name(st.st_uid)}, "
                     f"{OWN_FIX_WORDS.format(group=printable(share.group))}.")
            return
    elif path.is_dir():
        return
    if not path.parent.is_dir():
        make_folder_with(path.parent, share, raising)
    branch = share is not None and shared_folder_mode(path) == SHARED_BRANCH_MODE  # SSH fix round 1 (Claude Opus 5.5, unreviewed): D33
    try:
        if branch:
            os.mkdir(path, NEW_BRANCH_FOLDER_MODE)
        else:
            os.mkdir(path)
    except FileExistsError:
        if not path.is_dir():
            raise
        return
    if share is None:
        return
