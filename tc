def unread_count(name):
    """How many unread messages mail/to-<name>/ holds; 0 with no inbox.

    Unlike unread(), it never creates the inbox. SHARED fix round 1
    (Claude Opus 5.5, unreviewed): only a real folder counts (lstat), so a
    linked inbox holds 0, as send, read and wait refuse it; and only
    regular files count (message_files), as `tc read` moves only those.

    @interacts  lstats mail/to-<name>; lists it and lstats each *.md
                entry. Writes nothing.
    @deps       real_folder, message_files; MAIL.
    @complexity O(u) over u *.md entries in the inbox (single digits).
    @alloc      two lists, freed on return.
    """
    box = MAIL / f"to-{name}"
    return len(message_files(box)[0]) if real_folder(box) else 0


def refuse(words, code):
    """Print `words` to stderr and exit with `code`.

    @interacts  writes one line to stderr; exits.
    @deps       sys.
    @complexity O(1).
    @alloc      none.
    """
    print(words, file=sys.stderr)
    sys.exit(code)


def refuse_self_report(name, reports_to):
    """Exit EXIT_BAD_NAME when a name says it reports to itself (C1).

    @interacts  writes one line to stderr and exits on a self-report.
    @deps       refuse.
    @complexity O(c) over the name's characters.
