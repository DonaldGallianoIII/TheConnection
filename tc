# P3 fix round 1a (Claude Opus 5.5, unreviewed): D35, every inbox act goes
# through one pinned handle (the audit's HIGH-1, audits/2026-10-15-1409-full;
# known bug no-follow-open-guards-only-the-last-name). A member who owns an
# inbox, or an outbox branch, may rename it in the sticky, group-writable
# mail/ or outbox/ and put a link or another folder at its name, and D34
# protects members from each other. So a command opens each such folder
# once, by its name in its parent's descriptor and never through a link,
# and every act on it after is by name in that descriptor, never by a path.
# What pin_folder found: the folder's descriptor and fstat result (None
# when it was not opened); when the open failed, the lstat result of what
# has the name (None when there is nothing, or lstat failed too), which
# tells a link or a non-folder; for a folder there that could not be
# opened or looked at, the words every command said for one before
# ("tc could not list <path> (<why>)", "tc could not look at <path>
# (<why>)") and the why alone; and whether this call made it.
Pinned = collections.namedtuple("Pinned", "fd st found problem why made")
# Nothing at the name, or nothing tried (the read/ of an inbox that did not open).
NOT_PINNED = Pinned(None, None, None, None, None, False)


def pin_folder(folder_fd, name, path, make=False):
    """The folder `name` in the folder open at `folder_fd`, opened once and never through a link: a Pinned. `path` names it, in the words only.

    Opened with FOLDER_FLAGS by its name in the open folder, so a link at
    the name fails the open (Linux says ENOTDIR or ELOOP) and no folder
    above it is resolved again. `make` True makes a missing one first by
    its name in the open folder, a plain mkdir as make_folder makes one in
    a private mailbox (the caller passes it for a private mailbox only),
    then opens it. When the open fails, the name is lstat()ed in the open
    folder for the words only: a link or anything but a folder comes back
    as `found` with no problem; a folder this user may not open (no read)
    as `tc could not list <path>`; a name lstat cannot reach (no search on
    the open folder) as `tc could not look at <path>`.

    @interacts  opens one folder by its name in `folder_fd` and fstats it;
                when `make` and it is missing, makes it first; when the
                open fails, lstats the name. Writes nothing else.
    @deps       os, stat, contextlib; FOLDER_FLAGS, Pinned, NOT_PINNED.
    @complexity O(1): at most two opens, one mkdir and one lstat.
    @alloc      one descriptor in the Pinned (the caller closes it, unpin),
                or none; one stat result.
    """
    try:
        fd = os.open(name, FOLDER_FLAGS, dir_fd=folder_fd)
    except FileNotFoundError:
        if not make:
            return NOT_PINNED
        try:
            os.mkdir(name, dir_fd=folder_fd)
            made = True
        except FileExistsError:
            made = False  # made meanwhile: opened and judged like any other
        return pin_folder(folder_fd, name, path)._replace(made=made)
    except OSError as err:
        try:
            found = os.lstat(name, dir_fd=folder_fd)
        except FileNotFoundError:
            return NOT_PINNED
        except OSError as stuck:
            return Pinned(None, None, None, f"tc could not look at {path} ({stuck.strerror})", stuck.strerror, False)
        if stat.S_ISDIR(found.st_mode):
            return Pinned(None, None, found, f"tc could not list {path} ({err.strerror})", err.strerror, False)
        return Pinned(None, None, found, None, None, False)
    try:
        return Pinned(fd, os.fstat(fd), None, None, None, False)
    except BaseException:
        os.close(fd)
        raise


def unpin(*pinned):
    """Close the descriptor of each Pinned in `pinned` that holds one.

    @interacts  closes descriptors.
    @deps       os.
    @complexity O(p) over p Pinned given (one or two).
    @alloc      none.
    """
    for folder in pinned:
        if folder.fd is not None:
            os.close(folder.fd)


def name_taken(name, folder_fd):
    """True when anything, a link included, has the name `name` in the folder open at `folder_fd`: os.path.lexists, by name in an open folder. False when lstat cannot reach it for any reason, as lexists answers.

    @interacts  lstats one name in `folder_fd`. Writes nothing.
    @deps       os.
    @complexity O(1).
    @alloc      one stat result, freed on return.
    """
    try:
        os.lstat(name, dir_fd=folder_fd)
    except OSError:
        return False
    return True


def open_mail(make=False):
    """mail/'s descriptor, opened by its path (TOP_FOLDER_FLAGS), or None when there is no mail/. With `make`, a missing mail/ is made first (make_folder). Raises OSError for any other failure.

    @interacts  opens mail/; when `make` and it is missing, reads
                ROOT/.shared and makes it (make_folder).
    @deps       make_folder; os; MAIL, TOP_FOLDER_FLAGS.
    @complexity O(1), plus make_folder's when it makes mail/.
    @alloc      one descriptor, returned (the caller closes it).
    """
    try:
        return os.open(MAIL, TOP_FOLDER_FLAGS)
    except FileNotFoundError:
        if not make:
            return None
    make_folder(MAIL)
    return os.open(MAIL, TOP_FOLDER_FLAGS)


# An inbox as one command holds it (open_inbox, pinned_inbox): its path,
# for the words only; whether the mailbox is shared (None when the caller
# had no need to know); and the Pinned of mail/to-<name>/ and of its read/
# (NOT_PINNED when the inbox itself did not open).
Inbox = collections.namedtuple("Inbox", "path shared box read")


def open_inbox(mail_fd, name, shared=None, make_inbox=False, make_read=False):
    """mail/to-<name>/ and its read/, each opened once by its name and never through a link (pin_folder): an Inbox. The caller closes both (unpin). `mail_fd` is mail/'s descriptor, or None when there is no mail/.

    read/ is opened by its name in the inbox's own descriptor, so it is
    the read/ of the folder that was opened. `make_inbox` makes a missing
    inbox and its read/, and `make_read` a missing read/ in an inbox that
    is there; a caller passes them for a private mailbox only, whose inbox
    tc makes on first use (a send, a wait; a read or a peek makes only
    read/, never the inbox: O2). `shared` is kept in the Inbox as given.

    @interacts  opens mail/to-<name>/ by its name in `mail_fd` and its
                read/ by name in the inbox's descriptor (pin_folder),
                making each when told and missing. Writes nothing else.
    @deps       pin_folder, unpin; MAIL, Inbox, NOT_PINNED.
    @complexity O(1): two folders.
    @alloc      up to two descriptors in the Inbox, which the caller
                closes.
    """
    path = MAIL / f"to-{name}"
    if mail_fd is None:
        return Inbox(path, shared, NOT_PINNED, NOT_PINNED)
    box = pin_folder(mail_fd, path.name, path, make_inbox)
    if box.fd is None:
        return Inbox(path, shared, box, NOT_PINNED)
    try:
        return Inbox(path, shared, box, pin_folder(box.fd, "read", path / "read", make_inbox or make_read))
    except BaseException:
        unpin(box)
        raise


def refuse_bad_inbox(inbox, name):
    """Refuse (exit 1, check_inbox's words) what check_inbox refused, judged on the open folders of `inbox`, the Inbox of `name`: an inbox lstat cannot reach; a link or not a folder at the inbox's name or its read/'s (D17); a read/ there that could not be opened or looked at; and, when shared, an inbox or read/ whose owner is not its card's owner (D20 item 4). Else nothing.

    An inbox that is there, a folder, and could not be opened is not
    refused here: its `box.problem` says why, and the caller words it for
    its own act (inbox_messages for a listing, deliver_local for a send).

    @interacts  lstats cards/<name>.json when shared and the inbox is
                there; reads the user database for the words; on a
                refusal, one line to stderr and exit 1.
    @deps       refuse, user_name; os, stat; CARDS, EXIT_REFUSED.
    @complexity O(1).
    @alloc      the words, on a refusal.
    """
    read_path = inbox.path / "read"
    if inbox.box.problem is not None and inbox.box.found is None:  # lstat could not reach the inbox at all
        refuse(f"tc: could not look at {inbox.path} ({inbox.box.why}); nothing was read or written there.",
               EXIT_REFUSED)
    for path, folder in ((inbox.path, inbox.box), (read_path, inbox.read)):
        if folder.found is not None and stat.S_ISLNK(folder.found.st_mode):
            refuse(f"tc: {path} is a symlink, not a real folder; tc never follows it, so nothing "
                   f"was read or written there", EXIT_REFUSED)
        if folder.found is not None and not stat.S_ISDIR(folder.found.st_mode):
            refuse(f"tc: {path} is not a folder; nothing was read or written there", EXIT_REFUSED)
    if inbox.read.problem is not None:
        refuse(f"tc: could not look at {read_path} ({inbox.read.why}); nothing was read or written there. "
               f"{inbox.path} belongs to {user_name(inbox.box.st.st_uid)}.", EXIT_REFUSED)
    box_st = inbox.box.st or inbox.box.found
    if inbox.shared and box_st is not None:
        card = CARDS / f"{name}.json"
        try:
            card_uid = os.lstat(card).st_uid
        except FileNotFoundError:
            card_uid = None
        for path, st in ((inbox.path, box_st), (read_path, inbox.read.st)):
            if card_uid is not None and st is not None and st.st_uid != card_uid:
                refuse(f"tc: {path} belongs to {user_name(st.st_uid)}, but its card {card} belongs to "
                       f"{user_name(card_uid)}; under a shared mailbox an inbox belongs to the owner of "
                       f"its card, and tc never guesses which one is right. Nothing was read or written "
                       f"there.", EXIT_REFUSED)


@contextlib.contextmanager
def pinned_inbox(name, shared=None, make_inbox=False, make_read=False, check=True):
    """mail/to-<name>/ and its read/, opened once for one command and held open for the `with` block: yields an Inbox. Every descriptor is closed when the block ends, whatever happens.

    mail/ is opened by its path (open_mail; only the init user can swap
    it, D34), then the inbox and its read/ by name (open_inbox), and
    mail/'s descriptor is closed at once. From here every act on the inbox
    is by name in these descriptors (D35), so a member who swaps the
    inbox, or its read/, for a link or another folder after this point
    leads tc nowhere: the descriptors still hold the folders opened.
    `shared` None means look it up here (mailbox_share) when it is
    needed: to check, or to make. A private mailbox makes what
    `make_inbox` and `make_read` say (and mail/ itself, through
    make_folder, when `make_inbox` finds none); a shared one makes
    nothing: only tc join makes an inbox there, as its recipient (D20).

    `check` True (send, the gate, read, peek, wait, the codex route)
    refuses before anything is read or written, as check_inbox did
    (refuse_bad_inbox), and refuses a mail/ it cannot open with
    check_inbox's words. `check` False (unread_count) refuses nothing and
    reads no .shared: the caller reads what came back.

    @interacts  reads ROOT/.shared when `shared` is None and it checks or
                makes (mailbox_share); opens mail/ (open_mail, making it
                when a private `make_inbox` finds none), the inbox and its
                read/ (open_inbox); with `check`, see refuse_bad_inbox;
                closes every descriptor when the block ends.
    @deps       mailbox_share, open_mail, open_inbox, refuse_bad_inbox,
                unpin, refuse; contextlib, os; MAIL, EXIT_REFUSED.
    @complexity O(1): three folders opened, one closed at once.
    @alloc      up to two descriptors, held for the block and closed after.
    """
    if shared is None and (check or make_inbox or make_read):
        shared = mailbox_share() is not None
    make = shared is not None and not shared
    try:
        mail_fd = open_mail(make and make_inbox)
    except OSError as err:
        if check:
            refuse(f"tc: could not look at {MAIL / f'to-{name}'} ({err.strerror}); nothing was read or written "
                   f"there.", EXIT_REFUSED)
        mail_fd = None
    try:
        inbox = open_inbox(mail_fd, name, shared, make and make_inbox, make and make_read)
    finally:
        if mail_fd is not None:
            os.close(mail_fd)
    try:
        if check:
            refuse_bad_inbox(inbox, name)
        yield inbox
    finally:
        unpin(inbox.read, inbox.box)


@contextlib.contextmanager
def inbox_made(inbox, name):
    """`inbox`, the open Inbox of `name`, with what a private mailbox lacks made now and opened: yields an Inbox, and closes what it opened itself when the block ends (the caller closes its own).

    For a private send, which makes the inbox and its read/ on first use
    only after it took its number (deliver_local), as before, so a send
    refused before it lands makes nothing. A missing inbox was never
    pinned: it is made by its name in mail/ (mail/ too when missing),
    opened then and judged as pinned_inbox judges one (refuse_bad_inbox,
    exit 1); a missing read/ is made by its name in the inbox's open
    descriptor (pin_folder). A shared mailbox makes nothing here (D20):
    `inbox` comes back as it was.

    @interacts  private only: may read ROOT/.shared and make mail/
                (open_mail), make and open the inbox and read/ by name
                (open_inbox, pin_folder), refuse a bad one (exit 1); closes
                what it opened when the block ends.
    @deps       open_mail, open_inbox, refuse_bad_inbox, pin_folder, unpin;
                contextlib, os.
    @complexity O(1).
    @alloc      up to two descriptors, held for the block and closed after.
    """
    opened = []
    try:
        if inbox.shared is False and inbox.box.fd is None:
            mail_fd = open_mail(make=True)
            try:
                inbox = open_inbox(mail_fd, name, inbox.shared, make_inbox=True)
            finally:
                os.close(mail_fd)
            opened += [inbox.read, inbox.box]
            refuse_bad_inbox(inbox, name)
        elif (inbox.shared is False and inbox.read.fd is None and inbox.read.found is None
              and inbox.read.problem is None):
            inbox = inbox._replace(read=pin_folder(inbox.box.fd, "read", inbox.path / "read", make=True))
            opened.append(inbox.read)
        yield inbox
    finally:
        unpin(*opened)


def message_files(folder, folder_fd):
    """The message entries of the folder open at `folder_fd` as (messages, skipped, problem): (path, stat result) for each regular file whose name ends in MESSAGE_SUFFIX, in name order; (path, why) for the rest of those names (D19); words when a count from them is not the whole truth, else None. `folder` is the folder's path, for the paths and the words only.

    Listed and stat'ed by name in the open folder, never by a path (P3
    fix round 1a, Claude Opus 5.5, unreviewed: D35), and never followed:
    a symlink, a FIFO or a folder named like a message is skipped, so
    read, peek, log, wait and the counts leave it out, and no wait wakes
    for it. An entry gone before its stat is left out. The names are
    sorted as strings, and MESSAGE_SUFFIX picks them (the audit's LOW-7
    and LOW-8).

    SHARED fix round 2 (Claude Opus 5.5, unreviewed): the audit's LOW-2
    and BOARD's review. A folder tc could not list holds no messages, and
    `problem` says why. An entry stat cannot reach (any OSError but gone:
    a folder its owner left readable without search, say) is skipped
    with words and named in `problem`, never a traceback. So `problem`
    None means every entry was looked at. read, peek and log name the
    skipped ones; mailbox_summary reports a count it cannot know as
    unknown, with `problem`.

    @interacts  lists the folder at `folder_fd` and stats each name ending
                in MESSAGE_SUFFIX in it, never following a link. Writes
                nothing.
    @deps       os, stat, pathlib; MESSAGE_SUFFIX.
    @complexity O(E + e log e) over E names in the folder and the e of
                them that end in MESSAGE_SUFFIX: one listing, a sort of
                e name strings and one stat each. e is single digits in an
                inbox; a read/ is the history (hundreds to thousands, and
                growing), listed by log, by health and by every poll of
                the board's feed (mailbox_summary, every 3 s).
    @alloc      the E names while it runs; two lists of e entries and at
                most one string, returned.
    """
    messages, skipped = [], []
    try:  # SHARED fix round 2 (Claude Opus 5.5, unreviewed): a folder tc could not list is said, never a silent 0
        names = os.listdir(folder_fd)
    except OSError as err:
        return messages, skipped, f"tc could not list {folder} ({err.strerror})"
    problem = None
    for name in sorted(name for name in names if name.endswith(MESSAGE_SUFFIX)):
        path = folder / name
        try:
            st = os.stat(name, dir_fd=folder_fd, follow_symlinks=False)
        except FileNotFoundError:
            continue
        except OSError as err:  # SHARED fix round 2 (Claude Opus 5.5, unreviewed): from BOARD's review
            skipped.append((path, f"tc could not look at it ({err.strerror})"))
            problem = problem or f"tc could not look at {path} ({err.strerror})"
            continue
        if stat.S_ISREG(st.st_mode):
            messages.append((path, st))
        else:
            skipped.append((path, "it is a symlink, which tc never follows" if stat.S_ISLNK(st.st_mode)
                            else "it is not a regular file"))
    return messages, skipped, problem


def inbox_messages(inbox):
    """The unread mail in the open inbox `inbox` (an Inbox from pinned_inbox) as (paths, skipped): the regular files, by name, and (path, why) for each other message name.

    Listed in the inbox's own descriptor (message_files), never by its
    path, so it is always the folder pinned_inbox opened and checked
    (P3 fix round 1a, Claude Opus 5.5, unreviewed: D35). No inbox holds
    nothing.

    SHARED fix round 3 (Claude Opus 5.5, unreviewed): the audit's REC-1.
    An inbox tc cannot list (one that would not open, or message_files
    gives a problem and nothing else) refuses, exit 1, with the reason,
    so peek, read and wait say they could not list it instead of `0
    unread`, `no unread mail` or a quiet timeout. An entry tc could not
    look at stays in skipped, named by the caller, as before.

    @interacts  see message_files; on an inbox it cannot list, one line
                to stderr and exit 1.
    @deps       message_files, refuse; EXIT_REFUSED.
    @complexity O(U + u log u) over U names in the inbox and the u of
                them that are messages (single digits).
    @alloc      two lists, returned.
    """
    if inbox.box.fd is None:
        if inbox.box.problem is not None:
            refuse(f"{inbox.box.problem}, so its unread mail is unknown; nothing was read or moved", EXIT_REFUSED)
        return [], []
    messages, skipped, problem = message_files(inbox.path, inbox.box.fd)  # an entry tc could not look at is in skipped
    if problem is not None and not messages and not skipped:  # SHARED fix round 3 (Claude Opus 5.5, unreviewed): REC-1, not listed
        refuse(f"{problem}, so its unread mail is unknown; nothing was read or moved", EXIT_REFUSED)
    return [path for path, _ in messages], skipped


def unread(name, shared=None):
    """The unread messages in mail/to-<name>/: each message there that is a regular file, by path (D19). One poll of tc wait.

    P3 fix round 1a (Claude Opus 5.5, unreviewed): D35. The inbox is
    opened and checked once for this call (pinned_inbox, which refuses a
    linked inbox or read/, and one not its card owner's, exit 1) and
    listed in its own descriptor (inbox_messages). In a private mailbox a
    missing one is made; in a shared one a missing inbox holds nothing.
    `shared` as in pinned_inbox: a caller that polls passes what it
    found once.

    @interacts  see pinned_inbox and inbox_messages.
    @deps       pinned_inbox, inbox_messages.
    @complexity O(U + u log u) over U names in the inbox and the u of
                them that are messages (single digits).
    @alloc      one list of paths, returned; two descriptors for the call.
    """
    with pinned_inbox(name, shared, make_inbox=True) as inbox:
        return inbox_messages(inbox)[0]


# SHARED fix round 2 (Claude Opus 5.5, unreviewed): D20, a held lock makes a
# command fail, never hang it.
class LockWaitOver(Exception):
    """Raised inside flock_within by its timer while the flock is still waited for."""


# SHARED fix round 3 (Claude Opus 5.5, unreviewed): the audit's LOW-2, one deadline per command.
def lock_deadline():
    """When a command stops waiting for mail/.seq and its inbox lock, on time.monotonic(): now plus LOCK_WAIT_SECONDS.

    A command takes it once, before its first lock, and hands it to each
    flock_within after (inbox_lock, then next_seq on every publish try), so
    all its waits together stay within LOCK_WAIT_SECONDS (C4, D23).

    @interacts  reads the monotonic clock.
    @deps       time; LOCK_WAIT_SECONDS.
    @complexity O(1).
    @alloc      none.
    """
    return time.monotonic() + LOCK_WAIT_SECONDS


def flock_within(f, how, deadline=None):
    """Take the flock `how` on the open file `f`, waiting no later than `deadline` (from lock_deadline; None means LOCK_WAIT_SECONDS from now). True once held; False when the time ran out, with nothing held.

    D20: mail/.seq, the inbox locks and the ring marker are 0664, so any
    group member may open one and hold its flock as long as it likes, and
    a plain flock would wait forever. Here the wait still sits in the
    kernel's queue, as a plain flock does, so the lock is taken the moment
    its holder lets go (and /proc/locks shows this process waiting), but a
    one-shot real-time timer (setitimer, SIGALRM) cuts the wait off at the
    deadline. The timer is cancelled and the old SIGALRM handler
    put back before this returns, whatever happens. A timer that fires
    just as the flock is granted counts as the time running out: the lock
    is let go and False returned, so the caller refuses with nothing
    written. Signal handlers belong to the main thread, so this runs only
    there (tc is one thread).

    SHARED fix round 3 (Claude Opus 5.5, unreviewed): the audit's LOW-2.
    A command passes its one deadline to every wait, so the waits add up
    to LOCK_WAIT_SECONDS at most. A deadline already past still takes a
    lock nobody holds (one LOCK_NB try, no timer), so a command whose
    earlier waits used its time is refused only while the lock is held.

    @interacts  sets this process's SIGALRM handler and arms a one-shot
                real-time timer for the wait, then puts the old handler
                back and cancels the timer (one armed before the call is
                cancelled, not restored); takes the flock on `f`, or lets
                it go when the time ran out. Reads the monotonic clock.
    @deps       fcntl, signal, time; lock_deadline, LockWaitOver.
    @complexity O(1), plus waiting until `deadline` at most: at most
                LOCK_WAIT_SECONDS after the command's lock_deadline call.
    @alloc      one closure, freed on return.
    """
    left = (lock_deadline() if deadline is None else deadline) - time.monotonic()
    if left <= 0:  # SHARED fix round 3 (Claude Opus 5.5, unreviewed): time used up; a free lock is still taken
        try:
            fcntl.flock(f, how | fcntl.LOCK_NB)
        except BlockingIOError:
            return False
        return True
    waiting = True

    def ran_out(signum, frame):
        if waiting:
            raise LockWaitOver()

    previous = signal.signal(signal.SIGALRM, ran_out)
    try:
        try:
            signal.setitimer(signal.ITIMER_REAL, left)
            fcntl.flock(f, how)
            waiting = False
        finally:
            signal.setitimer(signal.ITIMER_REAL, 0)
    except LockWaitOver:
        fcntl.flock(f, fcntl.LOCK_UN)  # granted just as the timer fired: let it go
        return False
    finally:
        signal.signal(signal.SIGALRM, signal.SIG_DFL if previous is None else previous)
    return True


# P3 fix round 1b (Claude Opus 5.5, unreviewed): D35 (3), a busy refusal names the holder.
def busy_words(what, f):
    """The refusal for a lock not granted within the command's bound: `what` names the lock (mail/.seq's path, or an inbox's name), `f` is its open file. Words, one line.

    Each holder /proc/locks shows for the file is named with its Linux
    user (process_uid) and pid, and the words say what the stuck member
    can do: ask that user to let it go and, on a shared mailbox (or one
    whose .shared tc cannot read), ask the user who ran init to act
    (init_user_name). When /proc/locks names no holder by the time tc
    looks (it let go in between, or the process that took it has ended
    while another holds it still), the words say so rather than guess
    (LOCK_LET_GO_WORDS). This process holds no flock on `f` by then:
    flock_within let go of any it was granted too late.

    @interacts  fstats `f`; reads /proc/locks, stats /proc/<pid> of each
                holder, reads the user database and ROOT/.shared, and on a
                shared mailbox lstats ROOT/.shared or outbox/ for the init
                user. Writes nothing.
    @deps       _flock_holders, _lock_key, process_uid, user_name,
                shared_group, init_user_name; os; LOCK_HELD_WORDS,
                LOCK_HOLDER_WORDS, LOCK_HELD_BY_WORDS, LOCK_ASK_INIT_WORDS,
                UNKNOWN_HOLDER_WORDS, UNKNOWN_ASK_WORDS, LOCK_LET_GO_WORDS,
                LOCK_WAIT_SECONDS.
    @complexity O(k + h) over k lines in /proc/locks (tens) and h holders
                of this file (one, or a few senders holding it shared).
    @alloc      the words, returned.
    """
    holders = [(pid, process_uid(pid)) for pid in _flock_holders().get(_lock_key(os.fstat(f.fileno())), [])]
    if not holders:
        return LOCK_LET_GO_WORDS.format(what=what, seconds=LOCK_WAIT_SECONDS)
    named = ", ".join(LOCK_HOLDER_WORDS.format(user=UNKNOWN_HOLDER_WORDS if uid is None else user_name(uid), pid=pid)
                      for pid, uid in holders)
    users = sorted({user_name(uid) for _, uid in holders if uid is not None})
    ask = " or ".join(users) if users else UNKNOWN_ASK_WORDS.format(pid=holders[0][0])
    try:
        shared = shared_group() is not None
    except ValueError:
        shared = True
    init = LOCK_ASK_INIT_WORDS.format(init=init_user_name()) if shared else ""
    return LOCK_HELD_BY_WORDS.format(held=LOCK_HELD_WORDS.format(what=what), holders=named, ask=ask, init=init)


def next_seq(deadline=None):
    """The next message number: mail/.seq read, raised by one and written back under its flock.

    @interacts  reads ROOT/.shared and makes mail/ when missing
                (make_folder); opens mail/.seq through open_by_name,
                creating it when missing and refusing a symlink or a FIFO
                there (exit 1, D17, D19), and holds its flock while it
                reads and rewrites the number. SHARED fix round 2 (Claude
                Opus 5.5, unreviewed): waits for the flock no later than
                `deadline`, the command's lock_deadline (flock_within;
                None: LOCK_WAIT_SECONDS from now, SHARED fix round 3),
                then refuses, exit 10 (EXIT_BUSY, D23), `tc: another
                process is holding <ROOT>/mail/.seq's lock: <user> (pid
                <pid>); try again. ...` naming each holder and whom to ask
                (busy_words; P3 fix round 1b, Claude Opus 5.5, unreviewed:
                D35 (3)), with nothing written (D20).
    @deps       make_folder, open_by_name, flock_within, busy_words,
                refuse; fcntl, os; EXIT_BUSY.
    @complexity O(1), plus waiting until `deadline` at most; a refusal
                adds busy_words' read of /proc/locks.
    @alloc      one open file, closed on return.
    """
    make_folder(MAIL)  # SHARED H1 (Claude Opus 5.5, unreviewed): D16
    with open(open_by_name(SEQ_FILE, os.O_RDWR | os.O_APPEND), "a+") as f:  # SHARED D17 (Claude Opus 5.5, unreviewed)
        if not flock_within(f, fcntl.LOCK_EX, deadline):  # SHARED fix round 2 (Claude Opus 5.5, unreviewed): D20
            refuse(busy_words(SEQ_FILE, f), EXIT_BUSY)  # P3 fix round 1b (Claude Opus 5.5, unreviewed): D35 (3), the holder named
