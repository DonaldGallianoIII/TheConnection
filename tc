    """Move whatever has the name `name` in the inbox open at `box_fd` to the first free PLANTED_ASIDE_NAME there, for tc `kind` (wait or watch): one line of words naming what was there, whose it was and where it went; None when nothing was there by then. `path` names it, in the words only.

    For a wait or watch lock's name, where the owner's tc found something
    that is not its own lock (open_wake_lock): another user's file, a
    link, a FIFO, a folder or a file with a second name. The owner owns
    the inbox, so sticky lets its tc rename what another member made in
    it. lstat by name says what it is and whose; the rename, by name in
    the same descriptor, moves a link as itself, so what a link leads to
    is never touched. A rename that fails is refused, exit 1, with words,
    and nothing is made.

    @interacts  lstats `name` and each aside name tried, by name in
                `box_fd`; renames one entry there; reads this process's
                user id and the user database for the words; on a failed
                rename one line to stderr and exit 1.
    @deps       name_taken, refuse, user_name; os, stat;
                PLANTED_ASIDE_NAME, EXIT_REFUSED.
    @complexity O(k) over k aside names already taken (none in practice).
    @alloc      the words, returned.
    """
    try:
        st = os.lstat(name, dir_fd=box_fd)
    except FileNotFoundError:
        return None
    if stat.S_ISLNK(st.st_mode):
        what = "a symlink"
    elif stat.S_ISFIFO(st.st_mode):
        what = "a FIFO"
    elif stat.S_ISDIR(st.st_mode):
        what = "a folder"
    elif not stat.S_ISREG(st.st_mode):
        what = "not a regular file"
    elif st.st_nlink > 1:
        what = "a file with another name too (a hard link)"
    else:
        what = "a file"
    k = 1
    while name_taken(PLANTED_ASIDE_NAME.format(lock=name, k=k), box_fd):
        k += 1
    aside = PLANTED_ASIDE_NAME.format(lock=name, k=k)
    try:
        os.rename(name, aside, src_dir_fd=box_fd, dst_dir_fd=box_fd)
    except FileNotFoundError:
        return None
    except OSError as err:
        refuse(f"tc {kind}: {path} is {what} owned by {user_name(st.st_uid)}, not this user's own {kind} lock, "
               f"and tc could not move it aside ({err.strerror}); nothing made", EXIT_REFUSED)
    return (f"tc {kind}: {path} was {what} owned by {user_name(st.st_uid)}, not this user's own {kind} lock; "
            f"moved it aside to {path.with_name(aside)} and made a new one")


def open_wake_lock(box_fd, box, kind):
    """This user's own wait or watch lock (`kind`) in the inbox open at `box_fd` (its path `box`, for the words), opened by name and never through a link: (descriptor, words), one line of words per entry moved aside first. Refuses (exit 1, words) what it can neither use nor move.

    Made with O_CREAT | O_EXCL at WAKE_LOCK_MODE when nothing has the
    name. One already there is opened with O_NOFOLLOW | O_NONBLOCK and
    used only when fstat finds a regular file with one name (st_nlink 1)
    that this user owns; an own file at another mode is set to
    WAKE_LOCK_MODE through its descriptor. Anything else there (another
    user's file, a link, a FIFO, a folder, a file with a second name) is
    moved aside inside the inbox with words (move_aside), and the lock is
    made again, at most WAKE_LOCK_TRIES times. Read only: flock needs no
    more. The descriptor comes back blocking; the caller closes it.

    @interacts  creates, or opens and fstats, one file by its name in
                `box_fd`; fchmods an own one at another mode; may move
                entries aside (move_aside); on a refusal one line to
                stderr and exit 1.
    @deps       move_aside, refuse; os, stat; WAKE_LOCK_NAME,
                WAKE_LOCK_MODE, WAKE_LOCK_TRIES, EXIT_REFUSED.
    @complexity O(1): at most WAKE_LOCK_TRIES + 1 tries of two opens, an
                fstat and a move each.
    @alloc      one descriptor, returned, or closed before anything is
                raised; one line of words per move.
    """
    name = WAKE_LOCK_NAME.format(kind=kind)
    path = box / name
    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
    said = []
    for tries in range(WAKE_LOCK_TRIES + 1):
        try:
            fd = os.open(name, flags | os.O_CREAT | os.O_EXCL, WAKE_LOCK_MODE, dir_fd=box_fd)
        except FileExistsError:
            try:
                fd = os.open(name, flags, dir_fd=box_fd)
            except FileNotFoundError:
                continue  # gone between the two opens: made on the next try
            except OSError:
                fd = None  # a link (ELOOP), another user's file (EACCES), ...: not this user's lock
        except OSError as err:
            refuse(f"tc {kind}: could not make {path} ({err.strerror}); nothing made", EXIT_REFUSED)
        if fd is not None:
            try:
                st = os.fstat(fd)
                if stat.S_ISREG(st.st_mode) and st.st_nlink == 1 and st.st_uid == os.geteuid():
                    if stat.S_IMODE(st.st_mode) != WAKE_LOCK_MODE:
                        os.fchmod(fd, WAKE_LOCK_MODE)
                    os.set_blocking(fd, True)
                    return fd, said
            except BaseException:
                os.close(fd)
                raise
            os.close(fd)
        if tries == WAKE_LOCK_TRIES:
            break
        moved = move_aside(box_fd, name, path, kind)
        if moved is not None:
            said.append(moved)
    refuse("\n".join(said + [f"tc {kind}: something else had the name {path} again each time tc moved one aside "
                             f"({WAKE_LOCK_TRIES} times); nothing made"]), EXIT_REFUSED)


def old_wake_lock_held(name, kind):
    """The switch-over (OLD_WAKE_LOCK_NAME, private mailboxes only): True when mail/.<kind>-<name>.lock, where a tc wait or tc watch started before P3 fix round 1b holds its lock, is held now.

    Opened read only, never through a link, never blocking and never made,
    and tested with a non-blocking shared flock that is let go at once. A
    file a holder keeps exclusive refuses it; nothing there, or anything
    but a regular file, is held by nobody. The caller never asks on a
    shared mailbox, where the old place is the hole D35 closes. This can
    go once every session has re-armed (a later task).

    @interacts  opens mail/.<kind>-<name>.lock by its path, fstats it,
                takes and lets go a shared flock on it, closes it. Writes
                nothing.
    @deps       fcntl, os, stat; MAIL, OLD_WAKE_LOCK_NAME.
    @complexity O(1).
    @alloc      one descriptor, closed before return.
    """
    try:
        fd = os.open(MAIL / OLD_WAKE_LOCK_NAME.format(kind=kind, name=name), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return False
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return False
        try:
            fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except BlockingIOError:
            return True
        fcntl.flock(fd, fcntl.LOCK_UN)
        return False
    finally:
        os.close(fd)


def refuse_other_listener(name, kind):
    """D36 (2), on a shared mailbox: refuse (exit 1, C4's words, nothing made) a tc wait or tc watch (`kind`) for `name` run by anyone but the owner of cards/<name>.json, or for a name nobody has joined. Else nothing.

    The card's owner is its lstat's st_uid: under the sticky cards/ only
    that user can replace it (D20), so the card names who listens.

    @interacts  lstats cards/<name>.json; reads this process's user id and
                the user database for the words; on a refusal one line to
                stderr and exit 1.
    @deps       refuse, user_name; os; CARDS, ONLY_OWNER_LISTENS_WORDS,
                NOBODY_JOINED_LISTEN_WORDS, EXIT_REFUSED.
    @complexity O(1).
    @alloc      the words, on a refusal.
    """
    card = CARDS / f"{name}.json"
    try:
        owner = os.lstat(card).st_uid
    except FileNotFoundError:
        refuse(NOBODY_JOINED_LISTEN_WORDS.format(kind=kind, name=name), EXIT_REFUSED)
    except OSError as err:
        refuse(f"tc {kind}: could not look at {card} ({err.strerror}); nothing made", EXIT_REFUSED)
    if owner != os.geteuid():
        refuse(ONLY_OWNER_LISTENS_WORDS.format(kind=kind, name=name, owner=user_name(owner)), EXIT_REFUSED)


def already_listening(name, kind):
    """Say another tc wait or tc watch (`kind`) for `name` is running, as tc always has, and exit EXIT_ALREADY_LISTENING (3).

    @interacts  prints one line to stdout; exits 3.
    @deps       sys; ALREADY_WORDS, EXIT_ALREADY_LISTENING.
    @complexity O(1).
    @alloc      none.
    """
    print(ALREADY_WORDS[kind].format(name=name))
    sys.exit(EXIT_ALREADY_LISTENING)


def hold_wake_lock(name, kind, share):
    """Take and hold `name`'s wait or watch lock (`kind`), the one in its owner's own inbox: the open lock file, its flock held. The caller closes it, which lets go. Every refusal and exit 3 comes before anything is held, with nothing left open.

    D35 (1): the lock lives in mail/to-<name>/ at WAKE_LOCK_MODE, opened
    by name in the inbox's pinned descriptor (pinned_inbox, which refuses
    a linked inbox or read/, and under a shared mailbox one not its card
    owner's, exit 1), so no other member can hold it or redirect it; an
    entry someone else planted at its name is moved aside with words on
    stderr first (open_wake_lock). D36 (2): on a shared mailbox (`share`)
    anyone but the owner of the name's card, and any name nobody joined,
    is refused before anything is made (refuse_other_listener), and the
    owner's own inbox, when gone, is refused too: only tc join makes one
    there. A private mailbox keeps its behavior: the inbox and its read/
    are made when missing. The switch-over (private only): a lock still
    held at the old place, mail/.<kind>-<name>.lock, by a listener started
    before round 1b, exits 3 as a held lock does (old_wake_lock_held).

    @interacts  shared: lstats the card (refuse_other_listener); private:
                opens and flocks the old place for a moment
                (old_wake_lock_held). Then opens mail/, the inbox and its
                read/ (pinned_inbox, making the private inbox and read/
                when missing), opens or makes the lock in the inbox
                (open_wake_lock, moving a planted entry aside), closes the
                folders, writes each move's line to stderr, and takes the
                lock's flock without waiting; held already, one line to
                stdout and exit 3 (already_listening).
    @deps       refuse_other_listener, old_wake_lock_held, pinned_inbox,
                open_wake_lock, already_listening, refuse; fcntl, os, sys;
                NO_INBOX_LISTEN_WORDS, EXIT_REFUSED.
    @complexity O(1): a handful of opens and one flock try.
    @alloc      one open lock file, returned; the inbox's two descriptors
                for the moment it is opened.
    """
    shared = share is not None
    if shared:
        refuse_other_listener(name, kind)
    elif old_wake_lock_held(name, kind):
        already_listening(name, kind)
    with pinned_inbox(name, shared, make_inbox=not shared) as inbox:
        if inbox.box.fd is None:
            if inbox.box.problem is not None:  # the words a poll said for it: tc could not list, or look at, <inbox>
                refuse(f"{inbox.box.problem}, so its {kind} lock cannot be made there; nothing made", EXIT_REFUSED)
            refuse(NO_INBOX_LISTEN_WORDS.format(kind=kind, name=name), EXIT_REFUSED)
        fd, said = open_wake_lock(inbox.box.fd, inbox.path, kind)
    lock = open(fd, "rb", buffering=0)
    try:
        for line in said:
            print(line, file=sys.stderr)
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        lock.close()
        already_listening(name, kind)
    except BaseException:
        lock.close()
        raise
    return lock


def cmd_wait(args):
    """`tc wait <name>`: hold the name's lock and poll until mail lands.

    Exit 0 on mail, EXIT_TIMEOUT at the deadline, EXIT_ALREADY_LISTENING
    when another wait holds the lock.

    P3 fix round 1b (Claude Opus 5.5, unreviewed): D35 (1) and D36 (2).
    The lock is mail/to-<name>/.wait.lock, its owner's alone, taken before
    the first poll (hold_wake_lock); on a shared mailbox only the owner of
    the name's card may run this, and a name nobody joined is refused,
    exit 1, nothing made. The lock file is closed on every way out (exit
    0, 2, 3, a refusal, an exception): the `with` around the polls closes
    it, and hold_wake_lock closes its own before any exit.

    @interacts  checks the name first (C0, exit 6, nothing written); caps
                its own address space; reads ROOT/.shared once
                (mailbox_share); takes the lock (hold_wake_lock: on a
                shared mailbox lstats the card and refuses anyone but its
                owner, exit 1; on a private one tests the old place for a
                moment and makes mail/, the inbox and read/ when missing;
                opens or makes the lock in the inbox, moving a planted
                entry aside with one line to stderr; held already, exit 3)
                and holds its flock until it exits; each poll opens mail/,
                the inbox and its read/ once and lists the inbox in its own
                descriptor (unread, pinned_inbox; P3 fix round 1a, Claude
                Opus 5.5, unreviewed: D35); a linked inbox or read/, a
                read/ it cannot look at, or under a shared mailbox one not
                its card owner's, refuses (exit 1, refuse_bad_inbox), and
                so does one it cannot list (exit 1, never a quiet timeout:
                inbox_messages, SHARED fix round 3); prints one line.
    @deps       require_names, mailbox_share, hold_wake_lock, unread,
                keepalive_seconds; resource, sys, time.
    @complexity O(U + u log u) per poll over U names in the inbox and the
                u of them that are messages (single digits): three folder
                opens, one lstat for the card when shared, one listing and
                one stat per message name; no .shared read per poll. One
                poll every POLL_SECONDS until the timeout.
    @alloc      one open lock file for its lifetime, closed on every way
                out, and two descriptors for each poll; flat at about
                13 MB.
    """
    require_names(args.name)  # CARDS R1 (Claude Opus 5.5, unreviewed)
    resource.setrlimit(resource.RLIMIT_AS, (WAIT_MEMORY_CAP_BYTES, WAIT_MEMORY_CAP_BYTES))
    share = mailbox_share()  # P3 fix round 1b (Claude Opus 5.5, unreviewed): read once, not per poll
    with hold_wake_lock(args.name, "wait", share):  # P3 fix round 1b (Claude Opus 5.5, unreviewed): D35, D36; closed on every way out
        timeout = args.timeout if args.timeout is not None else (
            keepalive_seconds() if args.keepalive else DEFAULT_WAIT_SECONDS)
        shared = share is not None  # SHARED fix round 1 (Claude Opus 5.5, unreviewed): read once, not per poll
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            msgs = unread(args.name, shared)
            if msgs:
                print(f"MAIL: {len(msgs)} unread for {args.name}. Run: tc read {args.name}")
                return
            time.sleep(min(POLL_SECONDS, max(0.0, deadline - time.monotonic())))
        if args.keepalive:
            print(f"KEEPALIVE: no mail for {args.name} in {timeout:g}s. This wake refreshed the cache. "
                  f"Re-arm: tc wait {args.name} --keepalive")
        else:
            print(f"TIMEOUT: no mail for {args.name} in {timeout:g}s. Re-arm: tc wait {args.name}")
        sys.exit(EXIT_TIMEOUT)


def cmd_status(args):
    """`tc status [<name> <text>]`: post one side's status, or show them all.

    Neither way follows a symlink at a status file (D17). Posting opens
    status/<name>.md through open_by_name, so a link there is refused (exit
    1) and nothing is written through it. Showing reads each file through
    read_regular_file: a link, a FIFO, a file over STATUS_READ_MAX_BYTES or
    one not in UTF-8 is named on stderr instead of shown, and the command
    exits 1 after showing the rest. SHARED fix round 1 (Claude Opus 5.5,
    unreviewed): under a shared mailbox a new status file is made
    SHARED_OWNED_FILE_MODE (0640, D20 item 2), so no member rewrites
    another's; a post over one this user may not write is refused with
    words (open_by_name).

    @interacts  checks the name first when one is given (C0, exit 6,
                nothing written); reads ROOT/.shared and makes status/
                (make_folder); writes status/<name>.md whole
                (open_by_name), or reads every status file
                (read_regular_file); prints to stdout, and to stderr for a
                file it will not show.
    @deps       require_names, make_folder, open_by_name,
                read_regular_file, refuse, now_iso; os;
                STATUS_READ_MAX_BYTES, SHARED_OWNED_FILE_MODE,
                NEW_FILE_MODE.
    @complexity O(s) over s status files when showing (single digits),
                each read up to STATUS_READ_MAX_BYTES.
    @alloc      each file's text while printed; one descriptor while
                posting.
    """
    require_names(args.name)  # CARDS R1 (Claude Opus 5.5, unreviewed)
    share = make_folder(STATUS)  # SHARED H1 (Claude Opus 5.5, unreviewed): D16
    if args.text is None:
        files = sorted(STATUS.glob("*.md"))
        if not files:
            print("no status posted")
        unshown = []  # SHARED D17 (Claude Opus 5.5, unreviewed): no link followed
        for p in files:
            try:
                print(read_regular_file(p, STATUS_READ_MAX_BYTES))
            except (OSError, ValueError) as err:
                unshown.append(f"tc status: {p} not shown ({err})")
        if unshown:
            refuse("\n".join(unshown), EXIT_REFUSED)
        return
    # SHARED D17 (Claude Opus 5.5, unreviewed): a link at status/<name>.md is refused.
    # SHARED fix round 1 (Claude Opus 5.5, unreviewed): D20 item 2, made 0640 when shared.
    mode = SHARED_OWNED_FILE_MODE if share is not None else NEW_FILE_MODE
    with open(open_by_name(STATUS / f"{args.name}.md", os.O_WRONLY | os.O_TRUNC, mode), "w") as f:
        f.write(f"## {args.name} status, {now_iso()}\n\n{args.text}\n")
    print(f"status posted for {args.name}")


def cmd_log(args):
    """`tc log [--last N]`: every message, unread and read, in number order.

    SHARED fix round 1 (Claude Opus 5.5, unreviewed): D19. Only real
    inbox folders are entered (lstat): a symlink at mail/to-<name> or at
    its read/ is named on stderr and never entered. Only regular files
    print (message_files, then show); anything else is named. Either makes
    log exit 1 after it prints the rest.

    SHARED fix round 3 (Claude Opus 5.5, unreviewed): the audit's REC-1.
    A folder tc cannot list (message_files gives a problem and nothing
    else) is named on stderr with the reason, the log exits 1 after it
    prints the rest, and it never says `mailbox empty` while such a folder
    may hold mail.

    SHARED fix round 4 (Claude Opus 5.5, unreviewed): the audit's LOW-4.
    The same holds for an inbox or read/ that lstat cannot reach for any
    reason but not being there (the read/ of an inbox readable without
    search): `tc log: tc could not look at <folder> (<why>); the mail in
    it is not shown`, exit 1, and no `mailbox empty`.

    P3 fix round 1a (Claude Opus 5.5, unreviewed): D35, one pinned handle
    per inbox. mail/ is opened once, each inbox by its name in it and its
    read/ by name in the inbox's descriptor (open_inbox), and every
    listing, stat and message read is by name in those descriptors, which
    stay open until the log is printed. So an inbox's owner who swaps it
    for a link or another folder mid-walk leads the log nowhere. A read/
    is reached only through its inbox: the read/ of an inbox tc cannot
    open is not listed.

    @interacts  opens mail/ and lists it; opens each mail/to-*/ and its
                read/ by name (open_inbox), lists each and stats each
                message name in it, reads each message shown
                (read_regular_file), all by name in their folders'
                descriptors; prints to stdout, and to stderr for what it
                will not show or could not list or look at. Writes
                nothing.
    @deps       open_mail, open_inbox, unpin, message_files, show,
                refuse_lines, printable; contextlib, os, stat.
    @complexity O(n log n + T + t log t) over n inboxes, T names in every
                inbox and read/, and t message files ever (low hundreds
                per job): one listing per folder, one stat per message
                name, a sort per folder and one of all t, and one read for
                each one shown.
    @alloc      two descriptors per inbox, held until the log is printed;
                the list of every message, the skipped entries and the
                folders not listed, freed on exit; each file's text while
                it prints.
    """
    every, skipped, unlisted = [], [], []
    with contextlib.ExitStack() as held:  # P3 fix round 1a (Claude Opus 5.5, unreviewed): D35, every descriptor closed
        try:
            mail_fd = open_mail()
        except OSError:
            mail_fd = None
        names = []
        if mail_fd is not None:
            held.callback(os.close, mail_fd)
            try:
                names = sorted(name for name in os.listdir(mail_fd) if name.startswith("to-"))
            except OSError:
                names = []
        for entry in names:
            inbox = open_inbox(mail_fd, entry[len("to-"):])
            held.callback(unpin, inbox.read, inbox.box)
            for folder, pinned in ((inbox.path, inbox.box), (inbox.path / "read", inbox.read)):
                if pinned.fd is None:
                    if pinned.found is not None and stat.S_ISLNK(pinned.found.st_mode):
                        skipped.append((folder, "it is a symlink, not a real folder; tc never enters it"))
                    elif pinned.problem is not None:  # SHARED fix round 4 (Claude Opus 5.5, unreviewed): LOW-4, a folder tc cannot look at is said
                        unlisted.append(pinned.problem)
                    continue
                messages, bad, problem = message_files(folder, pinned.fd)  # an entry tc could not look at is in bad
                every += [(path, pinned.fd) for path, _ in messages]
                skipped += bad
                if problem is not None and not messages and not bad:  # SHARED fix round 3 (Claude Opus 5.5, unreviewed): REC-1
                    unlisted.append(problem)
        every.sort(key=lambda message: message[0].name)
        if not every and not unlisted:
            print("mailbox empty")
        unshown = show(every[-args.last:] if args.last else every)
    refuse_lines([f"tc log: {printable(p)} not shown ({why})" for p, why in skipped + unshown]
                 + [f"tc log: {printable(problem)}; the mail in it is not shown" for problem in unlisted])


# ---------- cards: who each name is and how mail reaches it (C1) ----------
# CARDS R2 (Claude Opus 5.5, unreviewed). No card names a hub (D7):
# reports_to is a hint for tc cards, tc health and the board, never a route.

def unread_count(name, inbox=None):
    """How many unread messages mail/to-<name>/ holds; 0 with no inbox. `inbox`, when given, is the Inbox the caller holds open for `name` (deliver_codex's).

    Unlike unread(), it never creates the inbox. SHARED fix round 1
    (Claude Opus 5.5, unreviewed): only a real folder counts, so a linked
    inbox holds 0, as send, read and wait refuse it; and only regular
    files count (message_files), as `tc read` moves only those. SHARED fix
    round 2 (Claude Opus 5.5, unreviewed): an entry stat cannot reach is
    not counted, and an inbox this user cannot list holds 0 here, never a
    traceback. SHARED fix round 4 (Claude Opus 5.5, unreviewed): the
    audit's LOW-7. So this count's own callers get a silent 0 for such an
    inbox: cmd_join (the ring marker), cmd_card (its refusal over unread
    mail) and deliver_codex (the ring decision), as the handoff's pause 8
    says. Peek, read and wait say they could not list it
    (inbox_messages), log names it (cmd_log), and mailbox_summary reports
    the count as unknown.

    P3 fix round 1a (Claude Opus 5.5, unreviewed): D35. The count is
    taken in the inbox's own descriptor, never by its path: the caller's
    open `inbox`, so a codex send counts, lands and counts again in one
    folder, or else the inbox opened here once (pinned_inbox, refusing
    nothing and reading no .shared) and closed again.

    @interacts  without `inbox`, opens mail/, the inbox and its read/
                (pinned_inbox) and closes them after; lists the inbox and
                stats each message name in it. Writes nothing.
    @deps       pinned_inbox, message_files.
    @complexity O(U + u log u) over U names in the inbox and the u of
                them that are messages (single digits).
    @alloc      two lists, freed on return; without `inbox`, two
                descriptors for the call.
    """
    if inbox is None:
        with pinned_inbox(name, check=False) as opened:
            return unread_count(name, opened)
    if inbox.box.fd is None:
        return 0
    return len(message_files(inbox.path, inbox.box.fd)[0])


def refuse(words, code):
    """Print `words` to stderr and exit with `code`.

    @interacts  writes `words` to stderr, one line, or several joined by
                newlines (refuse_lines, cmd_status's unshown files; SHARED
                fix round 6, Claude Opus 5.5, unreviewed: the audit's
                LOW-4); exits.
    @deps       sys.
    @complexity O(1).
    @alloc      none.
    """
    print(words, file=sys.stderr)
    sys.exit(code)


def refuse_self_report(name, reports_to):
    """Exit EXIT_BAD_NAME when a name says it reports to itself (C1).

    @interacts  writes one line to stderr and exits on a self-report.
    @deps       refuse.
    @complexity O(c) over the name's characters.
    @alloc      none.
    """
    if reports_to is not None and reports_to == name:
        refuse(f"tc: {name} cannot report to itself", EXIT_BAD_NAME)


def account_label(given):
    """A `tc join` card's account: `given`, else CLAUDE_CONFIG_DIR's base name, else UNKNOWN_ACCOUNT.

    A blank value counts as not given at each step, so the word is never
    empty (C1). `tc card` uses far_account instead (D13).

    @interacts  reads CLAUDE_CONFIG_DIR from the environment when `given`
                is blank, and nothing else.
    @deps       os, pathlib.
    @complexity O(c) over the characters of the value used.
    @alloc      the label string, returned.
    """
    if given is not None and given.strip():
        return given
    config = os.environ.get("CLAUDE_CONFIG_DIR")
    if config and pathlib.Path(config).name.strip():
        return pathlib.Path(config).name
    return UNKNOWN_ACCOUNT


# CARDS fix round 1 (Claude Opus 5.5, unreviewed): D13 (CARDS-4 item 3).
def far_account(given):
    """A `tc card` card's account: `given`, else UNKNOWN_ACCOUNT. Never the environment.

    This session's account says nothing about a name on another machine,
    so CLAUDE_CONFIG_DIR is not read (C1, D13). A blank value counts as not
    given, so the word is never empty.

    @interacts  none; string work only.
    @deps       UNKNOWN_ACCOUNT.
    @complexity O(c) over the characters of `given`.
    @alloc      none; returns `given` or the constant.
    """
    return given if given is not None and given.strip() else UNKNOWN_ACCOUNT


def write_card(card):
    """Write cards/<name>.json whole: a new .tmp sibling, then a rename over the old card.

    The .tmp name carries this process's pid, so two joins of one name at
    once never write into the same file. It is made by write_new_file, so
    a file or link already at that name is refused (exit 1, no card
    written), never written through. SHARED fix round 1 (Claude Opus 5.5,
    unreviewed): under a shared mailbox it is made SHARED_OWNED_FILE_MODE
    (0640, D20 item 2), so no member rewrites another's card in place.

    SHARED fix round 1 (Claude Opus 5.5, unreviewed): the audit's LOW-5.
    A rename tc may not make (under the sticky cards/, a card another user
    owns) is refused with words naming the owner, never a traceback, and
    the .tmp this call made is removed first, tc's own runtime cleanup,
    so none is left behind. P3 fix round 1c (Claude Opus 5.5, unreviewed):
    the audit's LOW-11. A .tmp whose write fails after its create is
    removed by write_new_file, so that refusal leaves none either.

    @interacts  reads ROOT/.shared and makes cards/ (make_folder); creates
                cards/<name>.json.<pid>.tmp and renames it to
                cards/<name>.json, replacing any card there; on a .tmp it
                cannot make or write (write_new_file removing it), or a
                rename it may not make (then removing its .tmp and
                lstatting the card for its owner), one line to stderr and
                exit 1.
    @deps       make_folder, write_new_file, refuse, user_name; json, os,
                errno, pathlib; SHARED_OWNED_FILE_MODE, NEW_FILE_MODE.
    @complexity O(1): eleven fields.
    @alloc      one JSON string, freed on return; one card file, kept.
    """
    share = make_folder(CARDS)  # SHARED H1 (Claude Opus 5.5, unreviewed): D16
    path = CARDS / f"{card['name']}.json"
    tmp = CARDS / f"{card['name']}.json.{os.getpid()}.tmp"
    mode = SHARED_OWNED_FILE_MODE if share is not None else NEW_FILE_MODE  # SHARED fix round 1 (Claude Opus 5.5, unreviewed): D20
    try:
        write_new_file(tmp, json.dumps(card, indent=2) + "\n", mode)
    except OSError as err:
        refuse(f"tc: could not create {tmp} ({err.strerror}); no card written", EXIT_REFUSED)
    try:
        tmp.rename(path)  # atomic, so a reader never sees half a card
    except OSError as err:  # SHARED fix round 1 (Claude Opus 5.5, unreviewed): LOW-5
        tmp.unlink(missing_ok=True)  # this call's own .tmp, made just above
        if err.errno not in (errno.EPERM, errno.EACCES):
            refuse(f"tc: could not replace {path} ({err.strerror}); no card written", EXIT_REFUSED)
        try:
            owner = user_name(os.lstat(path).st_uid)
        except OSError:
            owner = "another user"
        refuse(f"tc: could not replace {path} ({err.strerror}): it belongs to {owner}, and under a "
               f"shared mailbox only its owner can replace it. No card written.", EXIT_REFUSED)
    return path


# Phase fix round 1 (Claude Opus 5.5, unreviewed): what tc cards and tc
# health print from a card or a file name is escaped.
def printable(value):
    """`value` as text, each character str.isprintable() refuses written as its escape.

    Anyone who can write cards/ shapes a card, and a file name holds any
    byte but / and NUL. So ESC (0x1b) prints as the four characters
    \\x1b, never raw, and no card or file name can clear the screen,
    retitle the window or redraw a line where tc cards or tc health runs.
    `tc health --json` needs none of this: json.dumps escapes them.

    @interacts  none; string work only.
    @deps       the unicode_escape codec.
    @complexity O(c) over c characters of the text.
    @alloc      one string, returned.
    """
    text = str(value)
    if text.isprintable():
        return text
    return "".join(c if c.isprintable() else c.encode("unicode_escape").decode("ascii") for c in text)


def describe_card(card, file_name=None):
    """One card in words: `<name> (<kind>, account <a>, route <r>)`, plus `, reports to <N>`.

    Given `file_name`, the name is the file's (cards/<name>.json), as the
    router and tc health name it, and a card whose `name` field says
    otherwise ends `, card says name <x>`, so a copied card shows both.
    Without it (join and card describe the card they just wrote) the name
    is the `name` field. An ssh card's route reads `route ssh to
    <target>`. A field missing from a hand-made card shows as `?`. Every
    field goes through printable(), so no control character in a card
    reaches the terminal raw.

    @interacts  none; string work only.
    @deps       printable; pathlib.
    @complexity O(f) over f characters in the card's fields (a few
                hundred).
    @alloc      one string, returned.
    """
    route = card.get("route", "?")
    if route == "ssh" and isinstance(card.get("ssh"), dict):
        route = f"ssh to {card['ssh'].get('target', '?')}"
    name = pathlib.Path(file_name).stem if file_name is not None else card.get("name", "?")
    text = (f"{printable(name)} ({printable(card.get('kind', '?'))}, "
            f"account {printable(card.get('account', '?'))}, route {printable(route)})")
    if card.get("reports_to"):
        text += f", reports to {printable(card['reports_to'])}"
    if file_name is not None and "name" in card and card["name"] != name:
        text += f", card says name {printable(card['name'])}"
    return text


# Phase fix round 1 (Claude Opus 5.5, unreviewed): every card file, and the
# ring marker, is read here.
def read_regular_file(path, limit, dir_fd=None):
    """The text of the file at `path`, read only when it is a regular file of at most `limit` bytes.

    Opened with O_NONBLOCK and O_NOFOLLOW and checked with fstat before
    any read, so a FIFO at a card's name (or the ring marker's) never
    blocks tc health, tc cards, the board's feed or a send, and a symlink
    never points tc at a file outside the mailbox. Raises
    FileNotFoundError when nothing is at the name; ValueError, with words,
    for a symlink, anything that is not a regular file, a file over
    `limit`, or bytes that are not UTF-8; OSError for any other failure to
    open or read. A card's callers treat each but the first as an
    unreadable card. P3 fix round 1a (Claude Opus 5.5, unreviewed): D35.
    `dir_fd`, when given, is the open folder `path` is a name in (a
    message, by its name in the pinned inbox or read/, show), so no
    folder on the way is resolved by name.

    @interacts  opens, fstats and reads one file, and closes it.
    @deps       os, stat, errno.
    @complexity O(r) over r bytes read, at most `limit` + 1.
    @alloc      the bytes read and the decoded text, which is returned;
                one descriptor, closed on return.
    """
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW, dir_fd=dir_fd)
    except OSError as err:
        if err.errno == errno.ELOOP:
            raise ValueError("it is a symlink, which tc never follows") from err
        raise
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise ValueError("it is not a regular file")
        chunks, left = [], limit + 1
        while left > 0:
            chunk = os.read(fd, left)
            if not chunk:
                break
            chunks.append(chunk)
            left -= len(chunk)
    finally:
        os.close(fd)
    data = b"".join(chunks)
    if len(data) > limit:
        raise ValueError(f"it is over {limit} bytes")
    return data.decode("utf-8")


def all_cards():
    """Every card under cards/, by name: a list of (file name, card or None).

    None stands for a file that is not a JSON object (hand-edited or cut
    short, or nested too deep for the parser, which raises RecursionError)
    or that read_regular_file will not read (a FIFO, a symlink, anything
    but a regular file, or one over CARD_READ_MAX_BYTES); the caller says
    so instead of guessing.

    @interacts  globs cards/*.json and reads each through
                read_regular_file. Writes nothing.
    @deps       read_regular_file, CARD_READ_MAX_BYTES; json, pathlib.
    @complexity O(c) over c cards (a few dozen).
    @alloc      one list of c dicts, returned.
    """
    out = []
    for path in sorted(CARDS.glob("*.json")) if CARDS.exists() else []:
        try:
            card = json.loads(read_regular_file(path, CARD_READ_MAX_BYTES))
        except (OSError, ValueError, RecursionError):  # Phase fix round 1 (Claude Opus 5.5, unreviewed)
            card = None
        out.append((path.name, card if isinstance(card, dict) else None))
    return out


def cmd_join(args):
    """`tc join <name>`: write the card for the session this runs in (C1).

    Reads exactly five environment variables: CODEX_THREAD_ID, CLAUDECODE,
    CLAUDE_CODE_SESSION_ID, CLAUDE_PID and CLAUDE_CONFIG_DIR. Nothing else,
    so the native path's socket and token never reach a card.

    A codex card is written under the inbox lock (D16). Mail that landed
    before this join was never rung for this thread: it came while the
    name had no card, or was rung to a thread that has since gone. So with
    unread mail waiting, the join writes the ring marker, and the next
    send rings this thread whatever the count; it also prints `<n> unread
    waiting for <name>: run tc read <name>` so this session can read now.
    With none waiting it rewrites any marker as RING_CLEAR (D20 item 5:
    never removed), since nothing is owed, so an old thread's backoff
    never holds back this thread's first ring. A symlink, a FIFO or
    anything else that is not a regular file at the marker's name refuses
    the join (exit 1, no card written, D17, D19).

    SHARED fix round 1 (Claude Opus 5.5, unreviewed): under a shared
    mailbox the join first makes the name's inbox and its read/ as the
    joining user (claim_inbox, D20 item 1), or refuses with words a name
    whose card or inbox another user owns, before anything is written.

    @interacts  checks both names (C0, exit 6) and a self-report (exit 6);
                refuses a CODEX_THREAD_ID that is not a thread id (exit 1,
                D14) and --kind codex with no CODEX_THREAD_ID (exit 1);
                reads ROOT/.shared (mailbox_share) and, when shared, makes
                the inbox (claim_inbox); then writes cards/<name>.json
                through write_card, replacing any card there and resetting
                joined_at. For a codex card, holds mail/.box-<name>.lock
                alone (making mail/; held past LOCK_WAIT_SECONDS by another
                process, exit 10, no card written: inbox_lock, D20, D23) while it
                lstats
                mail/.ring-pending-<name> (not a regular file: exit 1),
                writes the card, counts mail/to-<name>/*.md and writes or
                clears the marker in place. Prints one line, plus the
                waiting line; a marker it cannot write or clear is said on
                stderr.
    @deps       require_names, refuse_self_report, refuse, account_label,
                mailbox_share, claim_inbox, write_card, describe_card,
                now_iso, THREAD_ID_PATTERN, inbox_lock, ring_marker_problem,
                unread_count, write_ring_marker, RING_JOINED, RING_CLEAR;
                os, sys.
    @complexity O(1), plus O(t) over t characters of CODEX_THREAD_ID; a
                codex card adds O(u) over u unread messages (single digits).
    @alloc      one card dict, freed on exit; one card file, kept; under a
                shared mailbox the inbox and its read/ when missing, kept;
                for a codex card one open lock file, and the marker file,
                kept (never removed, D20).
    """
    require_names(args.name, args.reports_to)
    refuse_self_report(args.name, args.reports_to)
    thread = os.environ.get("CODEX_THREAD_ID") or None
    # CARDS fix round 1 (Claude Opus 5.5, unreviewed): D14, so a join never
    # writes a thread_id the codex route would refuse to ring.
    if thread is not None and not THREAD_ID_PATTERN.fullmatch(thread):
        refuse(f'tc join: CODEX_THREAD_ID "{thread}" is not a thread id (letters, digits, '
               f'dot, dash, underscore, a letter or digit first), so the codex route could '
               f'never ring it. No card written.', EXIT_REFUSED)
    if args.kind:
        kind = args.kind
    elif thread:
        kind = "codex"
    elif os.environ.get("CLAUDECODE") == "1":
        kind = "claude"
    else:
        kind = "other"
    if kind == "codex" and not thread:
        refuse("tc join: kind codex needs CODEX_THREAD_ID, the thread the codex route "
               "rings, and it is not set. Run tc join inside the Codex session.", EXIT_REFUSED)
    pid = os.environ.get("CLAUDE_PID")
    card = {
        "version": CARD_VERSION,
        "name": args.name,
        "kind": kind,
        "account": account_label(args.account),
        "route": "codex" if kind == "codex" else "local",
        "session_id": os.environ.get("CLAUDE_CODE_SESSION_ID") or None,
        "pid": int(pid) if pid and pid.isascii() and pid.isdigit() else None,
        "thread_id": thread,
        "ssh": None,
        "reports_to": args.reports_to,
        "joined_at": now_iso(),
    }
    if mailbox_share() is not None:  # SHARED fix round 1 (Claude Opus 5.5, unreviewed): D20 item 1
        claim_inbox(args.name)
    if card["route"] != "codex":
        write_card(card)
        print(f"joined as {describe_card(card)}")
        return
    # Phase fix round 1 (Claude Opus 5.5, unreviewed): D16. Mail waiting at
    # a codex join leaves the ring marker, so the next send rings this thread.
    marker = MAIL / f".ring-pending-{args.name}"
    with inbox_lock(args.name):
        bad = ring_marker_problem(marker)  # SHARED D17 (Claude Opus 5.5, unreviewed): a planted link; D19 a FIFO
        if bad is not None:
            refuse(f"tc join: {marker} {bad}; no card written", EXIT_REFUSED)
        write_card(card)
        waiting = unread_count(args.name)
        if waiting:
            problem = write_ring_marker(args.name, RING_JOINED, f"tc join found {waiting} unread")
        elif os.path.lexists(marker):  # SHARED fix round 1 (Claude Opus 5.5, unreviewed): D20, cleared, never removed
            problem = write_ring_marker(args.name, RING_CLEAR, "tc join found nothing unread")
        else:
            problem = None
    print(f"joined as {describe_card(card)}")
    if waiting:
        print(f"{waiting} unread waiting for {args.name}: run tc read {args.name}")
    if problem is not None:
        print(f"tc join: {marker} could not be {'written' if waiting else 'cleared'} "
              f"({problem}), so the next send to {args.name} may not ring it",
              file=sys.stderr)


def cmd_card(args):
    """`tc card <name> --ssh user@host`: write a card for a name on another machine (C1).

    @interacts  checks both names and a self-report (exit 6), the ssh
                target and the remote tc path (exit 6); then, holding
                mail/.box-<name>.lock alone from count to write, so no
                send lands between them (held past LOCK_WAIT_SECONDS by
                another process, exit 10, no card written: inbox_lock,
                D20, D23), counts unread mail in
                mail/to-<name>/ without creating it, refuses (exit 1) when
                there is any unless --force, and writes cards/<name>.json
                through write_card; prints the card line, then on stderr a
                note when the card's route is not in ROUTES yet. Reads no
                environment variable: the account is --account, else
                `unknown` (D13).
    @deps       require_names, refuse_self_report, refuse, inbox_lock,
                unread_count, far_account, write_card, describe_card,
                now_iso, ROUTES.
    @complexity O(u) over u unread messages for the name (single digits).
    @alloc      one card dict, freed on exit; one card file, kept; one open
                lock file.
    """
    require_names(args.name, args.reports_to)
    refuse_self_report(args.name, args.reports_to)
    if not SSH_TARGET_PATTERN.fullmatch(args.ssh):
        refuse(f'tc card: bad ssh target "{args.ssh}": user@host or host, '
               f'no leading dash on either part, no spaces', EXIT_BAD_NAME)
    remote = args.remote_tc
    if not remote.startswith(REMOTE_TC_PREFIXES) or any(c.isspace() for c in remote):
        refuse(f'tc card: bad remote tc path "{remote}": it starts with / or ~/ '
               f'and has no spaces', EXIT_BAD_NAME)
    card = {
        "version": CARD_VERSION,
        "name": args.name,
        "kind": "other",
        "account": far_account(args.account),  # CARDS fix round 1 (Claude Opus 5.5, unreviewed): D13
        "route": "ssh",
        "session_id": None,
        "pid": None,
        "thread_id": None,
        "ssh": {"target": args.ssh, "tc": remote},
        "reports_to": args.reports_to,
        "joined_at": now_iso(),
    }
    # CARDS fix round 1 (Claude Opus 5.5, unreviewed): count and write under
    # the inbox lock, so no send lands here between the two.
    with inbox_lock(args.name):
        waiting = unread_count(args.name)
        if waiting and not args.force:
            refuse(f"tc card: {args.name} has {waiting} unread here. Once its card says ssh, "
                   f"sends go to the other machine and that mail is never read. Read it first "
                   f"(tc read {args.name}), or pass --force.", EXIT_REFUSED)
        write_card(card)
    print(f"card written: {describe_card(card)}")
    # CARDS fix round 1 (Claude Opus 5.5, unreviewed): say that sends are
    # refused for now. Silent once the route's lane adds its line to ROUTES.
    if card["route"] not in ROUTES:
        print(f"note: sends to {args.name} are refused until the {card['route']} route is built",
              file=sys.stderr)


