def cmd_wait(args):
    """`tc wait <name>`: hold the name's lock and poll until mail lands.

    Exit 0 on mail, EXIT_TIMEOUT at the deadline, EXIT_ALREADY_LISTENING
    when another wait holds the lock.

    @interacts  checks the name first (C0, exit 6, nothing written); caps
                its own address space; makes mail/ (make_folder) and holds
                mail/.wait-<name>.lock (flock) until it exits, opened
                through open_by_name, which refuses a symlink or a FIFO
                there (exit 1, D17, D19); reads ROOT/.shared once
                (make_folder's mailbox_share); in a private mailbox makes
                mail/to-<name>/read/ on the first poll; a linked inbox, or
                under a shared mailbox one not its card owner's, refuses
                there (exit 1, check_inbox), and so does one it cannot
                list (exit 1, never a quiet timeout: inbox_messages,
                SHARED fix round 3); prints one line. Under a shared
                mailbox it makes no inbox: a name nobody joined polls as no
                mail (D20).
    @deps       require_names, make_folder, open_by_name, unread,
                keepalive_seconds; fcntl, os, resource.
    @complexity O(u) per poll over u *.md entries in the inbox (single
                digits): two lstat calls for the inbox and read/, one for
                the card when shared, one per entry; no .shared read per
                poll. One poll every POLL_SECONDS until the timeout.
    @alloc      one open lock file for its lifetime; flat at about 13 MB.
    """
    require_names(args.name)  # CARDS R1 (Claude Opus 5.5, unreviewed)
    resource.setrlimit(resource.RLIMIT_AS, (WAIT_MEMORY_CAP_BYTES, WAIT_MEMORY_CAP_BYTES))
    share = make_folder(MAIL)  # SHARED H1 (Claude Opus 5.5, unreviewed): D16
    lock = open(open_by_name(MAIL / f".wait-{args.name}.lock", os.O_WRONLY | os.O_TRUNC), "w")  # SHARED D17 (Claude Opus 5.5, unreviewed)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print(f"ALREADY LISTENING: another `tc wait {args.name}` is running. Not starting a second.")
        sys.exit(EXIT_ALREADY_LISTENING)
    timeout = args.timeout if args.timeout is not None else (
        keepalive_seconds() if args.keepalive else DEFAULT_WAIT_SECONDS)
    shared = share is not None  # SHARED fix round 1 (Claude Opus 5.5, unreviewed): read once, not per poll
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        msgs = unread(args.name, shared)
        if msgs:
            print(f"MAIL: {len(msgs)} unread for {args.name}. Run: tc read {args.name}")
            return
        time.sleep(min(POLL_SECONDS, max(0.0, deadline - time.monotonic())))
    if args.keepalive:
        print(f"KEEPALIVE: no mail for {args.name} in {timeout:g}s. This wake refreshed the cache. "
              f"Re-arm: tc wait {args.name} --keepalive")
    else:
        print(f"TIMEOUT: no mail for {args.name} in {timeout:g}s. Re-arm: tc wait {args.name}")
    sys.exit(EXIT_TIMEOUT)


def cmd_status(args):
    """`tc status [<name> <text>]`: post one side's status, or show them all.

    Neither way follows a symlink at a status file (D17). Posting opens
    status/<name>.md through open_by_name, so a link there is refused (exit
    1) and nothing is written through it. Showing reads each file through
    read_regular_file: a link, a FIFO, a file over STATUS_READ_MAX_BYTES or
    one not in UTF-8 is named on stderr instead of shown, and the command
    exits 1 after showing the rest. SHARED fix round 1 (Claude Opus 5.5,
    unreviewed): under a shared mailbox a new status file is made
    SHARED_OWNED_FILE_MODE (0640, D20 item 2), so no member rewrites
    another's; a post over one this user may not write is refused with
    words (open_by_name).

    @interacts  checks the name first when one is given (C0, exit 6,
                nothing written); reads ROOT/.shared and makes status/
                (make_folder); writes status/<name>.md whole
                (open_by_name), or reads every status file
                (read_regular_file); prints to stdout, and to stderr for a
                file it will not show.
    @deps       require_names, make_folder, open_by_name,
                read_regular_file, refuse, now_iso; os;
                STATUS_READ_MAX_BYTES, SHARED_OWNED_FILE_MODE,
                NEW_FILE_MODE.
    @complexity O(s) over s status files when showing (single digits),
                each read up to STATUS_READ_MAX_BYTES.
    @alloc      each file's text while printed; one descriptor while
                posting.
    """
    require_names(args.name)  # CARDS R1 (Claude Opus 5.5, unreviewed)
    share = make_folder(STATUS)  # SHARED H1 (Claude Opus 5.5, unreviewed): D16
    if args.text is None:
        files = sorted(STATUS.glob("*.md"))
        if not files:
            print("no status posted")
        unshown = []  # SHARED D17 (Claude Opus 5.5, unreviewed): no link followed
        for p in files:
